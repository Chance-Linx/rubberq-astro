{
  "material_entity": {
    "@context": "https://schema.org/",
    "@type": "Product",
    "category": "Industrial Material > Rubber",
    "name": "{{technical_name}}",
    "alternateName": "{{common_name}}",
    "description": "{{description}}",
    "brand": {
      "@type": "Brand",
      "name": "RubberQ"
    },
    "additionalProperty": [
      {
        "@type": "PropertyValue",
        "name": "Temperature Range",
        "value": "{{temperature_range}}"
      },
      {
        "@type": "PropertyValue",
        "name": "ASTM Standard",
        "value": "{{astm_standard}}"
      },
      {
        "@type": "PropertyValue",
        "name": "Oil Resistance",
        "value": "{{oil_resistance}}"
      }
    ]
  },
  "process_entity": {
    "@context": "https://schema.org/",
    "@type": "Service",
    "serviceType": "Rubber Manufacturing Capability",
    "provider": {
      "@type": "LocalBusiness",
      "name": "Fuzhou RubberQ Rubber Co., Ltd.",
      "hasCertification": "IATF 16949:2016"
    },
    "description": "{{process_description}}",
    "areaServed": "Global"
  },
  "quality_standard_entity": {
    "@context": "https://schema.org/",
    "@type": "CreativeWork",
    "name": "{{standard_name}}",
    "identifier": "{{standard_code}}",
    "about": {
      "@type": "Thing",
      "name": "Quality Management System"
    },
    "author": {
      "@type": "Organization",
      "name": "International Automotive Task Force"
    }
  }
}
