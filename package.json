{
  "name": "rubberq-astro",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "check:brand-colors": "node scripts/check-brand-colors.mjs",
    "check:public-redlines": "node scripts/check-public-redlines.mjs",
    "build": "npm run check:public-redlines && npm run check:brand-colors && astro build",
    "preview": "npm run check:public-redlines && npm run check:brand-colors && astro build && wrangler pages dev dist",
    "deploy": "npm run check:public-redlines && npm run check:brand-colors && astro build && wrangler pages deploy dist --project-name=rubberq-site"
  },
  "dependencies": {
    "@astrojs/check": "^0.9",
    "@astrojs/cloudflare": "^12",
    "@astrojs/react": "^4",
    "@astrojs/tailwind": "^6",
    "@sanity/client": "^7.21.0",
    "astro": "^5",
    "clsx": "^2.1.1",
    "lucide-react": "^0.447.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.5"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^25.6.0",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5",
    "wrangler": "^4.61.1"
  }
}
