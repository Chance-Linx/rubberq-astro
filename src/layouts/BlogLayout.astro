---
import BaseLayout from './BaseLayout.astro';
import Navbar from '@/components/acquisition/Navigation.astro';
import Footer from '@/components/acquisition/Footer.astro';
import JsonLd from '@/components/JsonLd';
import { createOrganizationSchema } from '@/lib/structuredData';

interface Props { canonicalPath?: string; locale?: string }
const { canonicalPath } = Astro.props;
const locale = 'en';
const normalizedPathname = Astro.url.pathname.replace(/^\/en\/blog(?=\/|$)/, '/blog');
const canonicalPathname = canonicalPath && (/^\/blog(?:\/|\?|$)/.test(canonicalPath)) ? canonicalPath : normalizedPathname;
const canonicalUrl = `https://rubberq.com${canonicalPathname}`;
const orgSchema = createOrganizationSchema(locale);
---

<BaseLayout lang={locale}>
  <Fragment slot="head">
    <slot name="head" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="en" href={canonicalUrl} />
    <link rel="alternate" hreflang="x-default" href={canonicalUrl} />
    <meta property="og:site_name" content="RubberQ" />
    <meta property="og:url" content={canonicalUrl} />
    <JsonLd data={orgSchema} />
  </Fragment>
  <Navbar locale={locale} />
  <main class="min-h-screen pt-20">
    <slot />
  </main>
  <Footer locale={locale} />
</BaseLayout>
