---
import { defaultLocale, localizedPath } from '@/lib/i18n';

interface Props {
  locale: string;
}

const { locale } = Astro.props;
const current = locale || defaultLocale;

let messages: any;
try {
  messages = (await import(`../messages/${current}.json`)).default;
} catch {
  messages = (await import('../messages/en.json')).default;
}
const footer = messages?.footer || {};
const nav = messages?.navigation || {};
const tagline = messages?.footerTagline || 'Japanese Formulation. Chinese Precision. Trusted Since 1995.';
const homeHref = localizedPath(current, '/');
const hrefFor = (path: string) => localizedPath(current, path);
---

<footer class="bg-industrial-900 text-industrial-100 pt-0 pb-8 border-t border-industrial-800">
  <!-- v2 Tagline banner -->
  <div class="bg-gradient-to-r from-industrial-900 via-industrial-800 to-industrial-900 border-b border-industrial-700 py-8">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <p class="text-xl md:text-2xl font-bold text-white tracking-tight italic">
        "{tagline}"
      </p>
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-16">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-12 mb-12">
      <div class="col-span-1 md:col-span-1">
        <a href={homeHref} class="text-2xl font-bold tracking-tighter mb-4 block text-white">
          RUBBER<span class="text-accent-orange">Q</span>
        </a>
        <p class="text-industrial-400 text-sm leading-relaxed">
          {footer.certifications || 'Certifications: IATF 16949 | ISO 9001 | ISO 14001'}
        </p>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider mb-6 text-white">
          {footer.technicalHub || 'Technical Hub'}
        </h4>
        <ul class="space-y-4 text-sm text-industrial-400">
          <li><a href={hrefFor('/compounding')} class="hover:text-accent-orange transition-colors font-bold">{nav.compounding || 'Compounding & R&D'}</a></li>
          <li><a href={hrefFor('/testing')} class="hover:text-white transition-colors">{nav.testing || 'Testing & Validation'}</a></li>
          <li><a href={hrefFor('/materials')} class="hover:text-white transition-colors">{footer.materialHub || 'Material Hub'}</a></li>
          <li><a href={hrefFor('/industries')} class="hover:text-white transition-colors">{nav.industries || 'Industries'}</a></li>
          <li><a href={hrefFor('/quality')} class="hover:text-white transition-colors">{footer.qualityAssurance || 'Quality Assurance'}</a></li>
          <li><a href={hrefFor('/standards')} class="hover:text-white transition-colors">{footer.industryStandards || 'Industry Standards'}</a></li>
          <li><a href={hrefFor('/resources')} class="hover:text-white transition-colors">{nav.resources || 'Resources'}</a></li>
          <li><a href={hrefFor('/case-studies')} class="hover:text-white transition-colors">{nav.caseStudies || 'Case Studies'}</a></li>
          <li><a href="/blog" class="hover:text-white transition-colors">{current === 'en' ? (nav.blog || 'Blog') : `${nav.blog || 'Blog'} (EN)`}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider mb-6 text-white">
          {footer.company || 'Company'}
        </h4>
        <ul class="space-y-4 text-sm text-industrial-400">
          <li><a href={hrefFor('/about')} class="hover:text-white transition-colors">{footer.aboutRubberQ || 'About RubberQ'}</a></li>
          <li><a href={hrefFor('/factory')} class="hover:text-white transition-colors">{nav.factory || 'Factory'}</a></li>
          <li><a href={hrefFor('/capabilities')} class="hover:text-white transition-colors">{nav.capabilities || 'Capabilities'}</a></li>
          <li><a href={hrefFor('/contact')} class="hover:text-white transition-colors">{footer.globalSupport || 'Global Support'}</a></li>
        </ul>
      </div>

      <div>
        <h4 class="text-sm font-bold uppercase tracking-wider mb-6 text-white">
          {footer.globalPresence || 'Global Presence'}
        </h4>
        <p class="text-sm text-industrial-400 leading-relaxed">
          {footer.address || 'Fuzhou, China'}<br />
          {footer.email || 'contact@rubberq.com'}<br />
        </p>
      </div>
    </div>

    <div class="border-t border-industrial-800 pt-8 flex flex-col md:flex-row justify-between items-center gap-4">
      <p class="text-xs text-industrial-500">
        &copy; {new Date().getFullYear()} RubberQ. {footer.rightsReserved || 'All rights reserved.'}
      </p>
      <div class="flex gap-6 text-xs text-industrial-500">
        <a href={hrefFor('/privacy')} class="hover:text-white transition-colors">{footer.privacyPolicy || 'Privacy Policy'}</a>
        <a href={hrefFor('/terms')} class="hover:text-white transition-colors">{footer.termsOfService || 'Terms of Service'}</a>
        <a href="/sitemap.xml" class="hover:text-white transition-colors">Sitemap</a>
      </div>
    </div>
  </div>
</footer>
