---
import { getTranslations, localizedPath, locales, localeNames, tRaw } from '@/lib/i18n';
import { acquisitionPage } from '@/lib/acquisition';
import navigation from '@/data/acquisition-navigation.json';
interface Props { locale: string }
const { locale } = Astro.props;
const messages = await getTranslations(locale);
const ui = tRaw(messages, 'acquisition.ui');
const copies = tRaw(messages, 'acquisition.pages');
const currentPath = Astro.url.pathname.replace(/^\/(en|de|ja|es|zh)(?=\/|$)/, '') || '/';
const href = (url: string) => url === '/blog' ? '/blog' : localizedPath(locale, url);
const label = (url: string) => copies[acquisitionPage(url)!.id].label;
---
<header class="rq-nav-header"><nav class="rq-nav" aria-label={ui.navigation}>
  <a class="rq-nav-brand" href={localizedPath(locale, '/')} aria-label="RubberQ">RUBBER<span>Q</span></a>
  <button class="rq-nav-toggle" id="rq-menu-toggle" aria-expanded="false" aria-controls="rq-navigation-panel">{ui.menu} <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 6h18M3 12h18M3 18h18"/></svg></button>
  <div class="rq-nav-panel" id="rq-navigation-panel" data-open="false">
    {navigation.map(group => <details class="rq-nav-group"><summary>{label(group.url)}</summary><div class="rq-nav-dropdown"><a class="rq-nav-parent" href={href(group.url)}>{label(group.url)} <span aria-hidden="true">↗</span></a>{group.children.map(url => <a href={href(url)} aria-current={currentPath === url ? 'page' : undefined}>{label(url)}</a>)}</div></details>)}
    <a class="rq-nav-search" href={localizedPath(locale, '/search')} aria-label={ui.search}><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span class="rq-nav-mobile-label">{ui.search}</span></a>
    <details class="rq-nav-group rq-nav-language"><summary aria-label={ui.language}>{locale.toUpperCase()}</summary><div class="rq-nav-dropdown">{locales.map(lang => <a href={localizedPath(lang, currentPath.startsWith('/blog') ? '/resources' : currentPath)} lang={lang} hreflang={lang} aria-current={lang === locale ? 'true' : undefined}>{localeNames[lang]}</a>)}</div></details>
    <a class="rq-nav-quote" href={localizedPath(locale, '/contact')}>{copies['RQ-PG-044'].cta}</a>
  </div>
</nav></header>
<script>
  const toggle = document.getElementById('rq-menu-toggle');
  const panel = document.getElementById('rq-navigation-panel');
  toggle?.addEventListener('click', () => { const open = toggle.getAttribute('aria-expanded') !== 'true'; toggle.setAttribute('aria-expanded', String(open)); panel?.setAttribute('data-open', String(open)); });
  document.querySelectorAll<HTMLDetailsElement>('.rq-nav-group').forEach(item => item.addEventListener('toggle', () => { if (item.open) document.querySelectorAll<HTMLDetailsElement>('.rq-nav-group').forEach(other => { if (other !== item) other.open = false; }); }));
  document.addEventListener('click', event => { document.querySelectorAll<HTMLDetailsElement>('.rq-nav-group[open]').forEach(item => { if (!item.contains(event.target as Element)) item.open = false; }); });
  document.addEventListener('keydown', event => { if (event.key !== 'Escape') return; const open = document.querySelector<HTMLDetailsElement>('.rq-nav-group[open]'); if (open) { open.open = false; open.querySelector('summary')?.focus(); } else if (toggle?.getAttribute('aria-expanded') === 'true') { toggle.setAttribute('aria-expanded', 'false'); panel?.setAttribute('data-open', 'false'); toggle.focus(); } });
</script>
<style>
  .rq-nav-header{position:fixed;inset:0 0 auto;z-index:50;background:#FFFFFF;border-bottom:1px solid #E5E5E5}.rq-nav{max-width:1320px;margin:auto;padding:0 28px;min-height:80px;display:flex;align-items:center;gap:24px}.rq-nav-brand{font-size:25px;font-weight:900;letter-spacing:-.06em;text-decoration:none;flex-shrink:0}.rq-nav-brand span{color:#EA580C}.rq-nav-panel{display:flex;align-items:center;justify-content:flex-end;gap:18px;flex:1}.rq-nav-group{position:relative}.rq-nav-group summary{cursor:pointer;list-style:none;font-size:12px;font-weight:700;padding:18px 0;display:flex;align-items:center;gap:6px;white-space:nowrap}.rq-nav-group summary::-webkit-details-marker{display:none}.rq-nav-group summary::after{content:'+';font-family:monospace;color:#525252}.rq-nav-group[open] summary::after{content:'−'}.rq-nav-dropdown{position:absolute;top:100%;left:-18px;min-width:240px;max-width:360px;max-height:70vh;overflow:auto;background:#FFFFFF;border:1px solid #E5E5E5;padding:8px}.rq-nav-dropdown a{display:block;min-height:44px;padding:11px 12px;font-size:13px;text-decoration:none;overflow-wrap:anywhere}.rq-nav-dropdown a:hover,.rq-nav-dropdown a[aria-current]{background:#FAFAFA;text-decoration:underline;text-underline-offset:4px}.rq-nav-dropdown .rq-nav-parent{font-weight:800;border-bottom:1px solid #E5E5E5;margin-bottom:4px}.rq-nav-search{display:flex;align-items:center;justify-content:center;min-width:44px;min-height:44px}.rq-nav-mobile-label{display:none}.rq-nav-language .rq-nav-dropdown{left:auto;right:0;min-width:140px}.rq-nav-quote{font-size:12px;font-weight:700;background:#0A0A0A;color:#FFFFFF;padding:14px 18px;min-height:46px;text-decoration:none;white-space:nowrap}.rq-nav-quote:hover{background:#262626}.rq-nav-toggle{display:none}summary:focus-visible,a:focus-visible,button:focus-visible{outline:2px solid #F97316;outline-offset:4px}@media(max-width:1150px){.rq-nav{justify-content:space-between;padding-inline:20px}.rq-nav-toggle{display:flex;align-items:center;gap:12px;min-height:48px;padding:10px;border:1px solid #D4D4D4;background:#FFFFFF;font-size:13px}.rq-nav-panel{display:none;position:absolute;top:80px;left:0;right:0;max-height:calc(100dvh - 80px);overflow:auto;background:#FFFFFF;padding:12px 20px 24px;border-bottom:1px solid #D4D4D4}.rq-nav-panel[data-open=true]{display:block}.rq-nav-group{border-bottom:1px solid #E5E5E5}.rq-nav-group summary{padding:16px 0;justify-content:space-between;font-size:15px}.rq-nav-dropdown,.rq-nav-language .rq-nav-dropdown{position:static;border:0;max-width:none;max-height:none;padding:0 0 12px 12px}.rq-nav-quote{display:block;text-align:center;margin-top:16px}.rq-nav-search{justify-content:flex-start;gap:12px;border-bottom:1px solid #E5E5E5;padding-block:15px}.rq-nav-mobile-label{display:inline}}
</style>
