---
import BlogLayout from '@/layouts/BlogLayout.astro';
import { renderArticleContent } from '@/lib/articleContent';
import { isArticleCoverSuppressed, makeArticleTablesScrollable } from '@/lib/articlePresentation';
import { getFeaturedImageUrl, getBlogUrl } from '@/lib/sanity';
import JsonLd from '@/components/JsonLd';
import { createBlogPostingSchema } from '@/lib/structuredData';
import type { BlogPost } from '@/lib/sanity';

interface Props { post: BlogPost; relatedPosts?: BlogPost[] }
const { post, relatedPosts = [] } = Astro.props;
const imageUrl = isArticleCoverSuppressed(post._id, post.coverImage?.asset?._ref) ? undefined : getFeaturedImageUrl(post);
const date = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
const blogSchema = createBlogPostingSchema({
  slug: post.slug,
  title: post.title,
  excerpt: post.excerpt,
  publishedAt: post.publishedAt,
  updatedAt: post._updatedAt,
  author: post.author,
  image: imageUrl,
});
---

<BlogLayout locale="en" canonicalPath={getBlogUrl(post.slug)}>
  <Fragment slot="head">
    <title>{post.title} | RubberQ</title>
    <meta name="description" content={post.excerpt || post.title} />
    <meta property="og:title" content={post.title} />
    <meta property="og:description" content={post.excerpt || ''} />
    {imageUrl && <meta property="og:image" content={imageUrl} />}
    <meta property="og:type" content="article" />
    <meta property="article:published_time" content={post.publishedAt} />
    <meta name="twitter:card" content={imageUrl ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={post.title} />
    <meta name="twitter:description" content={post.excerpt || post.title} />
    {imageUrl && <meta name="twitter:image" content={imageUrl} />}
    <JsonLd data={blogSchema} />
    <slot name="head" />
  </Fragment>

  <article class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Header -->
      <header class="mb-12">
        {post.category && (
          <a href={`/blog?category=${encodeURIComponent(post.category)}`}
             class="text-xs font-bold uppercase tracking-wider text-primary mb-4 inline-block hover:underline">
            {post.category}
          </a>
        )}
        <h1 id="article-title" class="text-3xl sm:text-4xl lg:text-5xl font-bold tracking-tight mb-6 break-words">
          {post.title}
        </h1>
        <div class="flex flex-wrap items-center gap-4 text-sm text-muted">
          <time datetime={post.publishedAt}>{date}</time>
          {post.author && <span>By {post.author}</span>}
        </div>
        {post.tags && post.tags.length > 0 && (
          <div class="flex flex-wrap gap-2 mt-4">
            {post.tags.map((tag: string) => (
              <span class="px-3 py-1 text-xs border border-border text-muted">{tag}</span>
            ))}
          </div>
        )}
      </header>

      <!-- Featured Image -->
      {imageUrl && (
        <div class="mb-12">
          <img src={imageUrl} alt={post.title} class="w-full h-auto max-h-96 object-cover" loading="eager" />
        </div>
      )}

      <!-- Content - rendered as HTML from Sanity portable text or markdown -->
      <div class="article-body prose prose-lg max-w-none min-w-0 mb-16">
        {post.content ? (
          <Fragment set:html={makeArticleTablesScrollable(renderArticleContent(post.content))} />
        ) : (
          <p class="text-muted">Content loading...</p>
        )}
      </div>

      <!-- Related Posts -->
      {relatedPosts.length > 0 && (
        <section class="border-t border-border pt-12 mt-12">
          <h2 class="text-2xl font-bold mb-8">Related Articles</h2>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            {relatedPosts.map((related: BlogPost) => {
              const relatedImage = isArticleCoverSuppressed(related._id, related.coverImage?.asset?._ref) ? undefined : getFeaturedImageUrl(related);
              return (
                <a href={getBlogUrl(related.slug)}
                   class="group border border-border hover:border-primary transition-colors">
                  {relatedImage && (
                    <img src={relatedImage} alt={related.title} class="w-full h-36 object-cover" loading="lazy" />
                  )}
                  <div class="p-4">
                    <h3 class="text-sm font-bold group-hover:text-primary transition-colors line-clamp-2">{related.title}</h3>
                  </div>
                </a>
              );
            })}
          </div>
        </section>
      )}
    </div>
  </article>
</BlogLayout>

<style>
  .article-body { overflow-wrap: anywhere; }
  .article-body :global(.article-table-scroll) { max-width: 100%; overflow-x: auto; margin-block: 2rem; }
  .article-body :global(.article-table-scroll:focus-visible) { outline: 2px solid #ea580c; outline-offset: 3px; }
  .article-body :global(.article-table-scroll table) { min-width: 42rem; margin: 0; }
  .article-body :global(th), .article-body :global(td) { padding: .75rem; vertical-align: top; }
  .article-body :global(pre) { max-width: 100%; overflow-x: auto; }
  .article-body :global(img) { max-width: 100%; height: auto; }
</style>
