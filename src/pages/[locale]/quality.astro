---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, localizedPath, t, tRaw } from '@/lib/i18n';
import QualityPageClient from '@/components/quality/QualityPageClient';
import SummarySnippet from '@/components/aio/SummarySnippet';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const f = (key: string, fallback = '') => t(messages, `quality.${key}`, fallback);
const fa = (key: string) => tRaw(messages, `quality.${key}`);

// --- Trust labels (not in translations, inline for all 5 locales) ---
const trustLabels: Record<string, {
  sectionTitle: string; sectionSubtitle: string;
  reportsTitle: string; reportsSubtitle: string; reportsAction: string;
  traceTitle: string; traceSubtitle: string;
  videoTitle: string; videoSubtitle: string;
  watch: string; stepLabel: string;
}> = {
  en: {
    sectionTitle: 'Quality Documentation Center',
    sectionSubtitle: 'Process documents and test records for purchasing, engineering, and quality teams.',
    reportsTitle: 'Lab Reports & Process Downloads',
    reportsSubtitle: 'Standard test records that support material selection and production release.',
    reportsAction: 'Open Technical Pack',
    traceTitle: 'Supplier Traceability Chain',
    traceSubtitle: 'From approved suppliers to final outgoing inspection with digital batch references.',
    videoTitle: 'Factory and Lab Visuals',
    videoSubtitle: 'Manufacturing, testing, and engineering records that help your team understand our process.',
    watch: 'Open',
    stepLabel: 'Stage',
  },
  zh: {
    sectionTitle: '质量资料中心',
    sectionSubtitle: '面向采购、工程和质量团队的工艺文件、检测记录与追溯资料。',
    reportsTitle: '检测报告与工艺资料',
    reportsSubtitle: '用于材料选择和生产放行的标准测试记录。',
    reportsAction: '打开技术资料',
    traceTitle: '供应链追溯链路',
    traceSubtitle: '从合格供应商到出货终检，形成批次级数字追踪。',
    videoTitle: '工厂与实验室影像',
    videoSubtitle: '通过制造、检测和工程记录，帮助客户理解 RubberQ 的质量过程。',
    watch: '打开',
    stepLabel: '阶段',
  },
  de: {
    sectionTitle: 'Qualitätsdokumentation',
    sectionSubtitle: 'Prozessunterlagen und Prüfaufzeichnungen für Einkauf, Engineering und Qualitätsteams.',
    reportsTitle: 'Laborberichte & Prozessunterlagen',
    reportsSubtitle: 'Standardisierte Prüfaufzeichnungen für Materialauswahl und Produktionsfreigabe.',
    reportsAction: 'Technikpaket öffnen',
    traceTitle: 'Lieferketten-Rückverfolgbarkeit',
    traceSubtitle: 'Von freigegebenen Lieferanten bis zur Endprüfung mit digitalem Chargenbezug.',
    videoTitle: 'Werk- und Laboransichten',
    videoSubtitle: 'Fertigungs-, Prüf- und Engineering-Unterlagen zur besseren Prozessbewertung.',
    watch: 'Öffnen',
    stepLabel: 'Stufe',
  },
  ja: {
    sectionTitle: '品質資料センター',
    sectionSubtitle: '購買・技術・品質チーム向けの工程資料、試験記録、トレーサビリティ情報です。',
    reportsTitle: '試験レポートと検証資料ダウンロード',
    reportsSubtitle: '材料選定と生産リリースを支える標準試験記録です。',
    reportsAction: '資料パックを開く',
    traceTitle: 'サプライチェーントレーサビリティ',
    traceSubtitle: '承認サプライヤから最終出荷検査までをロット単位で追跡。',
    videoTitle: '工場・ラボの資料',
    videoSubtitle: '製造、試験、技術記録を通じて RubberQ の品質プロセスを確認できます。',
    watch: '開く',
    stepLabel: '工程',
  },
  es: {
    sectionTitle: 'Centro de Documentación de Calidad',
    sectionSubtitle: 'Documentos de proceso y registros de prueba para compras, ingeniería y calidad.',
    reportsTitle: 'Reportes de Laboratorio y Proceso',
    reportsSubtitle: 'Registros estándar que apoyan selección de material y liberación de producción.',
    reportsAction: 'Abrir paquete técnico',
    traceTitle: 'Cadena de Trazabilidad de Proveedores',
    traceSubtitle: 'Desde proveedores aprobados hasta inspección final con referencia digital por lote.',
    videoTitle: 'Visuales de Fábrica y Laboratorio',
    videoSubtitle: 'Registros de fabricación, prueba e ingeniería para entender nuestro proceso.',
    watch: 'Abrir',
    stepLabel: 'Etapa',
  },
};

const trust = trustLabels[locale] || trustLabels.en;

// --- Certificates ---
const certificates = [
  {
    id: 'iatf-16949',
    name: 'IATF 16949:2016',
    org: f('certificates.iatf.org'),
    issuer: f('certifications.documentCenter', 'RubberQ quality document center'),
    issueDate: f('certifications.availableOnRequest', 'Available on request'),
    expiryDate: f('certifications.availableOnRequest', 'Available on request'),
    description: f('certificates.iatf.description'),
    placeholder: 'https://images.unsplash.com/photo-1450101499163-c8848c66ca85?auto=format&fit=crop&q=80&w=800',
  },
  {
    id: 'iso-9001',
    name: 'ISO 9001:2015',
    org: f('certificates.iso9001.org'),
    issuer: f('certifications.documentCenter', 'RubberQ quality document center'),
    issueDate: f('certifications.availableOnRequest', 'Available on request'),
    expiryDate: f('certifications.availableOnRequest', 'Available on request'),
    description: f('certificates.iso9001.description'),
    placeholder: 'https://images.unsplash.com/photo-1554224155-6726b3ff858f?auto=format&fit=crop&q=80&w=800',
  },
  {
    id: 'iso-14001',
    name: 'ISO 14001:2015',
    org: f('certificates.iso14001.org'),
    issuer: f('certifications.documentCenter', 'RubberQ quality document center'),
    issueDate: f('certifications.availableOnRequest', 'Available on request'),
    expiryDate: f('certifications.availableOnRequest', 'Available on request'),
    description: f('certificates.iso14001.description'),
    placeholder: 'https://images.unsplash.com/photo-1542601906990-b4d3fb778b09?auto=format&fit=crop&q=80&w=800',
  },
  {
    id: 'rohs-reach',
    name: 'RoHS & REACH',
    org: f('certificates.rohs.org'),
    issuer: f('certifications.documentCenter', 'RubberQ quality document center'),
    issueDate: f('certifications.availableOnRequest', 'Available on request'),
    expiryDate: f('certifications.availableOnRequest', 'Available on request'),
    description: f('certificates.rohs.description'),
    placeholder: 'https://images.unsplash.com/photo-1621905252507-b35492cc74b4?auto=format&fit=crop&q=80&w=800',
  },
];

// --- Lab equipment and QC scenes from translations ---
const labEquipment = fa('lab.equipment') || [];
const qcScenes = fa('process.scenes') || [];
const traceabilitySteps = fa('traceability.steps') || [];
const traceabilityFlow = fa('traceability.flow') || [];
const controlPlanGroups = fa('controlPlan.groups') || [];
const controlPlanMetrics = fa('controlPlan.metrics') || [];

// --- Report downloads ---
const reportDownloads = [
  {
    title:
      locale === 'zh' ? '材料验证报告包'
      : locale === 'de' ? 'Materialvalidierungspaket'
      : locale === 'ja' ? '材料検証レポートパック'
      : locale === 'es' ? 'Paquete de validación de material'
      : 'Material Validation Pack',
    description:
      locale === 'zh' ? '包含硬度、拉伸、压缩永久变形及热老化测试摘要。'
      : locale === 'de' ? 'Enthält Zusammenfassungen zu Härte, Zugfestigkeit, Druckverformungsrest und Wärmealterung.'
      : locale === 'ja' ? '硬度、引張、圧縮永久ひずみ、熱老化の試験概要を含みます。'
      : locale === 'es' ? 'Incluye resúmenes de dureza, tracción, compresión permanente y envejecimiento térmico.'
      : 'Includes hardness, tensile, compression-set, and thermal aging summary results.',
    href: '/resources',
  },
  {
    title:
      locale === 'zh' ? '批次检验模板'
      : locale === 'de' ? 'Chargenprüfvorlage'
      : locale === 'ja' ? 'ロット検査テンプレート'
      : locale === 'es' ? 'Plantilla de inspección por lote'
      : 'Batch Inspection Template',
    description:
      locale === 'zh' ? '展示来料检验、过程巡检与终检记录字段结构。'
      : locale === 'de' ? 'Zeigt Felder für Wareneingang, Prozessprüfung und Endprüfung.'
      : locale === 'ja' ? '受入、工程内、最終検査の記録項目を示します。'
      : locale === 'es' ? 'Muestra campos de inspección de entrada, proceso y final.'
      : 'Shows incoming, in-process, and final inspection record fields.',
    href: '/resources',
  },
  {
    title:
      locale === 'zh' ? '标准与证书摘要'
      : locale === 'de' ? 'Normen- und Zertifikatsübersicht'
      : locale === 'ja' ? '規格・認証概要'
      : locale === 'es' ? 'Resumen de normas y certificados'
      : 'Standards & Certificate Summary',
    description:
      locale === 'zh' ? 'RoHS/REACH 与质量体系证书关联清单。'
      : locale === 'de' ? 'Übersicht zu RoHS/REACH und Qualitätsmanagement-Zertifikaten.'
      : locale === 'ja' ? 'RoHS/REACH と品質システム認証の参照リストです。'
      : locale === 'es' ? 'Lista de referencia para RoHS/REACH y certificados del sistema de calidad.'
      : 'Cross-reference list for RoHS/REACH and quality-system certificates.',
    href: '/standards',
  },
];

// --- Supplier traceability ---
const supplierTraceability = [
  {
    stage: '01',
    title: locale === 'zh' ? '供应商准入' : 'Supplier Qualification',
    description:
      locale === 'zh'
        ? '按材料类别建立合格供应商白名单与年度复审。'
        : 'Approved supplier whitelist by material family with annual re-validation.',
  },
  {
    stage: '02',
    title: locale === 'zh' ? '原料批次绑定' : 'Raw Batch Binding',
    description:
      locale === 'zh'
        ? '每批原料入库即绑定批次号与证书信息。'
        : 'Each incoming lot is linked to batch ID and certificate metadata.',
  },
  {
    stage: '03',
    title: locale === 'zh' ? '过程追踪' : 'In-Process Tracking',
    description:
      locale === 'zh'
        ? '配料、硫化、检验节点记录完整过程参数。'
        : 'Compounding, curing, and inspection nodes keep complete process parameters.',
  },
  {
    stage: '04',
    title: locale === 'zh' ? '出货追溯' : 'Shipment Traceback',
    description:
      locale === 'zh'
        ? '每个发货批次可反查到原料与过程记录。'
        : 'Every shipped lot can be traced back to raw material and process records.',
  },
];

// --- Factory and lab process records ---
const videoTestimonials = [
  {
    title:
      locale === 'zh' ? '混炼线过程资料'
      : locale === 'de' ? 'Prozessunterlagen der Mischlinie'
      : locale === 'ja' ? '混練ライン工程資料'
      : locale === 'es' ? 'Documentación de la línea de mezcla'
      : 'Compounding Line Process Records',
    summary:
      locale === 'zh' ? '用于了解 A 炼、批次记录和现场复核方式。'
      : locale === 'de' ? 'Zeigt A-Mischung, Chargenaufzeichnungen und Prüfabläufe vor Ort.'
      : locale === 'ja' ? 'A混練、ロット記録、現場確認の流れを確認できます。'
      : locale === 'es' ? 'Permite entender la mezcla A, los registros por lote y la revisión en planta.'
      : 'Shows A-line mixing, batch records, and on-site process review.',
    href: '/factory',
  },
  {
    title:
      locale === 'zh' ? '实验室验证资料'
      : locale === 'de' ? 'Laborvalidierungsunterlagen'
      : locale === 'ja' ? 'ラボ検証資料'
      : locale === 'es' ? 'Documentación de validación del laboratorio'
      : 'Laboratory Validation Records',
    summary:
      locale === 'zh' ? '覆盖硬度、拉伸、压缩永久变形、热老化等常用测试。'
      : locale === 'de' ? 'Deckt Härte, Zugfestigkeit, Druckverformungsrest und Wärmealterung ab.'
      : locale === 'ja' ? '硬度、引張、圧縮永久ひずみ、熱老化などを扱います。'
      : locale === 'es' ? 'Cubre dureza, tracción, compresión permanente y envejecimiento térmico.'
      : 'Covers hardness, tensile, compression-set, and thermal-aging tests.',
    href: '/testing',
  },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.quality?.title || 'Quality Assurance'}</title>
    <meta name="description" content={meta.quality?.description || ''} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <!-- Hero -->
    <section data-section-name="quality-hero" class="bg-industrial-900 text-white py-24 px-4">
      <div class="max-w-7xl mx-auto">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">{f('hero.title')}</h1>
        <p class="text-xl text-industrial-300 max-w-2xl">
          {f('hero.subtitle')}
        </p>
      </div>
    </section>

    <!-- Certifications Section -->
    <section id="certifications" data-section-name="quality-certifications" class="py-20 px-4 max-w-7xl mx-auto">
      <div class="flex items-center justify-between mb-12">
        <div class="flex items-center gap-3">
          <svg class="w-8 h-8 text-accent-orange" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          <div>
            <h2 class="text-3xl font-bold text-industrial-900">{f('certifications.title')}</h2>
            <p class="text-industrial-500 mt-1">{f('certifications.subtitle')}</p>
          </div>
        </div>
      </div>

      <QualityPageClient
        certificates={certificates}
        viewDetailsText={f('certifications.viewDetails')}
        client:load
      />

      <!-- Cross-link to Resources -->
      <div class="mt-12 p-6 bg-industrial-50 border border-industrial-200 border-t-4 border-t-accent-orange">
        <div class="flex items-start gap-4">
          <svg class="w-6 h-6 text-accent-orange flex-shrink-0 mt-1" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
          <div>
            <h4 class="font-bold text-industrial-900 mb-1">{f('documentation.title')}</h4>
            <p class="text-sm text-industrial-600">
              {f('documentation.description')}
              <a href={`${localizedPath(locale, '/contact')}?source_path=${encodeURIComponent(localizedPath(locale, '/quality'))}&cta_id=quality-doc-link&cta_label=${encodeURIComponent('Request Document Package')}`} class="text-accent-orange font-medium hover:underline ml-1">
                {f('documentation.link')} →
              </a>
            </p>
          </div>
        </div>
      </div>

      <!-- Control Plan Proof -->
      <div class="mt-16 bg-white border border-industrial-200">
        <div class="grid lg:grid-cols-[0.9fr_1.1fr] gap-0">
          <div class="bg-industrial-900 text-white p-8 md:p-10 flex flex-col justify-between">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.28em] text-accent-orange mb-4">
                {f('controlPlan.eyebrow')}
              </p>
              <h3 class="text-3xl md:text-4xl font-bold tracking-tighter uppercase mb-6">
                {f('controlPlan.title')}
              </h3>
              <p class="text-industrial-300 leading-relaxed">
                {f('controlPlan.subtitle')}
              </p>
              <div
                class="mt-8 aspect-[4/3] bg-white/5 border-2 border-dashed border-white/20 flex flex-col items-center justify-center text-center p-6"
                data-slot-id="quality-control-plan-record"
                data-purpose="控制计划、检验记录或批次放行记录展示"
                data-spec="1200x900"
                data-priority="important"
              >
                <span class="text-xs font-bold uppercase tracking-[0.28em] text-accent-orange mb-3">
                  {f('controlPlan.imageSlot.label')}
                </span>
                <span class="text-lg font-bold text-white mb-2">{f('controlPlan.imageSlot.title')}</span>
                <span class="text-xs text-industrial-400 max-w-sm leading-relaxed">{f('controlPlan.imageSlot.meta')}</span>
              </div>
            </div>
            <a href={localizedPath(locale, `/capabilities`)} class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-xs tracking-widest hover:underline mt-8">
              {f('controlPlan.linkToFlow')} →
            </a>
          </div>

          <div class="p-8 md:p-10">
            <div class="grid md:grid-cols-2 gap-6 mb-10">
              {Array.isArray(controlPlanGroups) && controlPlanGroups.map((group: { title: string; checks: string[]; evidence: string }) => (
                <div class="border border-industrial-200 p-6 bg-industrial-50/60">
                  <h4 class="font-bold text-industrial-900 mb-4 uppercase tracking-tight">{group.title}</h4>
                  <ul class="space-y-2 mb-5">
                    {Array.isArray(group.checks) && group.checks.map((check: string) => (
                      <li class="flex gap-3 text-sm text-industrial-700 leading-relaxed">
                        <span class="text-accent-orange font-bold shrink-0">▸</span>
                        <span>{check}</span>
                      </li>
                    ))}
                  </ul>
                  <p class="text-xs text-industrial-500 border-t border-industrial-200 pt-4 leading-relaxed">{group.evidence}</p>
                </div>
              ))}
            </div>

            <div class="border border-industrial-200 border-t-4 border-t-accent-orange p-6">
              <h4 class="font-bold text-industrial-900 mb-4">{f('controlPlan.metricsTitle')}</h4>
              <div class="grid sm:grid-cols-2 gap-3">
                {Array.isArray(controlPlanMetrics) && controlPlanMetrics.map((metric: string) => (
                  <p class="text-sm text-industrial-700 bg-white border border-industrial-200 px-4 py-3">{metric}</p>
                ))}
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Lab Capability & Visual Proof -->
    <section class="py-20 px-4 bg-industrial-50">
      <div class="max-w-7xl mx-auto">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center mb-20">
          <div>
            <div class="flex items-center gap-2 mb-6 text-industrial-600">
              <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="8" height="8" x="3" y="3" rx="2"/><path d="M3 13h4v8H3z"/><path d="M17 3h4v8h-4z"/><path d="M13 13h8v8h-8z"/></svg>
              <h2 class="text-3xl font-bold">{f('lab.title')}</h2>
            </div>
            <p class="text-lg text-industrial-600 mb-8">
              {f('lab.description')}
            </p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
              {Array.isArray(labEquipment) && labEquipment.map((eq: {name: string, function: string, standards?: string, img: string}) => (
                <div class="flex flex-col gap-3 group">
                  <div class="aspect-video overflow-hidden border border-industrial-100 shadow-sm">
                    <img src={eq.img} alt={eq.name} class="w-full h-full object-cover grayscale contrast-110 brightness-90 group-hover:grayscale-0 group-hover:contrast-100 group-hover:brightness-100 transition-[filter,transform] duration-500" />
                  </div>
                  <div class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-industrial-900 mt-1 shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <div>
                      <span class="font-bold block text-sm">{eq.name}</span>
                      <span class="text-xs text-industrial-500 block">{eq.function}</span>
                      {eq.standards && <span class="text-xs font-mono text-accent-orange mt-1 inline-block">{eq.standards}</span>}
                    </div>
                  </div>
                </div>
              ))}
            </div>
            <a href={localizedPath(locale, `/testing`)} class="mt-8 inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-xs tracking-widest hover:underline">
              {f('lab.fullCapabilityLink', 'See full ASTM/ISO testing matrix')} →
            </a>
          </div>

          <div class="bg-white p-8 border border-industrial-100">
            <SummarySnippet
              title={f('traceability.title')}
              items={
                Array.isArray(traceabilitySteps)
                  ? traceabilitySteps.map((item: { term?: string; title?: string; description?: string; desc?: string }) => ({
                      term: item.term || item.title || '',
                      description: item.description || item.desc || '',
                    }))
                  : []
              }
              client:load
            />
            <div class="mt-8 pt-8 border-t border-industrial-100">
              <p class="text-sm text-industrial-500 italic">
                {f('lab.note')}
              </p>
            </div>
          </div>
        </div>

        <div>
          <div class="flex items-center gap-2 mb-10 text-industrial-600">
            <svg class="w-6 h-6" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
            <h3 class="text-2xl font-bold">{f('process.title')}</h3>
          </div>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {Array.isArray(qcScenes) && qcScenes.map((scene: {title: string, desc: string, img: string}, idx: number) => (
              <div class="relative group overflow-hidden bg-white border border-industrial-100">
                <div class="aspect-[4/3] overflow-hidden">
                  <img src={scene.img} alt={scene.title} class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105" />
                </div>
                <div class="p-6">
                  <h4 class="font-bold mb-2">{scene.title}</h4>
                  <p class="text-sm text-industrial-600">{scene.desc}</p>
                </div>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Why Single-Line Matters (v2) -->
    <section class="py-20 px-4 bg-industrial-900 text-white">
      <div class="max-w-5xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter mb-6 uppercase">
          {f('whySingleLine.title', 'Why We Run a Single A-Mixing Line')}
        </h2>
        <p class="text-lg text-industrial-300 mb-10">{f('whySingleLine.intro')}</p>
        <div class="grid md:grid-cols-3 gap-6 mb-10">
          <div class="border-l-2 border-accent-orange pl-6">
            <span class="text-accent-orange text-3xl font-bold block mb-3">01</span>
            <p class="leading-relaxed">{f('whySingleLine.point1')}</p>
          </div>
          <div class="border-l-2 border-accent-orange pl-6">
            <span class="text-accent-orange text-3xl font-bold block mb-3">02</span>
            <p class="leading-relaxed">{f('whySingleLine.point2')}</p>
          </div>
          <div class="border-l-2 border-accent-orange pl-6">
            <span class="text-accent-orange text-3xl font-bold block mb-3">03</span>
            <p class="leading-relaxed">{f('whySingleLine.point3')}</p>
          </div>
        </div>
        <a href={localizedPath(locale, `/compounding`)} class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest hover:underline">
          {f('whySingleLine.link', 'See our compounding capabilities in detail')} →
        </a>
      </div>
    </section>

    <!-- Traceability Flow -->
    <section data-section-name="traceability-flow" class="py-20 px-4 max-w-7xl mx-auto">
      <div class="text-center mb-16">
        <h2 class="text-3xl font-bold mb-4">{f('traceability.mainTitle')}</h2>
        <p class="text-industrial-500 max-w-2xl mx-auto">{f('traceability.subtitle')}</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        {Array.isArray(traceabilityFlow) && traceabilityFlow.map((item: {step: string, title: string, desc: string}) => (
          <div class="text-center p-6 bg-white border border-industrial-100 relative overflow-hidden group">
            <span class="text-6xl font-black text-industrial-50 absolute -bottom-4 -right-4 transition-transform group-hover:scale-110">{item.step}</span>
            <h4 class="text-xl font-bold mb-2 relative z-10">{item.title}</h4>
            <p class="text-sm text-industrial-600 relative z-10">{item.desc}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- Trust Evidence Center -->
    <section data-section-name="trust-evidence-center" class="py-20 px-4 bg-industrial-50 border-t border-industrial-200">
      <div class="max-w-7xl mx-auto">
        <div class="mb-12">
          <h2 class="text-3xl font-bold text-industrial-900 mb-3">{trust.sectionTitle}</h2>
          <p class="text-industrial-600 max-w-3xl">{trust.sectionSubtitle}</p>
        </div>

        <div class="grid grid-cols-1 xl:grid-cols-3 gap-8">
          <!-- Reports -->
          <div class="bg-white border border-industrial-200 p-6">
            <div class="flex items-center gap-3 mb-4">
              <svg class="w-5 h-5 text-accent-orange" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
              <h3 class="text-lg font-bold text-industrial-900">{trust.reportsTitle}</h3>
            </div>
            <p class="text-sm text-industrial-600 mb-5">{trust.reportsSubtitle}</p>
            <div class="space-y-3">
              {reportDownloads.map((item) => (
                <a href={localizedPath(locale, `${item.href}`)} class="block border border-industrial-200 p-4 hover:border-accent-orange transition-colors">
                  <p class="font-bold text-sm text-industrial-900 mb-1">{item.title}</p>
                  <p class="text-xs text-industrial-600">{item.description}</p>
                </a>
              ))}
            </div>
            <a href={localizedPath(locale, `/resources`)} class="inline-block mt-5 text-sm font-bold uppercase tracking-wider text-accent-orange hover:underline">
              {trust.reportsAction}
            </a>
          </div>

          <!-- Traceability -->
          <div class="bg-white border border-industrial-200 p-6">
            <div class="flex items-center gap-3 mb-4">
              <svg class="w-5 h-5 text-accent-orange" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m21 21-5.2-5.2"/><circle cx="11" cy="11" r="8"/><path d="M11 3a8 8 0 0 1 0 16"/><path d="m21 3-8 8"/></svg>
              <h3 class="text-lg font-bold text-industrial-900">{trust.traceTitle}</h3>
            </div>
            <p class="text-sm text-industrial-600 mb-5">{trust.traceSubtitle}</p>
            <div class="space-y-3">
              {supplierTraceability.map((item) => (
                <div class="border-l-4 border-industrial-200 pl-4 py-1">
                  <p class="text-xs font-bold uppercase tracking-widest text-industrial-500 mb-1">
                    {trust.stepLabel} {item.stage}
                  </p>
                  <p class="font-bold text-sm text-industrial-900 mb-1">{item.title}</p>
                  <p class="text-xs text-industrial-600">{item.description}</p>
                </div>
              ))}
            </div>
          </div>

          <!-- Videos -->
          <div class="bg-white border border-industrial-200 p-6">
            <div class="flex items-center gap-3 mb-4">
              <svg class="w-5 h-5 text-accent-orange" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><polygon points="10 8 16 12 10 16 10 8"/></svg>
              <h3 class="text-lg font-bold text-industrial-900">{trust.videoTitle}</h3>
            </div>
            <p class="text-sm text-industrial-600 mb-5">{trust.videoSubtitle}</p>
            <div class="space-y-3">
              {videoTestimonials.map((item) => (
                <a href={localizedPath(locale, `${item.href}`)} class="block border border-industrial-200 p-4 hover:border-accent-orange transition-colors group">
                  <p class="font-bold text-sm text-industrial-900 mb-1 group-hover:text-accent-orange transition-colors">{item.title}</p>
                  <p class="text-xs text-industrial-600 mb-2">{item.summary}</p>
                  <span class="text-xs font-bold uppercase tracking-wider text-accent-orange">{trust.watch}</span>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
