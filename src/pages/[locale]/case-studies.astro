---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, t } from '@/lib/i18n';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const cs = (key: string, fallback = '') => t(messages, `caseStudies.${key}`, fallback);

const labelsByLocale: Record<string, Record<string, string>> = {
  en: {
    eyebrow: 'Application Notes',
    title: 'Anonymized Engineering Cases',
    subtitle: 'Representative sealing programs showing how RubberQ evaluates compound fit, process control, and validation evidence before a production quote.',
    all: 'All Industries',
    ev: 'EV & Energy Storage',
    industrial: 'Industrial Equipment',
    semiconductor: 'Semiconductor',
    automotiveTier2: 'Automotive Tier 2',
    challenge: 'Challenge',
    response: 'RubberQ Response',
    evidence: 'Evidence To Verify',
    cta: 'Discuss Similar Project',
    review: 'Request Engineering Review',
    note: 'Customer names, drawings, and volumes are anonymized. Placeholder images remain until RubberQ-owned proof assets are added.',
    bottomTitle: 'Bring us the drawing, media, temperature window, and annual volume.',
    bottomSubtitle: 'We will tell you whether RubberQ is the right fit before pushing for a quote.',
  },
  zh: {
    eyebrow: '应用说明',
    title: '匿名工程案例',
    subtitle: '用代表性密封项目说明 RubberQ 如何先判断配方适配、过程控制与验证证据，再进入量产报价。',
    all: '全部行业',
    ev: 'EV 与储能',
    industrial: '工业设备',
    semiconductor: '半导体',
    automotiveTier2: '汽车 Tier 2',
    challenge: '项目挑战',
    response: 'RubberQ 处理方式',
    evidence: '待验证证据',
    cta: '沟通类似项目',
    review: '申请工程评估',
    note: '客户名称、图纸与数量均已匿名。图片保留为占位，待后续替换为 RubberQ 自有证据资产。',
    bottomTitle: '请先给我们图纸、介质、温度窗口和年用量。',
    bottomSubtitle: '在推动报价前，我们会先判断 RubberQ 是否适合这个项目。',
  },
  de: {
    eyebrow: 'Application Notes',
    title: 'Anonymisierte Engineering-Falle',
    subtitle: 'Reprasentative Dichtungsprogramme, die Compound-Fit, Prozesskontrolle und Validierungsnachweise vor dem Serienangebot zeigen.',
    all: 'Alle Branchen',
    ev: 'EV & Energiespeicher',
    industrial: 'Industrieausrustung',
    semiconductor: 'Halbleiter',
    automotiveTier2: 'Automotive Tier 2',
    challenge: 'Herausforderung',
    response: 'RubberQ Antwort',
    evidence: 'Nachweise',
    cta: 'Ahnliches Projekt besprechen',
    review: 'Engineering-Review anfragen',
    note: 'Kundennamen, Zeichnungen und Mengen sind anonymisiert. Bilder bleiben Platzhalter bis eigene RubberQ-Nachweise erganzt werden.',
    bottomTitle: 'Senden Sie Zeichnung, Medium, Temperaturfenster und Jahresvolumen.',
    bottomSubtitle: 'Wir sagen zuerst, ob RubberQ der richtige Partner ist, bevor wir ein Angebot erzwingen.',
  },
  ja: {
    eyebrow: 'Application Notes',
    title: '匿名エンジニアリング事例',
    subtitle: '量産見積の前に、配合適合性、工程管理、検証資料をどのように確認するかを示す代表事例です。',
    all: '全業界',
    ev: 'EV・蓄電',
    industrial: '産業機器',
    semiconductor: '半導体',
    automotiveTier2: '自動車 Tier 2',
    challenge: '課題',
    response: 'RubberQ の対応',
    evidence: '確認すべき証拠',
    cta: '類似案件を相談',
    review: '技術レビューを依頼',
    note: '顧客名、図面、数量は匿名化しています。画像は RubberQ 自社証拠素材の追加までプレースホルダーです。',
    bottomTitle: '図面、媒体、温度範囲、年間数量を共有してください。',
    bottomSubtitle: '見積を進める前に、RubberQ が適した案件かを先に判断します。',
  },
  es: {
    eyebrow: 'Application Notes',
    title: 'Casos de ingenieria anonimizados',
    subtitle: 'Programas representativos que muestran ajuste de compuesto, control de proceso y evidencia de validacion antes de cotizar produccion.',
    all: 'Todas las industrias',
    ev: 'EV y almacenamiento',
    industrial: 'Equipo industrial',
    semiconductor: 'Semiconductor',
    automotiveTier2: 'Automotriz Tier 2',
    challenge: 'Reto',
    response: 'Respuesta RubberQ',
    evidence: 'Evidencia a verificar',
    cta: 'Discutir proyecto similar',
    review: 'Solicitar revision tecnica',
    note: 'Nombres de clientes, planos y volumenes estan anonimizados. Las imagenes quedan como marcadores hasta agregar evidencia propia de RubberQ.',
    bottomTitle: 'Comparta plano, medio, temperatura y volumen anual.',
    bottomSubtitle: 'Primero diremos si RubberQ encaja antes de empujar una cotizacion.',
  },
};

const labels = labelsByLocale[locale] || labelsByLocale.en;

const cases = [
  {
    id: 'ev-thermal-interface',
    industry: 'ev',
    title: 'EV Thermal Interface Seal Compound Review',
    image: 'https://images.unsplash.com/photo-1593941707882-a5bba14938c7?auto=format&fit=crop&q=80&w=1200',
    challenge: 'A cooling interface required stable compression under glycol exposure, thermal cycling, and repeated assembly handling.',
    response: 'RubberQ reviewed EPDM, HNBR, and FKM options, then scoped compound testing around compression set, coolant swell, and dimensional repeatability before quoting tooling.',
    evidence: ['Compound shortlist with service-window rationale', 'Compression-set and coolant-swell validation plan', 'Batch traceability path for future repeat orders'],
  },
  {
    id: 'industrial-hydraulic-valve',
    industry: 'industrial',
    title: 'Hydraulic Valve Seal Migration From Commodity NBR',
    image: 'https://images.unsplash.com/photo-1581092160562-40aa08e78837?auto=format&fit=crop&q=80&w=1200',
    challenge: 'A valve program needed better oil aging and extrusion resistance without over-specifying a premium fluoroelastomer.',
    response: 'RubberQ compared NBR and HNBR formulations against the drawing groove, pressure window, and target maintenance interval.',
    evidence: ['Material recommendation tied to pressure and oil exposure', 'Pilot-run inspection plan', 'Incoming and final inspection record template'],
  },
  {
    id: 'semiconductor-ffkm-vacuum',
    industry: 'semiconductor',
    title: 'Semiconductor Vacuum Module FFKM Seal Path',
    image: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?auto=format&fit=crop&q=80&w=1200',
    challenge: 'A process-module interface required chemical resistance, low contamination risk, and lot-level traceability for maintenance planning.',
    response: 'RubberQ scoped an FFKM sealing package with low-outgassing compound selection, flash-control review, and clean-process handling requirements.',
    evidence: ['FFKM material path with contamination-control notes', 'Lot-level traceability requirement', 'Incoming verification and storage handling checklist'],
  },
  {
    id: 'automotive-tier2-cooling',
    industry: 'automotiveTier2',
    title: 'Automotive Tier 2 Cooling Module Seal Qualification',
    image: 'https://images.unsplash.com/photo-1617788138017-80ad40651399?auto=format&fit=crop&q=80&w=1200',
    challenge: 'A Tier 2 module supplier needed a repeatable elastomer part with quality-system evidence suitable for downstream customer review.',
    response: 'RubberQ aligned material choice, tooling review, dimensional control, and PPAP-oriented documentation under its IATF 16949 process system.',
    evidence: ['Drawing-based tolerance and inspection plan', 'PPAP-oriented documentation scope', 'Material batch and process traceability flow'],
  },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.caseStudies?.title || 'Case Studies'} | RubberQ</title>
    <meta name="description" content={meta.caseStudies?.description || labels.subtitle} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <section class="bg-industrial-900 text-white py-24 px-4">
      <div class="max-w-7xl mx-auto">
        <p class="text-accent-orange text-sm font-bold uppercase tracking-widest mb-4">{labels.eyebrow}</p>
        <h1 class="text-5xl md:text-6xl font-bold tracking-tighter mb-6 max-w-4xl">{labels.title}</h1>
        <p class="text-xl text-industrial-300 leading-relaxed max-w-3xl">{labels.subtitle}</p>
      </div>
    </section>

    <section class="py-8 border-b border-industrial-200 bg-industrial-50">
      <div class="max-w-7xl mx-auto px-4">
        <div class="flex flex-wrap gap-2 mb-4">
          <span class="px-4 py-2 text-sm font-bold uppercase tracking-wider border bg-industrial-900 text-white border-industrial-900">{labels.all} (4)</span>
          <span class="px-4 py-2 text-sm font-bold uppercase tracking-wider border bg-white text-industrial-700 border-industrial-200">{labels.ev} (1)</span>
          <span class="px-4 py-2 text-sm font-bold uppercase tracking-wider border bg-white text-industrial-700 border-industrial-200">{labels.industrial} (1)</span>
          <span class="px-4 py-2 text-sm font-bold uppercase tracking-wider border bg-white text-industrial-700 border-industrial-200">{labels.semiconductor} (1)</span>
          <span class="px-4 py-2 text-sm font-bold uppercase tracking-wider border bg-white text-industrial-700 border-industrial-200">{labels.automotiveTier2} (1)</span>
        </div>
        <p class="text-sm text-industrial-600">{labels.note}</p>
      </div>
    </section>

    <section class="py-20 px-4">
      <div class="max-w-7xl mx-auto space-y-16">
        {cases.map((item, index) => (
          <article class="grid grid-cols-1 lg:grid-cols-2 gap-10 items-center border-b border-industrial-100 pb-16 last:border-b-0 last:pb-0">
            <div class={`aspect-[4/3] overflow-hidden bg-industrial-100 ${index % 2 === 1 ? 'lg:order-2' : ''}`}>
              <img src={item.image} alt={item.title} class="w-full h-full object-cover" />
            </div>
            <div class={index % 2 === 1 ? 'lg:order-1' : ''}>
              <p class="text-accent-orange text-xs font-bold uppercase tracking-widest mb-3">{labels[item.industry]}</p>
              <h2 class="text-3xl font-bold text-industrial-900 tracking-tight mb-6">{item.title}</h2>
              <div class="space-y-5">
                <div class="bg-industrial-50 border-l-4 border-accent-orange p-5">
                  <h3 class="font-bold text-industrial-900 uppercase text-xs tracking-wider mb-2">{labels.challenge}</h3>
                  <p class="text-sm text-industrial-700 leading-relaxed">{item.challenge}</p>
                </div>
                <div class="bg-industrial-50 border-l-4 border-accent-orange p-5">
                  <h3 class="font-bold text-industrial-900 uppercase text-xs tracking-wider mb-2">{labels.response}</h3>
                  <p class="text-sm text-industrial-700 leading-relaxed">{item.response}</p>
                </div>
                <div class="bg-white border border-industrial-200 p-5">
                  <h3 class="font-bold text-industrial-900 uppercase text-xs tracking-wider mb-3">{labels.evidence}</h3>
                  <ul class="space-y-2">
                    {item.evidence.map((point) => (
                      <li class="text-sm text-industrial-700 flex items-start gap-2">
                        <span class="text-accent-orange font-bold mt-0.5">•</span>
                        {point}
                      </li>
                    ))}
                  </ul>
                </div>
              </div>
              <div class="flex flex-col sm:flex-row gap-3 mt-7">
                <a href={`/${locale}/contact`} class="inline-flex items-center justify-center bg-industrial-900 text-white px-6 py-3 font-bold text-xs uppercase tracking-widest hover:bg-accent-orange transition-colors">{labels.cta}</a>
                <a href={`/${locale}/batch-rfq`} class="inline-flex items-center justify-center border border-industrial-300 text-industrial-900 px-6 py-3 font-bold text-xs uppercase tracking-widest hover:border-accent-orange hover:text-accent-orange transition-colors">{labels.review}</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-industrial-900 text-white py-20 px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-bold tracking-tighter mb-5">{labels.bottomTitle}</h2>
        <p class="text-industrial-300 mb-8">{labels.bottomSubtitle}</p>
        <a href={`/${locale}/contact`} class="inline-flex items-center justify-center bg-accent-orange text-white px-8 py-4 font-bold text-sm uppercase tracking-widest hover:bg-white hover:text-industrial-900 transition-colors">
          {cs('cta.discussProject', 'Discuss Project')}
        </a>
      </div>
    </section>
  </div>
</LocaleLayout>
