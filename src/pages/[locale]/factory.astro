---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, localizedPath, t, tRaw } from '@/lib/i18n';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const f = (key: string, fallback = '') => t(messages, `factory.${key}`, fallback);
const fa = (key: string) => tRaw(messages, `factory.${key}`, []);

const facilityStats = [
  { number: '20,000', unit: 'm²', label: f('stats.totalFacilityArea') },
  { number: '1995', unit: '', label: f('stats.yearEstablished') },
  { number: '500+', unit: '', label: f('stats.teamMembers') },
  { number: '30%', unit: '', label: f('stats.greenCoverage') },
];

const productionLines = [
  {
    title: f('production.lines.mixing.title'), description: f('production.lines.mixing.description'),
    capabilities: fa('production.lines.mixing.capabilities') as string[],
    image: 'https://images.unsplash.com/photo-1565043666747-69f6646db940?auto=format&fit=crop&q=80&w=800',
  },
  {
    title: f('production.lines.preforming.title'), description: f('production.lines.preforming.description'),
    capabilities: fa('production.lines.preforming.capabilities') as string[],
    image: 'https://images.unsplash.com/photo-1537462715879-360eeb61a0ad?auto=format&fit=crop&q=80&w=800',
  },
  {
    title: f('production.lines.compression.title'), description: f('production.lines.compression.description'),
    capabilities: fa('production.lines.compression.capabilities') as string[],
    image: 'https://images.unsplash.com/photo-1623941007882-55259399cbd4?auto=format&fit=crop&q=80&w=800',
  },
  {
    title: f('production.lines.injection.title'), description: f('production.lines.injection.description'),
    capabilities: fa('production.lines.injection.capabilities') as string[],
    image: 'https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&q=80&w=800',
  },
];

const labEquipment = fa('lab.equipment') as string[];

const qualityProcesses = [
  { title: f('qualityProcess.steps.incoming.title'), description: f('qualityProcess.steps.incoming.description') },
  { title: f('qualityProcess.steps.inProcess.title'), description: f('qualityProcess.steps.inProcess.description') },
  { title: f('qualityProcess.steps.final.title'), description: f('qualityProcess.steps.final.description') },
  { title: f('qualityProcess.steps.shipment.title'), description: f('qualityProcess.steps.shipment.description') },
];

const certs = [
  { name: 'IATF 16949:2016', desc: f('certifications.iatf') },
  { name: 'ISO 9001:2015', desc: f('certifications.iso9001') },
  { name: 'ISO 14001:2015', desc: f('certifications.iso14001') },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.factory?.title || 'Factory'}</title>
    <meta name="description" content={meta.factory?.description || ''} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <!-- Hero -->
    <section class="relative bg-industrial-900 text-white py-24 overflow-hidden">
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-5"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-900 via-industrial-900/95 to-transparent z-10"></div>
      <div class="absolute right-0 top-0 w-1/2 h-full hidden lg:block">
        <img src="/images/legacy_resource/2021/03/17/60515a8bd1599.jpg" alt="Factory" class="w-full h-full object-cover opacity-45 grayscale contrast-110 brightness-90" />
      </div>
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20">
        <div class="max-w-2xl">
          <div class="inline-flex items-center gap-2 bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-4 py-1.5 text-xs font-bold tracking-widest uppercase mb-6">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
            {f('hero.location')}
          </div>
          <h1 class="text-5xl md:text-6xl font-bold tracking-tighter mb-6 leading-[0.95]">
            {f('hero.title')} <span class="text-industrial-500">{f('hero.titleHighlight')}</span>
          </h1>
          <p class="text-xl text-industrial-300 leading-relaxed mb-8">{f('hero.subtitle')}</p>
          <div class="flex flex-wrap gap-4">
            <a href={localizedPath(locale, `/contact`)} class="rq-pressable inline-flex items-center gap-2 bg-accent-orange text-white px-8 py-4 font-bold text-sm uppercase tracking-widest hover:bg-white hover:text-industrial-900">
              {f('hero.scheduleVisit')}
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
            <a href="#production" class="rq-pressable inline-flex items-center gap-2 border border-industrial-500 text-white px-8 py-4 font-bold text-sm uppercase tracking-widest hover:border-white">
              {f('hero.exploreCapabilities')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- Stats -->
    <section class="bg-white border-b border-industrial-200 py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
          {facilityStats.map((stat) => (
            <div class="text-center group">
              <div class="inline-flex items-center justify-center w-16 h-16 bg-industrial-100 mb-4 group-hover:bg-accent-orange/10 transition-colors">
                <svg class="w-8 h-8 text-industrial-600 group-hover:text-accent-orange transition-colors" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/></svg>
              </div>
              <div class="text-4xl font-bold text-industrial-900 tracking-tighter">
                {stat.number}<span class="text-2xl text-industrial-500">{stat.unit}</span>
              </div>
              <div class="text-xs font-bold uppercase tracking-widest text-industrial-500 mt-1">{stat.label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Location -->
    <section class="py-16 bg-industrial-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl font-bold tracking-tighter text-industrial-900 mb-6">
              {f('location.title')} <span class="text-industrial-500">{f('location.titleHighlight')}</span>
            </h2>
            <p class="text-industrial-600 leading-relaxed mb-6">{f('location.description')}</p>
            <div class="space-y-4">
              {[
                { label: f('location.airport'), desc: f('location.airportDesc') },
                { label: f('location.port'), desc: f('location.portDesc') },
                { label: f('location.rail'), desc: f('location.railDesc') },
              ].map((item) => (
                <div class="flex items-start gap-3">
                  <svg class="w-5 h-5 text-accent-orange flex-shrink-0 mt-0.5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  <div>
                    <span class="font-bold text-industrial-900">{item.label}</span>
                    <span class="text-industrial-600"> {item.desc}</span>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="aspect-video bg-industrial-200 relative overflow-hidden">
            <img src="https://images.unsplash.com/photo-1480714378408-67cf0d13bc1b?auto=format&fit=crop&q=80&w=800" alt="Fuzhou Location" class="w-full h-full object-cover" />
            <div class="absolute bottom-0 left-0 right-0 bg-industrial-900/90 text-white p-4">
              <p class="text-xs font-bold uppercase tracking-wider text-accent-orange mb-1">{f('location.facilityAddress')}</p>
              <p class="text-sm">{f('location.address')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Production -->
    <section id="production" class="py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-4">
            {f('production.title')} <span class="text-industrial-500">{f('production.titleHighlight')}</span>
          </h2>
          <p class="text-industrial-600 max-w-2xl mx-auto">{f('production.subtitle')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          {productionLines.map((line) => (
            <div class="group border border-industrial-200 hover:border-accent-orange transition-colors duration-200 bg-white rq-lift">
              <div class="aspect-[16/9] overflow-hidden bg-industrial-100">
                <img src={line.image} alt={line.title} class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-700" />
              </div>
              <div class="p-8">
                <h3 class="text-xl font-bold text-industrial-900 mb-3 group-hover:text-accent-orange transition-colors">{line.title}</h3>
                <p class="text-industrial-600 text-sm mb-6">{line.description}</p>
                <ul class="space-y-2">
                  {line.capabilities.map((cap) => (
                    <li class="flex items-start gap-2 text-sm text-industrial-700">
                      <span class="text-accent-orange font-bold mt-0.5">›</span>{cap}
                    </li>
                  ))}
                </ul>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Quality Lab -->
    <section class="bg-industrial-900 text-white py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-center">
          <div>
            <div class="inline-flex items-center gap-2 bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-4 py-1.5 text-xs font-bold tracking-widest uppercase mb-6">
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              {f('lab.badge')}
            </div>
            <h2 class="text-4xl font-bold tracking-tighter mb-6">
              {f('lab.title')} <span class="text-accent-orange">{f('lab.titleHighlight')}</span>
            </h2>
            <p class="text-industrial-300 text-lg leading-relaxed mb-8">{f('lab.description')}</p>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {labEquipment.map((item) => (
                <div class="flex items-center gap-3">
                  <svg class="w-4 h-4 text-accent-orange flex-shrink-0" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  <span class="text-sm text-industrial-300">{item}</span>
                </div>
              ))}
            </div>
          </div>
          <div class="grid grid-cols-2 gap-4">
            {[
              'https://images.unsplash.com/photo-1581093458791-9d42e3c7e117?auto=format&fit=crop&q=80&w=400',
              'https://images.unsplash.com/photo-1532094349884-543bc11b234d?auto=format&fit=crop&q=80&w=400',
              'https://images.unsplash.com/photo-1582719471384-894fbb16e074?auto=format&fit=crop&q=80&w=400',
              'https://images.unsplash.com/photo-1565514020126-6786cb4175bd?auto=format&fit=crop&q=80&w=400',
            ].map((src) => (
              <div class="aspect-square bg-industrial-800 overflow-hidden">
                <img src={src} alt="Lab" class="w-full h-full object-cover hover:scale-105 transition-transform duration-500" />
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- Quality Process -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-4">
            {f('qualityProcess.title')} <span class="text-industrial-500">{f('qualityProcess.titleHighlight')}</span>
          </h2>
          <p class="text-industrial-600 max-w-2xl mx-auto">{f('qualityProcess.subtitle')}</p>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {qualityProcesses.map((process, i) => (
            <div class="bg-industrial-50 p-8 h-full border border-industrial-200 border-t-4 border-t-accent-orange">
              <div class="text-5xl font-bold text-industrial-200 mb-4">0{i + 1}</div>
              <h3 class="text-lg font-bold text-industrial-900 mb-3">{process.title}</h3>
              <p class="text-sm text-industrial-600 leading-relaxed">{process.description}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Certifications -->
    <section class="bg-industrial-100 py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-2xl font-bold tracking-tighter text-industrial-900 mb-4">
            {f('certifications.title')} <span class="text-industrial-500">{f('certifications.titleHighlight')}</span>
          </h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {certs.map((cert) => (
            <div class="bg-white p-8 text-center border border-industrial-200 hover:border-accent-orange transition-colors">
              <svg class="w-12 h-12 text-accent-orange mx-auto mb-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="7"/><polyline points="8.21 13.89 7 23 12 20 17 23 15.79 13.88"/></svg>
              <h3 class="font-bold text-industrial-900 mb-2">{cert.name}</h3>
              <p class="text-sm text-industrial-600">{cert.desc}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CTA -->
    <section class="bg-industrial-900 text-white py-20">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-4xl font-bold tracking-tighter mb-6">
          {f('cta.title')} <span class="text-accent-orange">{f('cta.titleHighlight')}</span>
        </h2>
        <p class="text-industrial-300 text-lg mb-10 max-w-2xl mx-auto">{f('cta.description')}</p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href={localizedPath(locale, `/contact`)} class="rq-pressable inline-flex items-center gap-2 bg-accent-orange text-white px-8 py-4 font-bold text-sm uppercase tracking-widest hover:bg-white hover:text-industrial-900">
            {f('cta.scheduleTour')}
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
          </a>
          <a href={localizedPath(locale, `/quality`)} class="rq-pressable inline-flex items-center gap-2 border border-industrial-500 text-white px-8 py-4 font-bold text-sm uppercase tracking-widest hover:border-white">
            {f('cta.viewQuality')}
          </a>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
