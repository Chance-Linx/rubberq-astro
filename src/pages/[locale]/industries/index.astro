---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import { getTranslations, t } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';
import { createLocaleAlternates } from '@/lib/seoMetadata';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata?.industries || {};
const ix = (key: string, fallback = '') => t(messages, key, fallback);

const alternates = createLocaleAlternates(locale!, '/industries');
const orgSchema = createOrganizationSchema(locale!);

const sectors = [
  { slug: 'ev-energy-storage', i18nKey: 'ev', priority: 'critical', slotId: 'industries-index-ev' },
  { slug: 'industrial-equipment', i18nKey: 'industrial', priority: 'critical', slotId: 'industries-index-industrial' },
  { slug: 'semiconductor', i18nKey: 'semiconductor', priority: 'important', slotId: 'industries-index-semicon' },
  { slug: 'automotive-tier2', i18nKey: 'automotive', priority: 'important', slotId: 'industries-index-auto' },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.title || 'Industries We Serve | RubberQ'}</title>
    <meta name="description" content={meta.description || ''} />
    <link rel="canonical" href={alternates.canonical} />
    {Object.entries(alternates.languages).map(([lang, url]) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="bg-white">
    <!-- HERO -->
    <section class="bg-industrial-900 text-white py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-6 uppercase">
          {ix('industriesPage.index.hero.title', 'Industries We Serve')}
        </h1>
        <p class="text-xl text-industrial-200 max-w-3xl leading-relaxed">
          {ix('industriesPage.index.hero.subtitle')}
        </p>
      </div>
    </section>

    <!-- 4 SECTORS GRID -->
    <section class="py-20 bg-industrial-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid md:grid-cols-2 gap-8">
          {sectors.map((sector) => (
            <a
              href={`/${locale}/industries/${sector.slug}`}
              class="group bg-white border border-industrial-200 hover:border-accent-orange transition-colors overflow-hidden"
            >
              <div
                class="aspect-video bg-industrial-100 flex items-center justify-center"
                data-slot-id={sector.slotId}
                data-purpose={`${sector.i18nKey} 行业代表性图`}
                data-spec="1600x900"
                data-priority={sector.priority}
              >
                <span class="text-xs text-industrial-500">[{sector.slotId}]</span>
              </div>
              <div class="p-8">
                <div class="flex items-baseline gap-3 mb-3">
                  <span class="text-3xl">{ix(`industries.${sector.i18nKey}.icon`)}</span>
                  <h2 class="text-2xl font-bold tracking-tight text-industrial-900 uppercase">
                    {ix(`industries.${sector.i18nKey}.title`)}
                  </h2>
                </div>
                <p class="text-industrial-700 leading-relaxed mb-4">
                  {ix(`industries.${sector.i18nKey}.shortDesc`)}
                </p>
                <span class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest group-hover:underline">
                  Explore →
                </span>
              </div>
            </a>
          ))}
        </div>

        <p class="text-center text-industrial-700 mt-12 max-w-3xl mx-auto">
          {ix('industriesPage.index.notSeeing')}
          <a href={`/${locale}/contact`} class="text-accent-orange font-bold hover:underline ml-2">
            {ix('industriesPage.index.talkCta')} →
          </a>
        </p>
      </div>
    </section>
  </div>
</LocaleLayout>
