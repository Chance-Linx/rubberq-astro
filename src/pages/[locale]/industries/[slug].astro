---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import SectorIcon from '@/components/industries/SectorIcon.astro';
import { getTranslations, localizedPath, t, tRaw } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';

export function getStaticPaths() {
  const locales = ['en', 'de', 'ja', 'es', 'zh'];
  const slugs = ['semiconductor', 'humanoid-robotics', 'ai-data-center-cooling', 'ev-high-voltage'];
  return locales.flatMap((locale) => slugs.map((slug) => ({ params: { locale, slug } })));
}

const { locale = 'en', slug } = Astro.params;
const messages = await getTranslations(locale);

// Map slug → i18n key under industriesPage
const slugToKey: Record<string, string> = {
  'semiconductor': 'semiconductor',
  'humanoid-robotics': 'robotics',
  'ai-data-center-cooling': 'cooling',
  'ev-high-voltage': 'ev',
};
const slugToMetaKey: Record<string, string> = {
  'semiconductor': 'industriesSemiconductor',
  'humanoid-robotics': 'industriesIndustrial',
  'ai-data-center-cooling': 'industriesEv',
  'ev-high-voltage': 'industriesAutomotive',
};

const i18nKey = slugToKey[slug!] || 'semiconductor';
const metaKey = slugToMetaKey[slug!] || 'industriesSemiconductor';
const meta = messages?.metadata?.[metaKey] || {};
const ip = (key: string, fallback = '') => t(messages, `industriesPage.${i18nKey}.${key}`, fallback);
const pageLabels = {
  industries: t(messages, 'navigation.industries', 'Industries'),
  recommendedCompounds: t(messages, 'industriesPage.common.recommendedCompounds', 'Recommended compounds'),
};
const sectorImages: Record<string, string> = {
  semiconductor: '/images/visuals/semiconductor-cleanroom.jpg',
  robotics: '/images/visuals/humanoid-robotics-joint.jpg',
  cooling: '/images/visuals/ai-liquid-cooling.jpg',
  ev: '/images/visuals/ev-high-voltage.jpg',
};

const orgSchema = createOrganizationSchema(locale!);

// Sector-specific data extractors for new 4 High-Growth sectors
const subSectors = [
  { key: 'sub1', title: 'Primary Precision Application', compound: 'FFKM / FKM / HNBR' },
  { key: 'sub2', title: 'Secondary Performance Component', compound: 'Fluorosilicone / UL94 EPDM' },
  { key: 'sub3', title: 'Custom Subsystem Seal Assembly', compound: 'Rubber-to-Metal Vulcanized' },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.title || `${ip('hero.title', 'High-Growth Industry Precision Seals')} | RubberQ`}</title>
    <meta name="description" content={meta.description || ''} />
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="bg-white">
    <!-- 1. INDUSTRY HERO -->
    <section data-section-name="industry-hero" class="relative bg-industrial-900 text-white py-32 overflow-hidden">
      <div
        class="absolute inset-0 opacity-35 rq-media rq-media-soft"
        data-slot-id={`industries-${i18nKey}-hero`}
        data-purpose={`${i18nKey} 行业 Hero 背景`}
        data-spec="2560x1080"
        data-priority="critical"
      >
        <img src={sectorImages[i18nKey]} alt={ip('hero.title', 'Industry Precision Seals')} loading="eager" />
      </div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-10"></div>
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <a href={localizedPath(locale, `/industries`)} class="text-industrial-400 text-xs uppercase tracking-widest hover:text-white mb-6 inline-block">
          ← {pageLabels.industries}
        </a>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-6 leading-[1.05]">
          {ip('hero.title', 'Precision Elastomers & Seals for Advanced High-Growth Industry')}
        </h1>
        <p class="text-xl text-industrial-200 max-w-3xl leading-relaxed">
          {ip('hero.subtitle', 'Japanese Formulation Support & Chinese Precision Manufacturing Since 1995.')}
        </p>
      </div>
    </section>

    <!-- 2. ANSWER-FIRST SUMMARY (AI & Engineering Trust Box) -->
    <section data-section-name="answer-first-summary" class="py-10 bg-industrial-50 border-b border-industrial-200 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="bg-white border-l-4 border-accent-orange border border-industrial-200 p-6 md:p-8">
          <h2 class="text-xs font-mono font-bold uppercase tracking-[0.2em] text-accent-orange mb-2">
            AI & Buyer Engineering Executive Summary
          </h2>
          <p class="text-industrial-800 text-base md:text-lg leading-relaxed font-medium">
            RubberQ provides precision molded elastomer components, high-vacuum FFKM/FKM seals, rubber-to-metal vulcanized damping mounts, and UL94 V-0 flame-retardant EPDM gaskets specifically engineered for extreme operating environments. Manufactured across two ISO 9001 / IATF 16949 certified plant campuses in Fuzhou (20,000 m²), supported by 30 years of Japanese compounding experience, 100% automated optical inspection, and ERP batch traceability.
          </p>
        </div>
      </div>
    </section>

    <!-- 3. SUBSEGMENT SOLUTIONS MATRIX -->
    <section data-section-name="subsegment-solutions" class="py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-12">
          <h2 class="text-3xl font-bold tracking-tight text-industrial-900 mb-4">
            Sub-Application Matrix & Precision Elastomer Formulations
          </h2>
          <p class="text-industrial-600">
            Engineered elastomer solutions tailored for exact fluid, thermal, and mechanical stress requirements.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
          {subSectors.map((sub) => (
            <div class="bg-industrial-50 border border-industrial-200 p-8 flex flex-col justify-between">
              <div>
                <span class="text-xs font-mono font-bold uppercase tracking-widest text-accent-orange block mb-2">{sub.compound}</span>
                <h3 class="text-xl font-bold text-industrial-900 mb-4">{sub.title}</h3>
                <p class="text-industrial-600 text-sm leading-relaxed mb-6">
                  Formulated with A/B isolated mixing lines to ensure zero cross-contamination, precise hardness (40-90 Shore A), and low compression set.
                </p>
              </div>
              <div class="pt-4 border-t border-industrial-200 flex justify-between items-center text-xs font-mono text-industrial-700">
                <span>ISO 3601 Class A</span>
                <span class="font-bold">±0.05mm Tolerance</span>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- 4. MEDIA & OPERATING SPECIFICATIONS WINDOW -->
    <section data-section-name="media-resistance-specs" class="py-20 bg-industrial-900 text-white px-4">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-12">
          <h2 class="text-3xl font-bold tracking-tight mb-4">
            Operating Specifications & Media Resistance Window
          </h2>
          <p class="text-industrial-300">
            Tested in-house using physical rheometer, compression set, and chemical immersion test rigs.
          </p>
        </div>

        <div class="overflow-x-auto border border-industrial-700">
          <table class="w-full text-left text-sm text-industrial-200">
            <thead class="bg-industrial-800 text-xs font-mono uppercase text-industrial-300 border-b border-industrial-700">
              <tr>
                <th class="py-4 px-6">Elastomer Compound</th>
                <th class="py-4 px-6">Temperature Range</th>
                <th class="py-4 px-6">Primary Media Resistance</th>
                <th class="py-4 px-6">Key Engineering Feature</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-industrial-800">
              <tr class="hover:bg-industrial-800/50">
                <td class="py-4 px-6 font-bold text-white">FFKM Ultra-Vacuum</td>
                <td class="py-4 px-6">-15°C to +320°C</td>
                <td class="py-4 px-6">Fluorine/Oxy Plasma, Strong Acids</td>
                <td class="py-4 px-6">ASTM E595 Outgassing TML &lt; 0.20%</td>
              </tr>
              <tr class="hover:bg-industrial-800/50">
                <td class="py-4 px-6 font-bold text-white">FVMQ Fluorosilicone</td>
                <td class="py-4 px-6">-60°C to +230°C</td>
                <td class="py-4 px-6">Aviation Fuel, Ozone, Non-polar Oil</td>
                <td class="py-4 px-6">Low Fuel Permeation & High Flexibility</td>
              </tr>
              <tr class="hover:bg-industrial-800/50">
                <td class="py-4 px-6 font-bold text-white">Flame-Retardant EPDM</td>
                <td class="py-4 px-6">-45°C to +150°C</td>
                <td class="py-4 px-6">PGW Coolants, Water/Glycol, Electrolyte</td>
                <td class="py-4 px-6">UL94 V-0 Flame Retardant & Halogen Free</td>
              </tr>
              <tr class="hover:bg-industrial-800/50">
                <td class="py-4 px-6 font-bold text-white">High-Fatigue HNBR</td>
                <td class="py-4 px-6">-30°C to +160°C</td>
                <td class="py-4 px-6">Synthetic Esters, Biodegradable Oils</td>
                <td class="py-4 px-6">1,000,000+ Dynamic Flex Fatigue Life</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- 5. CLEANROOM & MANUFACTURING PROOF -->
    <section data-section-name="cleanroom-manufacturing-proof" class="py-20 bg-industrial-50 px-4">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
        <div>
          <span class="text-xs font-mono font-bold uppercase tracking-widest text-accent-orange mb-2 block">Factory Proof & ERP Traceability</span>
          <h2 class="text-3xl font-bold tracking-tight text-industrial-900 mb-6">
            ISO Class 5 Cleanroom & 100% Automated Optical Inspection
          </h2>
          <div class="space-y-4 text-industrial-700 leading-relaxed">
            <p>
              To meet zero-defect quality demands in semiconductor, robotics, and battery systems, RubberQ operates ISO Class 5 cleanroom cleaning and nitrogen-purged double packaging lines to prevent particulate contamination.
            </p>
            <p>
              Every high-precision molded O-ring and gasket undergoes 100% AI automated optical sorting (0.05 sec/part), detecting surface burrs, flash, and dimension variations down to ±0.03mm.
            </p>
          </div>
        </div>
        <div class="bg-white border border-industrial-200 p-8 shadow-sm">
          <h3 class="text-sm font-mono font-bold uppercase tracking-widest text-industrial-900 mb-4 pb-3 border-b border-industrial-200">
            IATF 16949 Batch Traceability Defense
          </h3>
          <ul class="space-y-3 text-sm text-industrial-700">
            <li class="flex items-start gap-3">
              <span class="text-accent-orange font-bold">✓</span>
              <span><strong>Raw Polymer Verification:</strong> CoA verification of raw FKM/FFKM/EPDM polymers before mixing.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-orange font-bold">✓</span>
              <span><strong>A/B Compounding Log:</strong> Automatic QR code batch tracking for kneader, strainer, and rheometer tests.</span>
            </li>
            <li class="flex items-start gap-3">
              <span class="text-accent-orange font-bold">✓</span>
              <span><strong>Full Production Record:</strong> Press mold number, vulcanization temperature/pressure, and QC inspector ID tied to final CoA.</span>
            </li>
          </ul>
        </div>
      </div>
    </section>

    <!-- 6. FAILURE PREVENTION & COMPARISON -->
    <section data-section-name="failure-prevention-comparison" class="py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="max-w-3xl mb-12">
          <h2 class="text-3xl font-bold tracking-tight text-industrial-900 mb-4">
            Common Elastomer Failure Modes vs RubberQ Engineered Fixes
          </h2>
          <p class="text-industrial-600">
            How custom Japanese compounding and isolation lines prevent field failures.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
          <div class="border border-industrial-300 bg-industrial-100/50 p-8">
            <h3 class="text-lg font-bold text-industrial-900 mb-4">Typical Field Failure Modes</h3>
            <ul class="space-y-3 text-sm text-industrial-700">
              <li>• Rapid Gas Decompression (RGD) cracking under high pressure fluctuations</li>
              <li>• High outgassing causing organic film contamination on optical/vacuum chambers</li>
              <li>• Rubber-to-metal bond delamination under dynamic vibration shear</li>
              <li>• Thermal runaway degradation in high-voltage pack enclosure seals</li>
            </ul>
          </div>
          <div class="border border-accent-orange/30 bg-industrial-50 p-8">
            <h3 class="text-lg font-bold text-industrial-900 mb-4 flex items-center gap-2">
              <span class="text-accent-orange">✓</span> RubberQ Precision Countermeasures
            </h3>
            <ul class="space-y-3 text-sm text-industrial-800">
              <li>• High-tensile AED FKM formulation compliant with ISO 23936 RGD standards</li>
              <li>• High-temp vacuum post-cure (230°C/24h) ensuring ASTM E595 TML &lt; 0.20%</li>
              <li>• Special primer heat vulcanization achieving 100% rubber tear bond strength</li>
              <li>• UL94 V-0 flame-retardant EPDM compound halting flame propagation</li>
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- 7. INDUSTRY CTA BANNER (Yakeclimate Parameterized) -->
    <section data-section-name="industry-cta" class="py-20 bg-industrial-900 text-white px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-3xl font-bold tracking-tight mb-4">
          Discuss Your High-Growth Project with RubberQ Engineers
        </h2>
        <p class="text-industrial-300 text-lg mb-8 max-w-2xl mx-auto">
          Submit 2D/3D STEP/DWG drawings or request custom compound samples for evaluation. 4-hour engineering response guaranteed.
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`${localizedPath(locale, '/contact')}?source_path=${encodeURIComponent(localizedPath(locale, `/industries/${slug}`))}&cta_id=${slug}-industry-action&cta_label=${encodeURIComponent('Request Custom Engineering Quote')}`}
            class="px-8 py-4 bg-accent-orange hover:bg-accent-orange-hover text-industrial-950 font-bold uppercase tracking-wider transition-colors inline-block"
          >
            Request Custom Engineering Quote
          </a>
          <a
            href={localizedPath(locale, '/materials')}
            class="px-8 py-4 bg-industrial-800 hover:bg-industrial-700 text-white font-bold uppercase tracking-wider transition-colors inline-block"
          >
            Browse Material Compounds
          </a>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
