---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { acquisitionCopy } from '@/lib/acquisition';
import { localizedPath, tRaw } from '@/lib/i18n';
import acquisitionPages from '@/data/acquisition-pages.json';
import { getAllBlogPosts, type BlogPost } from '@/lib/sanity';
import { pageSearchEntries, articleSearchEntries, searchEntries, paginate, discoveryUrl } from '@/lib/contentDiscovery';
import JsonLd from '@/components/JsonLd';
export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}
const { locale = 'en' } = Astro.params;
const data = (await acquisitionCopy(locale, '/search'))!;
const labels = tRaw(data.messages, 'search') as Record<string, string>;
const query = (Astro.url.searchParams.get('q') || '').trim();
const invalid = query.length > 160;
const path = localizedPath(locale, '/search');
const copies = tRaw(data.messages, 'acquisition.pages');
const pages = pageSearchEntries(acquisitionPages, copies, locale, labels.pageLabel);
const reviewPosts = (Astro.locals as { rubberqArticleReviewPosts?: BlogPost[] }).rubberqArticleReviewPosts;
const posts = query && !invalid ? (reviewPosts || await getAllBlogPosts()) : [];
const entries = [...pages, ...articleSearchEntries(posts, labels.articleLabel)];
const matches = invalid ? [] : searchEntries(entries, query);
const list = paginate(matches, Astro.url.searchParams.get('page'));
const urlFor = (page: number) => discoveryUrl(path, { query, page });
const resourcesUrl = localizedPath(locale, '/resources');
const contactUrl = localizedPath(locale, '/contact') + '?source=' + encodeURIComponent(path) + '&cta=site-search';
const schema = { '@context':'https://schema.org', '@type':'SearchResultsPage', name:data.copy.h1,
  url:'https://rubberq.com'+path, inLanguage:locale };
---
<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{data.copy.title}</title><meta name="description" content={data.copy.description} />
    <meta name="robots" content="noindex,follow" />
    <meta property="og:title" content={data.copy.title} /><meta property="og:description" content={data.copy.description} />
    <meta property="og:url" content={'https://rubberq.com'+path} /><meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" /><meta name="twitter:title" content={data.copy.title} />
    <meta name="twitter:description" content={data.copy.description} /><JsonLd data={schema} />
  </Fragment>
  <section class="bg-foreground text-background py-16 sm:py-24">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl md:text-5xl font-bold tracking-tight mb-6">{data.copy.h1}</h1>
      <p class="text-lg text-industrial-300 mb-8">{data.copy.intro}</p>
      <form method="get" action={path} role="search" class="flex flex-wrap sm:flex-nowrap gap-3">
        <label for="rq-site-query" class="sr-only">{labels.inputLabel}</label>
        <input id="rq-site-query" name="q" type="search" value={query} maxlength="160" placeholder={labels.placeholder}
          aria-describedby={invalid ? 'rq-search-error' : undefined} aria-invalid={invalid ? 'true' : undefined}
          class="flex-1 min-w-0 w-full sm:w-auto px-4 py-4 bg-background text-foreground border border-border focus-visible:outline-primary" />
        <button type="submit" class="px-6 py-4 bg-primary text-foreground font-bold">{labels.button}</button>
      </form>
      {invalid && <p id="rq-search-error" class="mt-4" role="alert">{labels.tooLong}</p>}
    </div>
  </section>
  <section class="py-16">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      {!query && <p class="text-muted">{labels.initial}</p>}
      {query && !invalid && <>
        <h2 class="text-xl font-bold mb-8" data-discovery-count>{labels.results.replace('{count}',String(list.total)).replace('{query}',query)}</h2>
        {list.total === 0 && <p class="text-muted" role="status">{labels.empty}</p>}
        <div class="space-y-6" data-search-results>
          {list.items.map(item => <article class="border border-border p-6 min-w-0">
            <p class="text-xs text-muted mb-2">{item.category}</p>
            <h3 class="text-lg font-bold mb-3 break-words"><a href={item.href} hreflang={item.href.startsWith('/blog/') ? 'en' : locale} class="underline underline-offset-4">{item.title}</a></h3>
            <p class="text-sm text-muted">{item.description}</p>
          </article>)}
        </div>
        {list.totalPages > 1 && <nav aria-label={labels.pagination} class="flex flex-wrap justify-between items-center gap-4 border-t border-border mt-10 pt-6">
          {list.page > 1 ? <a rel="prev" href={urlFor(list.page-1)} class="underline underline-offset-4">← {labels.previous}</a> : <span />}
          <span class="text-sm">{labels.pageCount.replace('{page}',String(list.page)).replace('{total}',String(list.totalPages))}</span>
          {list.page < list.totalPages ? <a rel="next" href={urlFor(list.page+1)} class="underline underline-offset-4">{labels.next} →</a> : <span />}
        </nav>}
      </>}
      <div class="flex flex-wrap gap-6 border-t border-border mt-12 pt-6">
        <a class="underline underline-offset-4" href={resourcesUrl}>{labels.resources}</a>
        <a class="underline underline-offset-4" href={contactUrl}>{labels.contact}</a>
      </div>
    </div>
  </section>
</LocaleLayout>
