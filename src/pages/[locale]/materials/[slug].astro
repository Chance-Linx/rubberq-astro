---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { localizedPath } from '@/lib/i18n';
import { MATERIAL_SLUGS, getMaterialData } from '@/lib/materials';

export function getStaticPaths() {
  const locales = ['en', 'de', 'ja', 'es', 'zh'];
  return locales.flatMap((locale) => MATERIAL_SLUGS.map((slug) => ({ params: { locale, slug } })));
}

const { locale = 'en', slug } = Astro.params;
const data = getMaterialData(slug);

if (!data) {
  return new Response(null, { status: 404 });
}

const labelsByLocale: Record<string, Record<string, string>> = {
  en: {
    back: 'Back to Materials',
    summary: 'Answer-First Summary',
    specs: 'Technical Specifications',
    fit: 'Good Fit',
    applications: 'Typical Application Windows',
    comparison: 'Selection Comparison',
    feature: 'Feature',
    ctaTitle: 'Need a compound assessment?',
    ctaDesc: 'Share the drawing, service media, temperature window, annual volume, and validation target. RubberQ will recommend the compound path before quoting tooling or production.',
    cta: 'Request Material Assessment',
  },
  zh: {
    back: '返回材料中心',
    summary: 'AI 可引用摘要',
    specs: '技术规格',
    fit: '适配场景',
    applications: '典型应用窗口',
    comparison: '选材对比',
    feature: '维度',
    ctaTitle: '需要配方建议？',
    ctaDesc: '请提供图纸、介质、温度窗口、年用量与验证目标。RubberQ 会先判断配方路径，再进入模具或量产报价。',
    cta: '提交材料需求',
  },
  de: {
    back: 'Zuruck zu Materialien',
    summary: 'Answer-First Zusammenfassung',
    specs: 'Technische Spezifikationen',
    fit: 'Gute Passung',
    applications: 'Typische Einsatzfenster',
    comparison: 'Auswahlvergleich',
    feature: 'Merkmal',
    ctaTitle: 'Compound-Einschatzung benotigt?',
    ctaDesc: 'Teilen Sie Zeichnung, Medium, Temperaturfenster, Jahresvolumen und Validierungsziel. RubberQ empfiehlt den Compound-Pfad vor Werkzeug- oder Serienangebot.',
    cta: 'Materialanfrage senden',
  },
  ja: {
    back: '材料一覧へ戻る',
    summary: '回答型サマリー',
    specs: '技術仕様',
    fit: '適合条件',
    applications: '主な適用領域',
    comparison: '材料比較',
    feature: '項目',
    ctaTitle: '配合提案が必要ですか？',
    ctaDesc: '図面、使用媒体、温度範囲、年間数量、検証目標を共有してください。RubberQ は金型や量産見積の前に配合方針を提案します。',
    cta: '材料条件を送る',
  },
  es: {
    back: 'Volver a materiales',
    summary: 'Resumen answer-first',
    specs: 'Especificaciones tecnicas',
    fit: 'Buen encaje',
    applications: 'Ventanas tipicas de aplicacion',
    comparison: 'Comparacion de seleccion',
    feature: 'Caracteristica',
    ctaTitle: 'Necesita una recomendacion de compuesto?',
    ctaDesc: 'Comparta plano, medio de servicio, temperatura, volumen anual y objetivo de validacion. RubberQ recomendara la ruta de compuesto antes de cotizar tooling o produccion.',
    cta: 'Enviar requisitos de material',
  },
};

const labels = labelsByLocale[locale] || labelsByLocale.en;

const jsonLd = JSON.stringify({
  '@context': 'https://schema.org/',
  '@type': 'Product',
  name: data.name,
  description: data.description,
  brand: { '@type': 'Brand', name: 'RubberQ' },
  additionalProperty: data.techData.map((prop) => ({
    '@type': 'PropertyValue',
    name: prop.name,
    value: prop.value,
  })),
});
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{data.name} Technical Guide | RubberQ</title>
    <meta name="description" content={data.description} />
    <script type="application/ld+json" set:html={jsonLd}></script>
  </Fragment>

  <div class="bg-white min-h-screen">
    <section class="bg-industrial-900 text-white py-20 px-4">
      <div class="max-w-7xl mx-auto">
        <a href={localizedPath(locale, `/materials`)} class="inline-flex items-center gap-2 text-industrial-300 hover:text-white transition-colors mb-8">
          <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
          {labels.back}
        </a>
        <div class="max-w-4xl">
          <p class="text-accent-orange text-sm font-bold uppercase tracking-widest mb-4">{data.shortName}</p>
          <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-6">{data.name}</h1>
          <p class="text-xl text-industrial-300 leading-relaxed">{data.description}</p>
        </div>
      </div>
    </section>

    <section class="py-16 px-4">
      <div class="max-w-7xl mx-auto grid grid-cols-1 lg:grid-cols-3 gap-10">
        <main class="lg:col-span-2 space-y-12">
          <section class="bg-industrial-50 border border-industrial-200 p-6">
            <h2 class="text-sm font-bold uppercase tracking-widest text-industrial-900 mb-4">{labels.summary}</h2>
            <ul class="space-y-3">
              {data.summaryItems.map((item) => (
                <li class="text-industrial-700 leading-relaxed">
                  <span class="font-bold text-industrial-900">{item.term}</span>: {item.description}
                </li>
              ))}
            </ul>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-industrial-900 tracking-tight mb-4">{labels.fit}</h2>
            <p class="text-industrial-700 leading-7 text-lg">{data.fit}</p>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-industrial-900 tracking-tight mb-5">{labels.applications}</h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
              {data.applications.map((application) => (
                <div class="border border-industrial-200 bg-white p-5">
                  <p class="text-sm font-bold text-industrial-900 leading-relaxed">{application}</p>
                </div>
              ))}
            </div>
          </section>

          <section>
            <h2 class="text-2xl font-bold text-industrial-900 tracking-tight mb-5">{labels.comparison}</h2>
            <div class="overflow-x-auto border border-industrial-200 bg-white">
              <table class="min-w-full divide-y divide-industrial-200">
                <thead class="bg-industrial-50">
                  <tr>
                    <th class="px-5 py-3 text-left text-sm font-bold text-industrial-900">{labels.feature}</th>
                    {data.comparisonMaterials.map((material) => (
                      <th class="px-5 py-3 text-left text-sm font-bold text-industrial-900">{material}</th>
                    ))}
                  </tr>
                </thead>
                <tbody class="divide-y divide-industrial-200">
                  {data.comparisonRows.map((row) => (
                    <tr>
                      <td class="px-5 py-4 text-sm font-bold text-industrial-900 bg-industrial-50">{row.feature}</td>
                      {row.values.map((value) => (
                        <td class="px-5 py-4 text-sm text-industrial-700">{value}</td>
                      ))}
                    </tr>
                  ))}
                </tbody>
              </table>
            </div>
          </section>
        </main>

        <aside class="space-y-8">
          <section class="border border-industrial-200">
            <div class="bg-industrial-900 text-white px-5 py-3 text-sm font-bold uppercase tracking-widest">{labels.specs}</div>
            <dl class="divide-y divide-industrial-200">
              {data.techData.map((prop) => (
                <div class="px-5 py-4">
                  <dt class="text-xs font-bold uppercase tracking-widest text-industrial-500 mb-1">{prop.name}</dt>
                  <dd class="text-sm text-industrial-900 font-medium">{prop.value}</dd>
                </div>
              ))}
            </dl>
          </section>

          <section class="bg-industrial-50 border border-industrial-200 p-6">
            <h2 class="text-xl font-bold text-industrial-900 mb-3">{labels.ctaTitle}</h2>
            <p class="text-sm text-industrial-700 leading-6 mb-6">{labels.ctaDesc}</p>
            <a href={localizedPath(locale, `/contact`)} class="inline-flex items-center justify-center w-full bg-industrial-900 text-white px-5 py-3 text-xs font-bold uppercase tracking-widest hover:bg-accent-orange transition-colors">
              {labels.cta}
            </a>
          </section>
        </aside>
      </div>
    </section>
  </div>
</LocaleLayout>
