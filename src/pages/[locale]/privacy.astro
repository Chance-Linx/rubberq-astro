---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, t } from '@/lib/i18n';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const _ = (key: string, fallback = '') => t(messages, `privacyPage.${key}`, fallback);
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.privacy?.title || 'Privacy Policy | RubberQ'}</title>
    <meta name="description" content={meta.privacy?.description || ''} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <!-- Header -->
    <section class="bg-industrial-900 text-white py-20 px-4">
      <div class="max-w-4xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 uppercase tracking-tight">{_('title')}</h1>
        <p class="text-industrial-400">{_('lastUpdated')}</p>
      </div>
    </section>

    <!-- Content -->
    <section class="py-16 px-4">
      <div class="max-w-4xl mx-auto prose prose-industrial max-w-none">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12 mb-16">
          <div class="p-6 bg-industrial-50 border border-industrial-100 rounded-lg">
            <svg class="w-8 h-8 text-accent-orange mb-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
            <h3 class="text-lg font-bold mb-2 uppercase">{_('cards.dataSecurity.title')}</h3>
            <p class="text-sm text-industrial-600">{_('cards.dataSecurity.description')}</p>
          </div>
          <div class="p-6 bg-industrial-50 border border-industrial-100 rounded-lg">
            <svg class="w-8 h-8 text-accent-orange mb-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
              <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
            </svg>
            <h3 class="text-lg font-bold mb-2 uppercase">{_('cards.zeroSharing.title')}</h3>
            <p class="text-sm text-industrial-600">{_('cards.zeroSharing.description')}</p>
          </div>
          <div class="p-6 bg-industrial-50 border border-industrial-100 rounded-lg">
            <svg class="w-8 h-8 text-accent-orange mb-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"/>
              <circle cx="12" cy="12" r="3"/>
            </svg>
            <h3 class="text-lg font-bold mb-2 uppercase">{_('cards.transparency.title')}</h3>
            <p class="text-sm text-industrial-600">{_('cards.transparency.description')}</p>
          </div>
        </div>

        <div class="space-y-12 text-industrial-800">
          <section>
            <h2 class="text-2xl font-bold border-b border-industrial-200 pb-2 mb-4 uppercase tracking-wide">{_('sections.informationCollect.title')}</h2>
            <p class="leading-relaxed mb-4">
              {_('sections.informationCollect.content')}
            </p>
            <ul class="list-disc pl-6 space-y-2">
              <li>{_('sections.informationCollect.items.0')}</li>
              <li>{_('sections.informationCollect.items.1')}</li>
              <li>{_('sections.informationCollect.items.2')}</li>
              <li>{_('sections.informationCollect.items.3')}</li>
            </ul>
            <p class="mt-4">{_('sections.informationCollect.additionalInfo')}</p>
          </section>

          <section>
            <h2 class="text-2xl font-bold border-b border-industrial-200 pb-2 mb-4 uppercase tracking-wide">{_('sections.howWeUse.title')}</h2>
            <p class="leading-relaxed mb-4">{_('sections.howWeUse.content')}</p>
            <ul class="list-disc pl-6 space-y-2">
              <li><strong>{_('sections.howWeUse.items.0.label')}</strong> {_('sections.howWeUse.items.0.text')}</li>
              <li><strong>{_('sections.howWeUse.items.1.label')}</strong> {_('sections.howWeUse.items.1.text')}</li>
              <li><strong>{_('sections.howWeUse.items.2.label')}</strong> {_('sections.howWeUse.items.2.text')}</li>
              <li><strong>{_('sections.howWeUse.items.3.label')}</strong> {_('sections.howWeUse.items.3.text')}</li>
            </ul>
          </section>

          <section>
            <h2 class="text-2xl font-bold border-b border-industrial-200 pb-2 mb-4 uppercase tracking-wide">{_('sections.intellectualProperty.title')}</h2>
            <p class="leading-relaxed">
              {_('sections.intellectualProperty.content')}
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold border-b border-industrial-200 pb-2 mb-4 uppercase tracking-wide">{_('sections.cookies.title')}</h2>
            <p class="leading-relaxed">
              {_('sections.cookies.content')}
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold border-b border-industrial-200 pb-2 mb-4 uppercase tracking-wide">{_('sections.dataRetention.title')}</h2>
            <p class="leading-relaxed">
              {_('sections.dataRetention.content')}
            </p>
          </section>

          <section>
            <h2 class="text-2xl font-bold border-b border-industrial-200 pb-2 mb-4 uppercase tracking-wide">{_('sections.yourRights.title')}</h2>
            <p class="leading-relaxed">
              {_('sections.yourRights.content')}
            </p>
          </section>

          <section class="bg-industrial-50 p-8 border border-industrial-200">
            <h2 class="text-xl font-bold mb-4 uppercase">{_('contact.title')}</h2>
            <p class="text-industrial-700">
              {_('contact.description')}<br /><br />
              <strong>{_('contact.company')}</strong><br />
              {_('contact.department')}<br />
              <!--email_off-->
              {_('contact.email')}<br />
              <!--/email_off-->
              {_('contact.address')}
            </p>
          </section>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
