---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, localizedPath, t, tRaw } from '@/lib/i18n';
import ContactForm from '@/components/contact/ContactForm';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const f = (key: string, fallback = '') => t(messages, `contact.${key}`, fallback);
const fa = (key: string) => tRaw(messages, `contact.${key}`, []);
const rfq = (key: string, fallback = '') => t(messages, `rfqV2.${key}`, fallback);

const formLabels = {
  name: f('form.name'),
  namePlaceholder: f('form.namePlaceholder'),
  email: f('form.email'),
  emailPlaceholder: f('form.emailPlaceholder'),
  company: f('form.company'),
  companyPlaceholder: f('form.companyPlaceholder'),
  industry: f('form.industry'),
  industryOptions: {
    ev: rfq('industryOptionsV2.ev'),
    industrial: rfq('industryOptionsV2.industrial'),
    semiconductor: rfq('industryOptionsV2.semiconductor'),
    automotiveTier2: rfq('industryOptionsV2.automotiveTier2'),
    other: f('form.industryOptions.other'),
  },
  projectType: {
    label: rfq('projectType.label'),
    options: tRaw(messages, 'rfqV2.projectType', {}),
  },
  annualVolume: {
    label: rfq('annualVolume.label'),
    options: tRaw(messages, 'rfqV2.annualVolume.options', {}),
  },
  quoteComponents: {
    label: rfq('quoteComponents.label'),
    options: tRaw(messages, 'rfqV2.quoteComponents', {}),
  },
  projectStage: {
    label: rfq('projectStage.label'),
    options: tRaw(messages, 'rfqV2.projectStage', {}),
  },
  message: f('form.message'),
  messagePlaceholder: f('form.messagePlaceholder'),
  fileLink: f('form.fileLink'),
  fileLinkPlaceholder: f('form.fileLinkPlaceholder'),
  fileLinkHelp: f('form.fileLinkHelp'),
  submit: f('form.submit'),
  submitting: f('form.submitting'),
  success: f('form.success'),
  successMessage: f('form.successMessage'),
  error: f('form.error'),
  errorMessage: f('form.errorMessage'),
};

const complianceItems = fa('enhancement.complianceItems') as string[];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.contact?.title || 'Dedicated Engineering Inquiry & Contact | RubberQ'}</title>
    <meta name="description" content={meta.contact?.description || ''} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <section data-section-name="contact-hero" class="bg-industrial-900 text-white py-24 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="inline-block bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-3 py-1 text-xs font-bold tracking-widest uppercase mb-4">
          TECHNICAL APPLICATIONS ENGINEERING DESK
        </div>
        <h1 class="text-4xl md:text-6xl font-bold mb-5 tracking-tighter uppercase max-w-4xl">{f('title')}</h1>
        <p class="text-industrial-300 max-w-2xl text-lg leading-relaxed">
          {f('subtitle')}
        </p>

        <!-- Dynamic Context Bar (Yakeclimate Source Parameter Resolution) -->
        <div id="source-context-bar" class="hidden mt-8 p-4 bg-industrial-800 border-l-4 border-accent-orange text-sm text-industrial-200">
          <span class="font-bold text-white uppercase tracking-wider">Context Attached:</span>
          Consulting from <span id="source-path-label" class="font-mono text-accent-orange"></span> (CTA: <span id="cta-label-text" class="text-white"></span>)
        </div>
      </div>
    </section>

    <section data-section-name="dynamic-rfq-form" class="py-20 px-4 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-16">
        {/* Contact Info & Trust Proofs */}
        <div class="lg:col-span-1 lg:sticky lg:top-28 self-start">
          <h2 class="text-2xl font-bold mb-8">{f('directContact')}</h2>
          <div class="space-y-8">
            <div class="flex items-start gap-4">
              <div class="bg-industrial-50 p-3 border border-industrial-200">
                <svg class="w-6 h-6 text-industrial-900" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="16" x="2" y="4" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
              </div>
              <div>
                <p class="font-bold">{f('engineeringSales')}</p>
                <!--email_off-->
                <a href="mailto:contact@rubberq.com" class="text-industrial-600 hover:text-industrial-900 font-mono font-bold">
                  contact@rubberq.com
                </a>
                <!--/email_off-->
                <p class="text-xs text-industrial-500 mt-1">Direct Engineering Mail (4h Response Guarantee)</p>
              </div>
            </div>
            <div class="flex items-start gap-4">
              <div class="bg-industrial-50 p-3 border border-industrial-200">
                <svg class="w-6 h-6 text-industrial-900" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"/><circle cx="12" cy="10" r="3"/></svg>
              </div>
              <div>
                <p class="font-bold">{f('manufacturingSite')}</p>
                <p class="text-industrial-600 text-sm leading-relaxed">{f('manufacturingAddress')}</p>
              </div>
            </div>

            <!-- CAD / STEP Drawing Instructions -->
            <div class="border border-industrial-200 p-6 bg-industrial-50">
              <h4 class="font-bold text-industrial-900 mb-2 flex items-center gap-2">
                <svg class="w-4 h-4 text-accent-orange" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7.5L14.5 2z"/><polyline points="14 2 14 8 20 8"/></svg>
                3D CAD Drawing & Specs
              </h4>
              <p class="text-sm text-industrial-700 mb-2">We support 3D STEP, DWG & PDF drawings for mold tool estimation and ISO 3601 Class A tolerance review.</p>
              <p class="text-xs font-mono text-industrial-500">Attach files or paste link in the form.</p>
            </div>

            <!-- NDA Confidentiality Guarantee -->
            <div class="bg-industrial-900 text-white p-6 border-t-4 border-accent-orange">
              <h4 class="font-bold mb-2 flex items-center gap-2">
                <svg class="w-4 h-4 text-accent-orange" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/></svg>
                {f('fastTrack')}
              </h4>
              <p class="text-sm text-industrial-300">
                {f('fastTrackDesc')}
              </p>
              <a
                href={localizedPath(locale, `/sample-request`)}
                class="inline-flex mt-4 text-sm font-bold uppercase tracking-wider text-accent-orange hover:text-white transition-colors"
              >
                Sample Request Form →
              </a>
            </div>

            <div class="border border-industrial-200 p-6 bg-white">
              <h4 class="font-bold text-industrial-900 mb-2">{f('enhancement.complianceTitle')}</h4>
              <p class="text-sm text-industrial-600 mb-3">{f('enhancement.complianceHint')}</p>
              <ul class="space-y-2">
                {complianceItems.map((item) => (
                  <li class="text-sm text-industrial-700 flex items-start gap-2">
                    <span class="text-accent-orange font-bold mt-0.5">•</span>
                    {item}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>

        {/* RFQ Form */}
        <ContactForm labels={formLabels} locale={locale} client:load />
      </div>
    </section>
  </div>
</LocaleLayout>

<script>
  // Parse URL parameters for Yakeclimate-style source tracking
  const urlParams = new URLSearchParams(window.location.search);
  const sourcePath = urlParams.get('source_path');
  const ctaLabel = urlParams.get('cta_label');

  if (sourcePath) {
    const bar = document.getElementById('source-context-bar');
    const pathLabel = document.getElementById('source-path-label');
    const labelText = document.getElementById('cta-label-text');
    if (bar && pathLabel && labelText) {
      pathLabel.textContent = sourcePath;
      labelText.textContent = ctaLabel || 'Engineering Action';
      bar.classList.remove('hidden');
    }
  }
</script>

