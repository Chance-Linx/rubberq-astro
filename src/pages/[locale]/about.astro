---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, t } from '@/lib/i18n';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const a = (key: string, fallback = '') => t(messages, `about.${key}`, fallback);

const factoryScenes = [
  {
    title: a('scenes.injection.title'),
    description: a('scenes.injection.desc'),
    img: "/images/legacy/workshop-1.webp",
    alt: "Injection molding factory floor"
  },
  {
    title: a('scenes.rnd.title'),
    description: a('scenes.rnd.desc'),
    img: "/images/legacy/rnd-1.webp",
    alt: "Rubber material testing lab"
  },
  {
    title: a('scenes.qc.title'),
    description: a('scenes.qc.desc'),
    img: "/images/legacy/workshop-2.webp",
    alt: "Quality inspection process"
  },
  {
    title: a('scenes.logistics.title'),
    description: a('scenes.logistics.desc'),
    img: "/images/legacy/workshop-3.webp",
    alt: "Factory warehouse and logistics"
  }
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.about?.title || 'About RubberQ | RubberQ'}</title>
    <meta name="description" content={meta.about?.description || ''} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <!-- Hero Section -->
    <section class="bg-industrial-900 text-white py-24 px-4">
      <div class="max-w-7xl mx-auto">
        <h1 class="text-4xl md:text-6xl font-bold mb-6">{a('title')}</h1>
        <p class="text-xl text-industrial-300 max-w-2xl">
          {a('subtitle')}
        </p>
      </div>
    </section>

    <!-- Corporate Video Section -->
    <section class="py-20 px-4 bg-industrial-50">
      <div class="max-w-7xl mx-auto">
        <div class="relative aspect-video bg-industrial-200 group cursor-pointer overflow-hidden rounded-lg shadow-2xl">
          <!-- Placeholder Image for Video -->
          <img
            src="/images/legacy/workshop-4.webp"
            alt="RubberQ Corporate Video Placeholder"
            width="1600"
            height="900"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            sizes="(max-width: 768px) 100vw, (max-width: 1200px) 100vw, 1200px"
          />
          <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
            <div class="text-center">
              <div class="w-20 h-20 bg-accent-orange rounded-full flex items-center justify-center mb-4 mx-auto shadow-lg group-hover:scale-110 transition-transform">
                <svg class="w-8 h-8 text-white fill-current" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24">
                  <path d="M8 5v14l11-7z"/>
                </svg>
              </div>
              <h3 class="text-2xl font-bold text-white uppercase tracking-widest">{a('watchVideo')}</h3>
              <p class="text-industrial-200 mt-2">{a('videoDuration')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- History & Stats -->
    <section class="py-20 px-4 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="text-3xl font-bold mb-6 italic">{a('heritageQuote')}</h2>
          <p class="text-lg text-industrial-600 mb-6">
            {a('heritageText1')}
          </p>
          <p class="text-lg text-industrial-600">
            {a('heritageText2')}
          </p>
        </div>
        <div class="grid grid-cols-2 gap-4">
          <div class="p-8 bg-industrial-50 border border-industrial-100 text-center">
            <span class="text-4xl font-bold text-industrial-900 block mb-2">30+</span>
            <span class="text-sm font-bold uppercase text-industrial-500">{a('stats.years')}</span>
          </div>
          <div class="p-8 bg-industrial-50 border border-industrial-100 text-center">
            <span class="text-4xl font-bold text-industrial-900 block mb-2">20k+</span>
            <span class="text-sm font-bold uppercase text-industrial-500">{a('stats.factory')}</span>
          </div>
          <div class="p-8 bg-industrial-50 border border-industrial-100 text-center">
            <span class="text-4xl font-bold text-industrial-900 block mb-2">IATF</span>
            <span class="text-sm font-bold uppercase text-industrial-500">{a('stats.certified')}</span>
          </div>
          <div class="p-8 bg-industrial-50 border border-industrial-100 text-center">
            <span class="text-4xl font-bold text-industrial-900 block mb-2">Top 5</span>
            <span class="text-sm font-bold uppercase text-industrial-500">{a('stats.partners')}</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Factory Scenes Gallery -->
    <section class="py-20 px-4 bg-white">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-3 mb-12">
          <svg class="w-8 h-8 text-industrial-900" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/>
            <circle cx="12" cy="13" r="4"/>
          </svg>
          <h2 class="text-3xl font-bold uppercase tracking-tight">{a('manufacturing')}</h2>
        </div>
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
          {factoryScenes.map((scene, idx) => (
            <div class="group border border-industrial-100 overflow-hidden bg-industrial-50">
              <div class="aspect-[4/3] overflow-hidden">
                <img
                  src={scene.img}
                  alt={scene.alt}
                  width="800"
                  height="600"
                  class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                  sizes="(max-width: 768px) 100vw, (max-width: 1024px) 50vw, 25vw"
                />
              </div>
              <div class="p-6">
                <h4 class="font-bold text-lg mb-2">{scene.title}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{scene.description}</p>
              </div>
            </div>
          ))}
        </div>
        <div class="mt-12 p-6 border-l-4 border-accent-orange bg-industrial-50 italic text-industrial-700">
          {a('imageNote')}
        </div>
      </div>
    </section>

    <!-- Core Values -->
    <section class="py-20 px-4 bg-industrial-900 text-white">
      <div class="max-w-7xl mx-auto text-center">
        <h2 class="text-3xl font-bold mb-12 uppercase tracking-widest">{a('coreValues')}</h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-12">
          <div>
            <svg class="w-12 h-12 mx-auto mb-6 text-accent-orange" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <circle cx="12" cy="12" r="6"/>
              <circle cx="12" cy="12" r="2"/>
            </svg>
            <h4 class="text-xl font-bold mb-4">{a('values.precision.title')}</h4>
            <p class="text-industrial-400">{a('values.precision.desc')}</p>
          </div>
          <div>
            <svg class="w-12 h-12 mx-auto mb-6 text-accent-orange" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
              <circle cx="9" cy="7" r="4"/>
              <path d="M23 21v-2a4 4 0 0 0-3-3.87"/>
              <path d="M16 3.13a4 4 0 0 1 0 7.75"/>
            </svg>
            <h4 class="text-xl font-bold mb-4">{a('values.partnership.title')}</h4>
            <p class="text-industrial-400">{a('values.partnership.desc')}</p>
          </div>
          <div>
            <svg class="w-12 h-12 mx-auto mb-6 text-accent-orange" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"/>
              <line x1="2" y1="12" x2="22" y2="12"/>
              <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>
            </svg>
            <h4 class="text-xl font-bold mb-4">{a('values.sustainability.title')}</h4>
            <p class="text-industrial-400">{a('values.sustainability.desc')}</p>
          </div>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
