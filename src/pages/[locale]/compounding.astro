---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import { getTranslations, t, tRaw } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata?.compounding || {};
const c = (key: string, fallback = '') => t(messages, `compounding.${key}`, fallback);

const labItems = tRaw(messages, 'compounding.labEquipment.items', []);
const stages = tRaw(messages, 'compounding.workflow.stages', []);
const libraryColumns = tRaw(messages, 'compounding.library.columns', []);
const libraryRows = tRaw(messages, 'compounding.library.rows', []);
const typicalItems = tRaw(messages, 'compounding.whyCompounding.typicalItems', []);
const rubberQItems = tRaw(messages, 'compounding.whyCompounding.rubberQItems', []);

const orgSchema = createOrganizationSchema(locale!);
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{meta.title || 'Compounding & R&D | RubberQ'}</title>
    <meta name="description" content={meta.description || ''} />
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="bg-white">
    <!-- ============================================================ -->
    <!-- HERO                                                          -->
    <!-- ============================================================ -->
    <section class="relative bg-industrial-900 text-white overflow-hidden">
      <!-- IMAGE/VIDEO PLACEHOLDER -->
      <div
        class="absolute inset-0 opacity-30"
        data-slot-id="compounding-hero-video"
        data-purpose="A 炼车间工作循环视频（最好有密炼机搅拌镜头）"
        data-spec="MP4 / WebM, ≤3MB, 10-15s loop, 无声"
        data-priority="critical"
      >
        <div class="w-full h-full bg-gradient-to-br from-industrial-800 to-industrial-900 flex items-center justify-center">
          <span class="text-industrial-600 text-xs uppercase tracking-widest">[VIDEO · compounding-hero-video] A 炼车间循环视频</span>
        </div>
      </div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-10"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-32 md:py-40">
        <div class="max-w-4xl">
          <div class="inline-block bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-3 py-1 text-xs font-bold tracking-widest uppercase mb-6">
            {c('hero.badge', 'OUR HIDDEN EDGE — 30 YEARS OF SINO-JAPANESE R&D')}
          </div>
          <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-6 leading-[1.05]">
            {c('hero.tagline', 'Compounded by Japan. Built in China. Tested in-House.')}
          </h1>
          <p class="text-xl text-industrial-200 max-w-3xl leading-relaxed mb-10">
            {c('hero.subtitle')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={`/${locale}/contact?type=application`}
              class="bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-widest hover:bg-white hover:text-industrial-900 transition-all duration-300 text-center"
            >
              {c('hero.ctaPrimary', 'DISCUSS YOUR APPLICATION')}
            </a>
            <a
              href="/downloads/compound-capability-sheet.pdf"
              class="border border-industrial-500 text-white px-8 py-4 font-bold text-sm tracking-widest hover:border-white transition-all duration-300 text-center"
            >
              {c('hero.ctaSecondary', 'DOWNLOAD CAPABILITY SHEET')}
            </a>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- WHY COMPOUNDING MATTERS                                       -->
    <!-- ============================================================ -->
    <section class="py-24 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-12 uppercase">
          {c('whyCompounding.title')}
        </h2>

        <div class="grid md:grid-cols-2 gap-10">
          <!-- Typical supplier (red) -->
          <div class="border-l-4 border-accent-orange pl-6 py-2">
            <p class="text-industrial-700 mb-4 font-medium">{c('whyCompounding.introTypical')}</p>
            <ul class="space-y-3">
              {typicalItems.map((item: string) => (
                <li class="flex gap-3 text-industrial-600 leading-relaxed">
                  <span class="text-accent-orange font-bold flex-shrink-0">✗</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- RubberQ (green) -->
          <div class="border-l-4 border-accent-orange pl-6 py-2">
            <p class="text-industrial-900 mb-4 font-medium">{c('whyCompounding.introRubberQ')}</p>
            <ul class="space-y-3">
              {rubberQItems.map((item: string) => (
                <li class="flex gap-3 text-industrial-700 leading-relaxed">
                  <span class="text-accent-orange font-bold flex-shrink-0">✓</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- A-MIXING LINE                                                  -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-12 uppercase">
          {c('aline.title')}
        </h2>

        <div class="grid lg:grid-cols-2 gap-12 mb-16">
          <!-- IMAGE PLACEHOLDER: A-line machine -->
          <div
            class="aspect-video bg-industrial-100 border-2 border-dashed border-industrial-300 flex flex-col items-center justify-center text-center p-6"
            data-slot-id="compounding-aline-machine"
            data-purpose="A-Mixing Line 板块：密炼机正面特写"
            data-spec="1600x900"
            data-priority="critical"
          >
            <span class="text-xs uppercase tracking-widest text-industrial-500 mb-2">PLACEHOLDER · compounding-aline-machine</span>
            <span class="text-sm text-industrial-700">密炼机正面特写</span>
            <span class="text-xs text-industrial-500 mt-2">1600x900 · critical</span>
          </div>

          <!-- Capacity facts -->
          <div class="flex flex-col justify-center">
            <ul class="space-y-4 text-lg">
              <li class="flex items-baseline gap-4">
                <span class="text-accent-orange text-2xl font-bold">▸</span>
                <span class="text-industrial-800">{c('aline.capacity')}</span>
              </li>
              <li class="flex items-baseline gap-4">
                <span class="text-accent-orange text-2xl font-bold">▸</span>
                <span class="text-industrial-800">{c('aline.mixer')}</span>
              </li>
              <li class="flex items-baseline gap-4">
                <span class="text-accent-orange text-2xl font-bold">▸</span>
                <span class="text-industrial-800">{c('aline.throughput')}</span>
              </li>
            </ul>
          </div>
        </div>

        <!-- 3 advantages -->
        <p class="text-lg text-industrial-700 mb-8">{c('aline.intro')}</p>
        <div class="grid md:grid-cols-3 gap-6">
          <div class="bg-white border border-industrial-200 p-8">
            <h3 class="text-lg font-bold text-industrial-900 mb-4 tracking-tight">{c('aline.adv1Title')}</h3>
            <p class="text-industrial-600 leading-relaxed">{c('aline.adv1Body')}</p>
          </div>
          <div class="bg-white border border-industrial-200 p-8">
            <h3 class="text-lg font-bold text-industrial-900 mb-4 tracking-tight">{c('aline.adv2Title')}</h3>
            <p class="text-industrial-600 leading-relaxed">{c('aline.adv2Body')}</p>
          </div>
          <div class="bg-white border border-industrial-200 p-8">
            <h3 class="text-lg font-bold text-industrial-900 mb-4 tracking-tight">{c('aline.adv3Title')}</h3>
            <p class="text-industrial-600 leading-relaxed">{c('aline.adv3Body')}</p>
          </div>
        </div>

        <!-- Secondary images: control + process -->
        <div class="grid md:grid-cols-2 gap-6 mt-12">
          <div
            class="aspect-video bg-industrial-100 border-2 border-dashed border-industrial-300 flex flex-col items-center justify-center text-center p-6"
            data-slot-id="compounding-aline-control"
            data-purpose="A-Mixing Line：控制面板/称重系统特写"
            data-spec="1600x900"
            data-priority="important"
          >
            <span class="text-xs uppercase tracking-widest text-industrial-500 mb-2">PLACEHOLDER · compounding-aline-control</span>
            <span class="text-sm text-industrial-700">控制面板/称重系统</span>
          </div>
          <div
            class="aspect-video bg-industrial-100 border-2 border-dashed border-industrial-300 flex flex-col items-center justify-center text-center p-6"
            data-slot-id="compounding-aline-process"
            data-purpose="A-Mixing Line：原料投放或排料场景"
            data-spec="1600x900"
            data-priority="important"
          >
            <span class="text-xs uppercase tracking-widest text-industrial-500 mb-2">PLACEHOLDER · compounding-aline-process</span>
            <span class="text-sm text-industrial-700">原料投放/排料场景</span>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- LAB EQUIPMENT GRID                                            -->
    <!-- ============================================================ -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-12 uppercase">
          {c('labEquipment.title')}
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-3 gap-6">
          {labItems.map((item: { name: string; desc: string }, idx: number) => {
            const slotIds = ['compounding-lab-rheometer','compounding-lab-tensile','compounding-lab-aging','compounding-lab-compset','compounding-lab-oilbath','compounding-lab-mooney'];
            return (
              <div class="bg-industrial-50 border border-industrial-200 overflow-hidden group hover:border-accent-orange transition-colors">
                <div
                  class="aspect-square bg-industrial-100 border-b border-dashed border-industrial-300 flex flex-col items-center justify-center text-center p-4"
                  data-slot-id={slotIds[idx] || `compounding-lab-${idx}`}
                  data-purpose={`Lab Equipment 网格：${item.name}`}
                  data-spec="800x600"
                  data-priority="important"
                >
                  <span class="text-[10px] uppercase tracking-widest text-industrial-400 mb-1">PLACEHOLDER</span>
                  <span class="text-xs text-industrial-600">{item.name} 设备图</span>
                </div>
                <div class="p-5">
                  <h3 class="font-bold text-industrial-900 mb-1 uppercase text-sm tracking-tight">{item.name}</h3>
                  <p class="text-sm text-industrial-600">{item.desc}</p>
                </div>
              </div>
            );
          })}
        </div>

        <div class="mt-10 text-center">
          <a
            href={`/${locale}/testing`}
            class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest hover:underline"
          >
            {c('labEquipment.fullLink')} →
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- 5-STAGE WORKFLOW                                              -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-900 text-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter mb-12 uppercase">
          {c('workflow.title')}
        </h2>

        <div class="space-y-8">
          {stages.map((stage: any) => (
            <div class="border-l-2 border-accent-orange pl-6 md:pl-8 py-4">
              <div class="flex flex-wrap items-baseline gap-4 mb-3">
                <span class="text-accent-orange text-sm font-bold uppercase tracking-widest">{stage.stage}</span>
                <h3 class="text-xl md:text-2xl font-bold tracking-tight">{stage.name}</h3>
                <span class="text-industrial-400 text-sm">→ {stage.timeline}</span>
              </div>
              <p class="text-industrial-300 max-w-3xl leading-relaxed">{stage.desc}</p>
            </div>
          ))}
        </div>

        <p class="text-industrial-400 text-sm mt-10 max-w-3xl">
          <strong class="text-white">{c('workflow.totalNote')}</strong>
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- COMPOUND LIBRARY TABLE                                        -->
    <!-- ============================================================ -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-6 uppercase">
          {c('library.title')}
        </h2>
        <p class="text-lg text-industrial-700 mb-10 max-w-4xl leading-relaxed">
          {c('library.intro')}
        </p>

        <div class="overflow-x-auto border border-industrial-200">
          <table class="w-full">
            <thead class="bg-industrial-900 text-white">
              <tr>
                {libraryColumns.map((col: string) => (
                  <th class="text-left text-xs uppercase tracking-widest font-bold px-4 py-3">{col}</th>
                ))}
              </tr>
            </thead>
            <tbody>
              {libraryRows.map((row: any, idx: number) => (
                <tr class={idx % 2 === 0 ? 'bg-white' : 'bg-industrial-50'}>
                  <td class="px-4 py-3 font-bold text-industrial-900">{row.family}</td>
                  <td class="px-4 py-3 text-industrial-700">{row.apps}</td>
                  <td class="px-4 py-3 text-industrial-700 font-mono text-sm">{row.temp}</td>
                  <td class="px-4 py-3 text-industrial-700">{row.key}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        <div class="mt-8 flex flex-wrap items-center justify-between gap-4">
          <p class="text-industrial-700 max-w-2xl">{c('library.outro')}</p>
          <a
            href={`/${locale}/contact?type=application`}
            class="bg-industrial-900 text-white px-6 py-3 font-bold text-sm tracking-widest uppercase hover:bg-accent-orange transition-colors"
          >
            {c('library.cta')} →
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- HONEST BOUNDARIES                                             -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-50">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-6 uppercase">
          {c('boundaries.title')}
        </h2>
        <p class="text-lg text-industrial-700 mb-10">{c('boundaries.intro')}</p>

        <div class="space-y-4">
          <div class="bg-white border-l-4 border-accent-orange p-6">
            <div class="flex items-baseline gap-3 mb-2">
              <span class="text-accent-orange text-xl">✅</span>
              <h3 class="text-lg font-bold text-industrial-900">{c('boundaries.fast.label')}</h3>
            </div>
            <p class="text-industrial-700 pl-9">{c('boundaries.fast.desc')}</p>
          </div>
          <div class="bg-white border-l-4 border-accent-orange p-6">
            <div class="flex items-baseline gap-3 mb-2">
              <span class="text-accent-orange text-xl">✅</span>
              <h3 class="text-lg font-bold text-industrial-900">{c('boundaries.standard.label')}</h3>
            </div>
            <p class="text-industrial-700 pl-9">{c('boundaries.standard.desc')}</p>
          </div>
          <div class="bg-white border-l-4 border-accent-orange p-6">
            <div class="flex items-baseline gap-3 mb-2">
              <span class="text-accent-orange text-xl">⚠</span>
              <h3 class="text-lg font-bold text-industrial-900">{c('boundaries.ndaDependent.label')}</h3>
            </div>
            <p class="text-industrial-700 pl-9">{c('boundaries.ndaDependent.desc')}</p>
          </div>
        </div>

        <div class="mt-10 bg-industrial-900 text-white p-6 border-l-4 border-accent-orange">
          <p class="font-medium leading-relaxed">{c('boundaries.redLine')}</p>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- VIDEO: Process Promotional                                    -->
    <!-- ============================================================ -->
    <section class="py-24 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div
          class="aspect-video bg-industrial-100 border-2 border-dashed border-industrial-300 flex flex-col items-center justify-center text-center p-6"
          data-slot-id="compounding-video-process"
          data-purpose="工艺宣传片嵌入式视频"
          data-spec="MP4，1-3 分钟，工艺流程展示"
          data-priority="critical"
        >
          <span class="text-xs uppercase tracking-widest text-industrial-500 mb-2">VIDEO PLACEHOLDER · compounding-video-process</span>
          <span class="text-lg text-industrial-700 mb-1">工艺宣传片</span>
          <span class="text-sm text-industrial-500">用户已有素材 · 1-3 分钟</span>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FINAL CTA                                                     -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-900 text-white">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-5xl font-bold tracking-tighter mb-6 uppercase">
          {c('finalCta.title')}
        </h2>
        <p class="text-lg text-industrial-300 mb-10 max-w-3xl mx-auto leading-relaxed">
          {c('finalCta.subtitle')}
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a
            href={`/${locale}/contact?type=application`}
            class="bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-widest uppercase hover:bg-white hover:text-industrial-900 transition-all duration-300"
          >
            {c('finalCta.ctaPrimary')}
          </a>
          <a
            href={`/${locale}/contact?type=datasheet`}
            class="border border-industrial-500 text-white px-8 py-4 font-bold text-sm tracking-widest uppercase hover:border-white transition-all duration-300"
          >
            {c('finalCta.ctaSecondary')}
          </a>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
