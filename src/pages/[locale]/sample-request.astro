---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, t } from '@/lib/i18n';
import SampleRequestForm from '@/components/contact/SampleRequestForm.tsx';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);

const labelsByLocale: Record<string, Record<string,string>> = {
  en: { title:'Sample Request', subtitle:'Submit your sample and prototyping requirements. Our team responds within 24-48 hours.', step1:'Share application and target part type', step2:'Upload drawing link or reference model', step3:'Confirm quantity and destination country', name:'Name *', email:'Email *', company:'Company', productType:'Product Type', material:'Preferred Material (FKM/NBR/EPDM...)', quantity:'Sample Quantity', country:'Destination Country *', notes:'Application Notes', drawingLink:'Drawing/File Link (Drive/Dropbox)', submit:'Submit Sample Request', submitting:'Submitting...', success:'Request Submitted', successMessage:'Your sample request was received. Engineering sales will contact you shortly.', error:'Submission Failed', errorMessage:'Please retry or email contact@rubberq.com directly.' },
  zh: { title:'样品申请', subtitle:'提交样品与打样需求，我们将在 24-48 小时内回复。', step1:'填写应用场景与目标零件类型', step2:'提供图纸链接或参考模型', step3:'确认样品数量与收货国家', name:'姓名 *', email:'邮箱 *', company:'公司', productType:'产品类型', material:'目标材料 (FKM/NBR/EPDM...)', quantity:'样品数量', country:'收货国家 *', notes:'应用说明', drawingLink:'图纸/文件链接 (网盘链接)', submit:'提交样品申请', submitting:'提交中...', success:'提交成功', successMessage:'已收到您的样品申请，工程销售将尽快联系您。', error:'提交失败', errorMessage:'请重试或直接发送邮件至 contact@rubberq.com。' },
  de: { title:'Musteranfrage', subtitle:'Senden Sie Ihre Anforderungen fur Muster und Prototyping. Antwort in 24-48 Stunden.', step1:'Anwendung und Zielbauteil angeben', step2:'Zeichnungslink oder Referenzmodell teilen', step3:'Menge und Zielland bestatigen', name:'Name *', email:'E-Mail *', company:'Unternehmen', productType:'Produkttyp', material:'Bevorzugtes Material (FKM/NBR/EPDM...)', quantity:'Mustermenge', country:'Zielland *', notes:'Anwendungsnotizen', drawingLink:'Zeichnungs-/Dateilink', submit:'Musteranfrage senden', submitting:'Wird gesendet...', success:'Anfrage gesendet', successMessage:'Ihre Musteranfrage wurde empfangen. Unser Team meldet sich zeitnah.', error:'Senden fehlgeschlagen', errorMessage:'Bitte erneut versuchen oder an contact@rubberq.com schreiben.' },
  ja: { title:'サンプル依頼', subtitle:'サンプル・試作要件を送信してください。24-48時間以内に返信します。', step1:'用途と部品タイプを入力', step2:'図面リンクまたは参照モデルを共有', step3:'数量と配送先国を確認', name:'お名前 *', email:'メール *', company:'会社名', productType:'製品タイプ', material:'希望材質 (FKM/NBR/EPDM...)', quantity:'サンプル数量', country:'配送先国 *', notes:'用途メモ', drawingLink:'図面/ファイルリンク', submit:'サンプル依頼を送信', submitting:'送信中...', success:'送信完了', successMessage:'サンプル依頼を受け付けました。担当者より連絡します。', error:'送信失敗', errorMessage:'再試行するか contact@rubberq.com へご連絡ください。' },
  es: { title:'Solicitud de Muestras', subtitle:'Envia su requerimiento de muestras y prototipos. Respuesta en 24-48 horas.', step1:'Describa aplicacion y tipo de pieza', step2:'Comparta enlace de plano o modelo', step3:'Confirme cantidad y pais de destino', name:'Nombre *', email:'Correo *', company:'Empresa', productType:'Tipo de producto', material:'Material preferido (FKM/NBR/EPDM...)', quantity:'Cantidad de muestras', country:'Pais de destino *', notes:'Notas de aplicacion', drawingLink:'Enlace de plano/archivo', submit:'Enviar solicitud', submitting:'Enviando...', success:'Solicitud enviada', successMessage:'Su solicitud fue recibida. Nuestro equipo se pondra en contacto pronto.', error:'Error al enviar', errorMessage:'Intente nuevamente o escriba a contact@rubberq.com.' },
};
const L = labelsByLocale[locale] || labelsByLocale.en;
const ct = (key: string, fallback = '') => t(messages, `contact.${key}`, fallback);
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{L.title} | RubberQ</title>
    <meta name="description" content={L.subtitle} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <section class="bg-industrial-900 text-white py-20 px-4">
      <div class="max-w-6xl mx-auto">
        <h1 class="text-4xl md:text-5xl font-bold mb-4 tracking-tight">{L.title}</h1>
        <p class="text-industrial-300 text-lg max-w-3xl">{L.subtitle}</p>
      </div>
    </section>

    <section class="max-w-6xl mx-auto px-4 py-14 grid grid-cols-1 lg:grid-cols-3 gap-8">
      <div class="space-y-4">
        <div class="border border-industrial-200 p-5 bg-industrial-50">
          <div class="flex items-center gap-2 mb-2 text-accent-orange">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6v5l4 8H5l4-8V3z"/><path d="M9 3v5"/></svg>
            <span class="text-xs font-bold uppercase tracking-wider">Step 1</span>
          </div>
          <p class="text-sm text-industrial-700">{L.step1}</p>
        </div>
        <div class="border border-industrial-200 p-5 bg-industrial-50">
          <div class="flex items-center gap-2 mb-2 text-accent-orange">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/><line x1="12" y1="22.08" x2="12" y2="12"/></svg>
            <span class="text-xs font-bold uppercase tracking-wider">Step 2</span>
          </div>
          <p class="text-sm text-industrial-700">{L.step2}</p>
        </div>
        <div class="border border-industrial-200 p-5 bg-industrial-50">
          <div class="flex items-center gap-2 mb-2 text-accent-orange">
            <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"/><rect x="8" y="2" width="8" height="4" rx="1" ry="1"/></svg>
            <span class="text-xs font-bold uppercase tracking-wider">Step 3</span>
          </div>
          <p class="text-sm text-industrial-700">{L.step3}</p>
        </div>
        <div class="bg-industrial-100 p-5 border-l-4 border-accent-orange text-sm text-industrial-700">
          {ct('fastTrackDesc')}
        </div>
      </div>
      <div class="lg:col-span-2">
        <SampleRequestForm client:load labels={L} />
      </div>
    </section>
  </div>
</LocaleLayout>
