---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import { getTranslations, t } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';
import { createLocaleAlternates } from '@/lib/seoMetadata';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const mp = (key: string, fallback = '') => t(messages, `materialsPage.${key}`, fallback);

const alternates = createLocaleAlternates(locale!, '/materials');
const orgSchema = createOrganizationSchema(locale!);

// v2 — 9 polymer families ordered by industry priority (EV first)
const materials = [
  { slug: 'hnbr', priority: '⚡ EV / Auto', name: mp('materials.hnbr.name'), desc: mp('materials.hnbr.desc') },
  { slug: 'fkm', priority: '🔬 Chem / Semicon', name: mp('materials.fkm.name'), desc: mp('materials.fkm.desc') },
  { slug: 'ffkm', priority: '🔬 Semicon Flagship', name: mp('materials.ffkm.name'), desc: mp('materials.ffkm.desc') },
  { slug: 'epdm', priority: '⚡ EV / Outdoor', name: mp('materials.epdm.name'), desc: mp('materials.epdm.desc') },
  { slug: 'nbr', priority: '⚙ Industrial / Oil', name: mp('materials.nbr.name'), desc: mp('materials.nbr.desc') },
  { slug: 'acm', priority: '🚗 Auto Transmission', name: mp('materials.acm.name'), desc: mp('materials.acm.desc') },
  { slug: 'aem', priority: '🚗 Auto Heat Ducts', name: mp('materials.aem.name'), desc: mp('materials.aem.desc') },
  { slug: 'silicone', priority: '⚙ Industrial / Wide Temp', name: mp('materials.silicone.name'), desc: mp('materials.silicone.desc') },
  { slug: 'lsr', priority: '⚙ Precision Overmolding', name: mp('materials.lsr.name'), desc: mp('materials.lsr.desc') },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{t(messages, 'metadata.materials.title')}</title>
    <meta name="description" content={t(messages, 'metadata.materials.description')} />
    <link rel="canonical" href={alternates.canonical} />
    {Object.entries(alternates.languages).map(([lang, url]) => (
      <link rel="alternate" hreflang={lang} href={url} />
    ))}
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <!-- ============================================================ -->
    <!-- HERO                                                          -->
    <!-- ============================================================ -->
    <section class="relative bg-industrial-900 text-white py-24 overflow-hidden">
      <div
        class="absolute inset-0 opacity-25"
        data-slot-id="materials-hero-bg"
        data-purpose="胶料样品阵列 / 不同硬度色卡"
        data-spec="1920x1080"
        data-priority="important"
      >
        <div class="w-full h-full bg-gradient-to-br from-industrial-800 to-industrial-900"></div>
      </div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-10"></div>

      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center gap-2 mb-4 text-accent-orange">
          <span class="font-bold tracking-widest uppercase text-xs">{mp('hero.badge')}</span>
        </div>
        <h1 class="text-4xl md:text-6xl font-bold tracking-tighter mb-6 leading-[1.05]">{mp('hero.title')}</h1>
        <p class="text-xl text-industrial-200 max-w-3xl leading-relaxed">
          {mp('hero.subtitle')}
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CROSS-LINK TO COMPOUNDING                                     -->
    <!-- ============================================================ -->
    <div class="bg-industrial-100 border-l-4 border-accent-orange py-4 px-4">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm text-industrial-700">
          💡 {mp('crossLink.prompt')}
          <a href={`/${locale}/compounding`} class="text-accent-orange font-bold hover:underline ml-1">
            {mp('crossLink.guide')} →
          </a>
        </p>
      </div>
    </div>

    <!-- ============================================================ -->
    <!-- MATERIALS GRID — 9 polymer families                            -->
    <!-- ============================================================ -->
    <section class="py-20 px-4 max-w-7xl mx-auto">
      <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 mb-4 uppercase">Polymer Families We Compound In-House</h2>
      <p class="text-industrial-700 mb-12 max-w-3xl">Ordered by current sector priority. Each family is available in multiple proprietary formulations developed over 30 years of Sino-Japanese collaboration.</p>

      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-20">
        {materials.map((m) => (
          <a href={`/${locale}/materials/${m.slug}`} class="block p-8 border border-industrial-100 hover:border-accent-orange transition-all group bg-white">
            <div class="text-xs uppercase tracking-widest text-industrial-500 mb-3">{m.priority}</div>
            <h3 class="text-xl font-bold mb-3 text-industrial-900 tracking-tight">{m.name}</h3>
            <p class="text-sm text-industrial-600 leading-relaxed mb-6 min-h-[5rem]">{m.desc}</p>
            <span class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-xs tracking-widest group-hover:gap-3 transition-all">
              {mp('technicalSpecifications', 'Technical Specifications')} →
            </span>
          </a>
        ))}
      </div>

      <!-- ============================================================ -->
      <!-- COMPARISON MATRIX (kept for the 4 most common)                -->
      <!-- ============================================================ -->
      <div class="border-t border-industrial-100 pt-20">
        <h2 class="text-3xl font-bold mb-4 uppercase tracking-tighter text-center">{mp('matrix.title')}</h2>
        <p class="text-center text-industrial-600 mb-12 max-w-2xl mx-auto">Quick comparison across our four most-specified families. Detailed cards above for HNBR, FFKM, ACM, AEM, LSR.</p>
        <div class="overflow-x-auto border border-industrial-700 bg-white">
          <table class="min-w-full divide-y divide-industrial-200">
            <thead>
              <tr>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-industrial-100">{mp('matrix.property')}</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-gray-50">FKM</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-gray-50">EPDM</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-gray-50">NBR</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider bg-gray-50">Silicone (HCR)</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-industrial-200">
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.tempRange')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">-20 to +200</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">-50 to +150</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">-40 to +120</td>
                <td class="px-6 py-4 text-sm text-industrial-600">-60 to +230</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.oilResistance')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.superior')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.poor')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.excellent')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600">{mp('matrix.fair')}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.chemicalResistance')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.excellent')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.good')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.fair')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600">{mp('matrix.good')}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.durabilityIndex')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.high')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.high')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.medium')}</td>
                <td class="px-6 py-4 text-sm text-industrial-600">{mp('matrix.medium')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CUSTOM COMPOUND LIBRARY ENTRY                                 -->
    <!-- ============================================================ -->
    <section class="py-20 bg-industrial-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter mb-6 uppercase">
          Need a Property Combination Not Listed?
        </h2>
        <p class="text-lg text-industrial-300 mb-10 max-w-3xl mx-auto leading-relaxed">
          That's exactly what we develop. From custom-formulated HNBR for EV thermal management to NDA-backed FFKM for next-gen plasma chambers — we own the compound chemistry, not just the molding.
        </p>
        <a
          href={`/${locale}/compounding`}
          class="inline-block bg-accent-orange text-white px-10 py-5 font-bold tracking-widest uppercase text-sm hover:bg-white hover:text-industrial-900 transition-all duration-300"
        >
          Explore Compounding & R&D →
        </a>
      </div>
    </section>
  </div>
</LocaleLayout>
