---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import { getTranslations, t } from '@/lib/i18n';

export function getStaticPaths() {
  return ['en','de','ja','es','zh'].map(locale => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const mp = (key: string, fallback = '') => t(messages, `materialsPage.${key}`, fallback);

const materials = [
  { name: mp('materials.fkm.name'), slug: 'fkm', desc: mp('materials.fkm.desc') },
  { name: mp('materials.epdm.name'), slug: 'epdm', desc: mp('materials.epdm.desc') },
  { name: mp('materials.nbr.name'), slug: 'nbr', desc: mp('materials.nbr.desc') },
  { name: mp('materials.silicone.name'), slug: 'silicone', desc: mp('materials.silicone.desc') },
];
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{t(messages, 'metadata.materials.title')}</title>
    <meta name="description" content={t(messages, 'metadata.materials.description')} />
  </Fragment>

  <div class="bg-white min-h-screen">
    <!-- Hero -->
    <section class="bg-industrial-50 py-24 px-4">
      <div class="max-w-7xl mx-auto">
        <div class="flex items-center gap-2 mb-4 text-industrial-600">
          <svg class="w-5 h-5" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="12 2 2 7 12 12 22 7 12 2"/><polyline points="2 17 12 22 22 17"/><polyline points="2 12 12 17 22 12"/></svg>
          <span class="font-bold tracking-widest uppercase text-sm">{mp('hero.badge')}</span>
        </div>
        <h1 class="text-4xl md:text-5xl font-bold mb-6">{mp('hero.title')}</h1>
        <p class="text-xl text-industrial-500 max-w-2xl">
          {mp('hero.subtitle')}
        </p>
      </div>
    </section>

    <!-- Cross-link to Resources -->
    <div class="bg-industrial-100 border-l-4 border-accent-orange py-4 px-4">
      <div class="max-w-7xl mx-auto">
        <p class="text-sm text-industrial-700">
          💡 {mp('crossLink.prompt')}
          <a href={`/${locale}/resources`} class="text-accent-orange font-medium hover:underline ml-1">
            {mp('crossLink.guide')}
          </a>
          {mp('crossLink.suffix')}
        </p>
      </div>
    </div>

    <!-- Materials Grid -->
    <section class="py-20 px-4 max-w-7xl mx-auto">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mb-20">
        {materials.map((m) => (
          <div class="p-10 border border-industrial-100 hover:border-industrial-900 transition-all group">
            <h3 class="text-2xl font-bold mb-4">{m.name}</h3>
            <p class="text-industrial-500 mb-8">{m.desc}</p>
            <a href={`/${locale}/materials/${m.slug}`} class="flex items-center gap-2 font-bold text-industrial-900 group-hover:gap-4 transition-all">
              {mp('technicalSpecifications')}
              <svg class="w-4 h-4" xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg>
            </a>
          </div>
        ))}
      </div>

      <!-- Comparison Matrix -->
      <div class="border-t border-industrial-100 pt-20">
        <h2 class="text-3xl font-bold mb-12 text-center uppercase tracking-tighter">{mp('matrix.title')}</h2>
        <div class="overflow-x-auto border border-industrial-700 rounded-lg shadow-sm bg-white">
          <table class="min-w-full divide-y divide-industrial-200">
            <thead class="bg-gray-50">
              <tr>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-industrial-100">{mp('matrix.property')}</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-gray-50">FKM</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-gray-50">EPDM</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider border-r border-industrial-200 bg-gray-50">NBR</th>
                <th class="px-6 py-3 text-left text-sm font-bold text-industrial-900 tracking-wider bg-gray-50">Silicone</th>
              </tr>
            </thead>
            <tbody class="bg-white divide-y divide-industrial-200">
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.tempRange')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">-20 to +250</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">-50 to +150</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">-30 to +120</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600">-60 to +230</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.oilResistance')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.superior')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.poor')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.excellent')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600">{mp('matrix.fair')}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.chemicalResistance')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.excellent')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.good')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.fair')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600">{mp('matrix.good')}</td>
              </tr>
              <tr class="hover:bg-gray-50 transition-colors">
                <td class="px-6 py-4 whitespace-nowrap text-sm font-bold text-industrial-900 bg-industrial-100 border-r border-industrial-200">{mp('matrix.durabilityIndex')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.high')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.high')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600 border-r border-industrial-200">{mp('matrix.medium')}</td>
                <td class="px-6 py-4 whitespace-nowrap text-sm text-industrial-600">{mp('matrix.medium')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
