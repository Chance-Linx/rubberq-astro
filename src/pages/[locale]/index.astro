---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import TrustSignals from '@/components/TrustSignals.astro';
import { getTranslations, t, tRaw } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const homeMeta = meta?.home || {};
const h = (key: string, fallback = '') => t(messages, key, fallback);

const summaryItems = tRaw(messages, 'features.summaryItems', []);
const fitItems = tRaw(messages, 'goodFit.fitItems', []);
const notFitItems = tRaw(messages, 'goodFit.notFitItems', []);
const trustBadges = tRaw(messages, 'hero.trustBadges', ['IATF 16949', 'ISO 9001', 'ISO 14001']);

const orgSchema = createOrganizationSchema(locale!);
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{homeMeta.title || 'RubberQ | Japanese Formulation. Chinese Precision. Trusted Since 1995.'}</title>
    <meta name="description" content={homeMeta.description || meta.description || ''} />
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="flex flex-col">
    <!-- ============================================================ -->
    <!-- HERO                                                          -->
    <!-- ============================================================ -->
    <section class="relative min-h-[92vh] flex items-center bg-industrial-900 overflow-hidden">
      <!-- Hero background placeholder -->
      <div
        class="absolute inset-0 opacity-45"
        data-slot-id="home-hero-bg"
        data-purpose="全屏工厂车间 / A 炼车间 / 生产线大场景，客户进入网站第一眼就看到真实制造环境"
        data-spec="2400x1400 横向大图，主体留在画面右侧或中景，左侧预留深色文字区"
        data-priority="critical"
      >
        <div class="w-full h-full bg-gradient-to-br from-industrial-700 via-industrial-800 to-industrial-950"></div>
      </div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-900 via-industrial-900/80 to-transparent z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
        <div class="max-w-3xl">
          <div class="inline-block bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-3 py-1 text-xs font-bold tracking-widest uppercase mb-6">
            {h('hero.badge', 'JAPANESE FORMULATION × CHINESE PRECISION × SINCE 1995')}
          </div>
          <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-white mb-6 leading-[0.95]">
            {h('hero.titleLine1', 'PRECISION')}<br />
            <span class="text-industrial-500">{h('hero.titleLine2', 'IN EVERY')}</span><br />
            {h('hero.titleLine3', 'MOLECULE.')}
          </h1>
          <p class="text-xl md:text-2xl text-accent-orange font-bold tracking-tight mb-4 italic">
            "{h('hero.tagline', 'Japanese Formulation. Chinese Precision. Trusted Since 1995.')}"
          </p>
          <p class="text-lg text-industrial-100 mb-8 max-w-2xl leading-relaxed">
            {h('hero.subtitle')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href={`/${locale}/contact`}
              class="bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-widest hover:bg-white hover:text-industrial-900 transition-all duration-300 text-center uppercase"
            >
              {h('hero.ctaPrimary', 'REQUEST QUOTE')}
            </a>
            <a
              href={`/${locale}/compounding`}
              class="border border-industrial-500 text-white px-8 py-4 font-bold text-sm tracking-widest hover:border-white transition-all duration-300 text-center uppercase"
            >
              {h('hero.ctaSecondary', 'EXPLORE OUR R&D')}
            </a>
          </div>
          <div class="flex flex-wrap gap-3 items-center">
            {trustBadges.map((badge: string) => (
              <span class="text-industrial-400 text-xs font-mono tracking-widest border border-industrial-700 px-3 py-1.5">{badge}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FEATURES — large proof scene + compact technical summary         -->
    <!-- ============================================================ -->
    <section class="bg-white">
      <div class="grid lg:grid-cols-12 min-h-[720px]">
        <div
          class="relative lg:col-span-7 min-h-[520px] bg-industrial-900 overflow-hidden"
          data-slot-id="home-proof-manufacturing-scene"
          data-purpose="真实制造能力大场景：密炼/成型/检验其中一个强场景，替代原来四张小图卡片"
          data-spec="1800x1400 竖横皆可，画面要有设备纵深和人员/工件尺度"
          data-priority="critical"
        >
          <div class="absolute inset-0 bg-gradient-to-br from-industrial-700 via-industrial-800 to-industrial-950"></div>
          <div class="absolute inset-0 bg-industrial-900/30"></div>
          <div class="absolute left-6 bottom-6 right-6 border border-white/20 bg-industrial-900/70 p-5 text-white md:left-10 md:bottom-10 md:right-auto md:w-[360px]">
            <p class="text-sm leading-relaxed text-industrial-200">[home-proof-manufacturing-scene / 1800x1400]</p>
          </div>
        </div>

        <div class="lg:col-span-5 px-4 sm:px-8 lg:px-12 py-16 lg:py-20 flex items-center">
          <div class="max-w-xl">
            <h2 class="text-4xl md:text-5xl font-bold tracking-tighter text-industrial-900 uppercase mb-8 leading-[0.98]">
              {h('features.title', 'WHY GLOBAL ENGINEERING TEAMS CHOOSE RUBBERQ')}
            </h2>

            <div class="border-t-4 border-accent-orange bg-industrial-50 p-6 mb-10">
              <h3 class="text-sm font-bold text-industrial-900 mb-5 uppercase tracking-[0.18em]">
                {h('features.summaryTitle', 'QUICK TECHNICAL SUMMARY')}
              </h3>
              <ul class="space-y-4">
                {summaryItems.map((item: any) => (
                  <li class="border-b border-industrial-200 pb-4 last:border-b-0 last:pb-0">
                    <strong class="text-industrial-900 block mb-1 text-sm uppercase tracking-tight">{item.term}</strong>
                    <span class="text-sm text-industrial-700 leading-relaxed">{item.description}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-8">
              <div>
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.2em] mb-3">01</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.jpRd.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.jpRd.desc')}</p>
              </div>
              <div>
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.2em] mb-3">02</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.compounding.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.compounding.desc')}</p>
              </div>
              <div>
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.2em] mb-3">03</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.lab.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.lab.desc')}</p>
              </div>
              <div>
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.2em] mb-3">04</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.heritage.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.heritage.desc')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- IS MY PROJECT A GOOD FIT?                                     -->
    <!-- ============================================================ -->
    <section class="py-20 bg-white border-y border-industrial-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 items-start">
          <div class="lg:col-span-4 lg:sticky lg:top-28">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 uppercase mb-5 leading-tight">
              {h('goodFit.title')}
            </h2>
            <p class="text-lg text-industrial-700 leading-relaxed">{h('goodFit.subtitle')}</p>
            <a
              href={`/${locale}/contact`}
              class="inline-flex mt-8 bg-industrial-900 text-white px-7 py-4 font-bold text-sm tracking-widest uppercase hover:bg-accent-orange transition-colors"
            >
              {h('goodFit.cta')} →
            </a>
          </div>

          <div class="lg:col-span-8 grid md:grid-cols-2 gap-10">
            <div class="border-l-4 border-accent-orange pl-6">
              <h3 class="text-xl font-bold text-industrial-900 uppercase tracking-tight mb-6">{h('goodFit.fitTitle')}</h3>
              <ul class="space-y-5">
                {fitItems.map((item: string) => (
                  <li class="flex gap-4 text-industrial-700 leading-relaxed">
                    <span class="mt-2 h-px w-6 bg-accent-orange flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="border-l border-industrial-300 pl-6">
              <h3 class="text-xl font-bold text-industrial-900 uppercase tracking-tight mb-6">{h('goodFit.notFitTitle')}</h3>
              <ul class="space-y-5">
                {notFitItems.map((item: string) => (
                  <li class="flex gap-4 text-industrial-700 leading-relaxed">
                    <span class="mt-2 h-px w-6 bg-industrial-400 flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CAPACITY RE-FRAMING                                            -->
    <!-- ============================================================ -->
    <section class="relative min-h-[540px] bg-industrial-900 text-white overflow-hidden flex items-center">
      <div
        class="absolute inset-0 opacity-55"
        data-slot-id="home-capacity-line-bg"
        data-purpose="A 炼线 / 密炼 / 连续生产线宽幅场景，用来说明 RubberQ 产能结构和稳定供货"
        data-spec="2200x1200 横向宽幅，最好有设备纵深和批量生产语境"
        data-priority="critical"
      >
        <div class="w-full h-full bg-gradient-to-r from-industrial-950 via-industrial-800 to-industrial-700"></div>
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-950 via-industrial-900/85 to-industrial-900/25"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20">
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-5xl font-bold tracking-tighter uppercase mb-6 leading-tight">
            {h('capacityReframing.title')}
          </h2>
          <p class="text-lg md:text-xl text-industrial-100 leading-relaxed mb-8">
            {h('capacityReframing.body')}
          </p>
          <a
            href={`/${locale}/compounding`}
            class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest hover:underline"
          >
            {h('capacityReframing.learnMore')} →
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TRUST SIGNALS                                                  -->
    <!-- ============================================================ -->
    <TrustSignals locale={locale} />

    <!-- ============================================================ -->
    <!-- INDUSTRIES — v2: EV / Industrial / Semicon / Auto Tier 2       -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-8 items-end mb-12">
          <h2 class="lg:col-span-5 text-3xl md:text-5xl font-bold tracking-tighter text-industrial-900 uppercase leading-tight">
            {h('industries.title', 'Specialized Industries We Serve')}
          </h2>
          <p class="lg:col-span-7 text-lg text-industrial-700 leading-relaxed">
            {h('industries.subtitle')}
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-5">
          <!-- EV -->
          <a href={`/${locale}/industries/ev-energy-storage`} class="group relative min-h-[540px] overflow-hidden border border-industrial-200 lg:col-span-2 bg-industrial-900">
            <div
              class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
              data-slot-id="home-industries-ev"
              data-purpose="EV/储能相关密封件应用场景或成品大图，作为首页行业主入口"
              data-spec="1600x1200 或 2200x1200，主视觉级别"
              data-priority="critical"
            >
              <span class="absolute top-6 right-6 text-[10px] uppercase tracking-widest text-industrial-500">home-industries-ev</span>
            </div>
            <div class="absolute inset-0 bg-industrial-900/45 group-hover:bg-industrial-900/60 transition-colors"></div>
            <div class="absolute bottom-8 left-8 right-8 text-white md:bottom-10 md:left-10 md:right-10">
              <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.24em] mb-4">01</div>
              <h3 class="text-3xl md:text-5xl font-bold uppercase tracking-tighter mb-4 max-w-xl">{h('industries.ev.title')}</h3>
              <p class="text-base md:text-lg text-industrial-100 leading-relaxed max-w-xl">{h('industries.ev.shortDesc')}</p>
              <div class="w-10 h-1 bg-accent-orange mt-4 transition-all duration-300 group-hover:w-full"></div>
            </div>
          </a>

          <div class="grid gap-5">
            <!-- Industrial -->
            <a href={`/${locale}/industries/industrial-equipment`} class="group relative min-h-[166px] overflow-hidden border border-industrial-200 bg-industrial-900">
              <div
                class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
                data-slot-id="home-industries-industrial"
                data-purpose="液压/泵阀/工业设备密封件场景"
                data-spec="900x520"
                data-priority="important"
              >
                <span class="absolute top-4 right-4 text-[10px] uppercase tracking-widest text-industrial-500">home-industries-industrial</span>
              </div>
              <div class="absolute inset-0 bg-industrial-900/55 group-hover:bg-industrial-900/72 transition-colors"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white">
                <h3 class="text-xl font-bold uppercase tracking-tight mb-2">{h('industries.industrial.title')}</h3>
                <p class="text-sm text-industrial-200 leading-snug">{h('industries.industrial.shortDesc')}</p>
              </div>
            </a>

            <!-- Semicon -->
            <a href={`/${locale}/industries/semiconductor`} class="group relative min-h-[166px] overflow-hidden border border-industrial-200 bg-industrial-900">
              <div
                class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
                data-slot-id="home-industries-semicon"
                data-purpose="FFKM 制品特写或洁净工艺场景"
                data-spec="900x520"
                data-priority="important"
              >
                <span class="absolute top-4 right-4 text-[10px] uppercase tracking-widest text-industrial-500">home-industries-semicon</span>
              </div>
              <div class="absolute inset-0 bg-industrial-900/55 group-hover:bg-industrial-900/72 transition-colors"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white">
                <h3 class="text-xl font-bold uppercase tracking-tight mb-2">{h('industries.semiconductor.title')}</h3>
                <p class="text-sm text-industrial-200 leading-snug">{h('industries.semiconductor.shortDesc')}</p>
              </div>
            </a>

            <!-- Auto Tier 2 -->
            <a href={`/${locale}/industries/automotive-tier2`} class="group relative min-h-[166px] overflow-hidden border border-industrial-200 bg-industrial-900">
              <div
                class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
                data-slot-id="home-industries-auto"
                data-purpose="汽车 Tier 2 橡胶件成品或装配场景"
                data-spec="900x520"
                data-priority="important"
              >
                <span class="absolute top-4 right-4 text-[10px] uppercase tracking-widest text-industrial-500">home-industries-auto</span>
              </div>
              <div class="absolute inset-0 bg-industrial-900/55 group-hover:bg-industrial-900/72 transition-colors"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white">
                <h3 class="text-xl font-bold uppercase tracking-tight mb-2">{h('industries.automotive.title')}</h3>
                <p class="text-sm text-industrial-200 leading-snug">{h('industries.automotive.shortDesc')}</p>
              </div>
            </a>
          </div>
        </div>

        <p class="text-center text-industrial-600 mt-10 text-sm">
          {h('industries.notSeeing')}
          <a href={`/${locale}/contact`} class="text-accent-orange font-bold hover:underline ml-2">
            {h('industries.talkCta')} →
          </a>
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- COMPOUNDING & R&D ENTRY                                       -->
    <!-- ============================================================ -->
    <section class="relative min-h-[640px] bg-industrial-950 text-white overflow-hidden flex items-end">
      <div
        class="absolute inset-0 opacity-60"
        data-slot-id="home-compounding-entry"
        data-purpose="A 炼车间或配方实验室代表性大图，作为配方研发入口的沉浸式背景"
        data-spec="2200x1400 横向或宽幅，画面要能承载深色蒙版文字"
        data-priority="critical"
      >
        <div class="w-full h-full bg-gradient-to-br from-industrial-700 via-industrial-900 to-industrial-950"></div>
      </div>
      <div class="absolute inset-0 bg-gradient-to-t from-industrial-950 via-industrial-950/75 to-industrial-900/15"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20">
        <div class="max-w-3xl">
          <h2 class="text-4xl md:text-6xl font-bold tracking-tighter mb-6 uppercase leading-[0.98]">
            {h('compoundingRDEntry.title')}
          </h2>
          <p class="text-lg md:text-xl text-industrial-200 leading-relaxed mb-8 max-w-2xl">
            {h('compoundingRDEntry.subtext')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4">
            <a
              href={`/${locale}/compounding`}
              class="inline-flex justify-center bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-widest uppercase hover:bg-white hover:text-industrial-900 transition-all duration-300"
            >
              {h('compoundingRDEntry.cta')} →
            </a>
            <a
              href={`/${locale}/testing`}
              class="inline-flex justify-center border border-industrial-500 text-white px-8 py-4 font-bold text-sm tracking-widest uppercase hover:border-white transition-all duration-300"
            >
              {h('navigation.testing', 'Testing')}
            </a>
          </div>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
