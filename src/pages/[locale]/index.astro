<script>
  import { animate, inView, stagger } from 'motion';

  // All motion on this page is progressive enhancement: SSR HTML carries the
  // final state, and every animation is skipped under prefers-reduced-motion.
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion) {
    const RQ_EASE: [number, number, number, number] = [0.23, 1, 0.32, 1];

    // Hero entrance: badge -> title -> tagline -> subtitle -> CTAs -> trust chips
    if (document.querySelector('[data-hero-stagger]')) {
      animate(
        '[data-hero-stagger]',
        { opacity: [0, 1], y: [12, 0] },
        { duration: 0.5, delay: stagger(0.08), ease: RQ_EASE },
      );
    }

    // Section reveals — one-shot, restrained
    inView(
      '[data-reveal]',
      (el) => {
        animate(el, { opacity: [0, 1], y: [12, 0] }, { duration: 0.5, ease: RQ_EASE });
      },
      { once: true },
    );

    // Stats band count-up
    const formatValue = (v: number, decimals: number, grouping: boolean): string => {
      const fixed = v.toFixed(decimals);
      if (!grouping) return fixed;
      const [int, dec] = fixed.split('.');
      return int.replace(/\B(?=(\d{3})+(?!\d))/g, ',') + (dec ? `.${dec}` : '');
    };

    document.querySelectorAll('[data-countup]').forEach((el) => {
      const to = Number(el.getAttribute('data-count-to'));
      const decimals = Number(el.getAttribute('data-count-decimals') ?? '0');
      const grouping = el.getAttribute('data-count-grouping') === 'true';
      const token = el.getAttribute('data-count-token') ?? '';
      const finalText = el.textContent ?? '';
      if (!Number.isFinite(to) || !token || !finalText.includes(token)) return;
      const template = finalText.replace(token, '{n}');

      inView(
        el,
        () => {
          animate(0, to, {
            duration: 1.4,
            ease: RQ_EASE,
            onUpdate: (v) => {
              el.textContent = template.replace('{n}', formatValue(v, decimals, grouping));
            },
            onComplete: () => {
              el.textContent = finalText;
            },
          });
        },
        { once: true, amount: 0.4 },
      );
    });
  }
</script>
