---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import TrustSignals from '@/components/TrustSignals.astro';
import { getTranslations, localizedPath, t, tRaw } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale = 'en' } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const homeMeta = meta?.home || {};
const h = (key: string, fallback = '') => t(messages, key, fallback);

const fitItems = tRaw(messages, 'goodFit.fitItems', []);
const notFitItems = tRaw(messages, 'goodFit.notFitItems', []);
const trustBadges = tRaw(messages, 'hero.trustBadges', ['IATF 16949', 'ISO 9001', 'ISO 14001']);
const statsItems = tRaw(messages, 'homeStats.items', []);
const processSteps = tRaw(messages, 'homeProcess.steps', []);
// Count-up driver config per stats item. `token` is the substring of the
// rendered `value` that the animated number replaces (locale-independent).
const statCountConfigs = [
  { to: 1995, decimals: 0, grouping: false, token: '1995' },
  { to: 20000, decimals: 0, grouping: true, token: '20,000' },
  { to: 5000, decimals: 0, grouping: true, token: '5,000' },
  { to: 0.05, decimals: 2, grouping: false, token: '0.05' },
];
const visualLabels = {
  manufacturing: h('visualLabels.manufacturing', 'Factory Manufacturing Scene'),
  ev: h('visualLabels.ev', 'EV & Energy Storage Applications'),
  industrial: h('visualLabels.industrial', 'Industrial Equipment Applications'),
  semiconductor: h('visualLabels.semiconductor', 'Semiconductor Seal Applications'),
  automotive: h('visualLabels.automotive', 'Automotive Tier 2 Applications'),
};
const visualImages = {
  hero: '/images/legacy_resource/2021/03/17/60515a8bd1599.jpg',
  manufacturing: '/images/legacy_resource/2021/01/15/6001a3d39ab70.jpg',
  capacity: '/images/legacy_resource/2021/03/17/60515a8bd1599.jpg',
  ev: '/images/legacy_resource/2021/01/14/5fffd989a7d6a.jpg',
  industrial: '/images/legacy_resource/2021/01/14/5fffd94b86544.jpg',
  semiconductor: '/images/legacy_resource/2021/02/04/601bdacc39a96.jpg',
  automotive: '/images/legacy_resource/2021/01/14/5fffd971e7d47.jpg',
  compounding: '/images/legacy_resource/2021/01/15/6001a3d0882a9.jpg',
};

const orgSchema = createOrganizationSchema(locale!);
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{homeMeta.title || 'RubberQ | Japanese Formulation. Chinese Precision. Trusted Since 1995.'}</title>
    <meta name="description" content={homeMeta.description || meta.description || ''} />
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="flex flex-col">
    <!-- ============================================================ -->
    <!-- HERO                                                          -->
    <!-- ============================================================ -->
    <section data-section-name="hero-banner" class="relative min-h-[calc(100dvh-5rem)] md:min-h-[92vh] flex items-center bg-industrial-900 overflow-hidden">
      <div
        class="absolute inset-0 opacity-45 rq-media"
        data-slot-id="home-hero-bg"
        data-purpose="全屏工厂车间 / A 炼车间 / 生产线大场景，客户进入网站第一眼就看到真实制造环境"
        data-spec="2400x1400 横向大图，主体留在画面右侧或中景，左侧预留深色文字区"
        data-priority="critical"
      >
        <img src={visualImages.hero} alt={visualLabels.manufacturing} loading="eager" />
      </div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-900 via-industrial-900/80 to-transparent z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
        <div class="max-w-3xl">
          <div data-hero-stagger class="inline-block bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-3 py-1 text-xs font-bold tracking-widest uppercase mb-6">
            {h('hero.badge', 'JAPANESE FORMULATION × CHINESE PRECISION × SINCE 1995')}
          </div>
          <h1 data-hero-stagger class="text-5xl md:text-7xl font-bold tracking-tighter text-white mb-6 leading-[0.95]">
            {h('hero.titleLine1', 'PRECISION')}<br />
            <span class="text-industrial-500">{h('hero.titleLine2', 'IN EVERY')}</span><br />
            {h('hero.titleLine3', 'MOLECULE.')}
          </h1>
          <p data-hero-stagger class="text-xl md:text-2xl text-accent-orange font-bold tracking-tight mb-4 italic">
            "{h('hero.tagline', 'Japanese Formulation. Chinese Precision. Trusted Since 1995.')}"
          </p>
          <p data-hero-stagger class="text-lg text-industrial-100 mb-8 max-w-2xl leading-relaxed">
            {h('hero.subtitle')}
          </p>
          <div data-hero-stagger class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href={`${localizedPath(locale, '/contact')}?source_path=${encodeURIComponent(localizedPath(locale, '/'))}&cta_id=home-hero-action&cta_label=${encodeURIComponent('Request Custom Engineering Quote')}`}
              class="rq-pressable bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-[0.18em] hover:bg-white hover:text-industrial-900 text-center uppercase"
            >
              {h('hero.ctaPrimary', 'REQUEST QUOTE')}
            </a>
            <a
              href={localizedPath(locale, `/compounding`)}
              class="rq-pressable border border-industrial-500 text-white px-8 py-4 font-bold text-sm tracking-[0.18em] hover:border-white text-center uppercase"
            >
              {h('hero.ctaSecondary', 'EXPLORE OUR R&D')}
            </a>
          </div>
          <div data-hero-stagger class="flex flex-wrap gap-3 items-center">
            {trustBadges.map((badge: string) => (
              <span class="text-industrial-400 text-xs font-mono tracking-widest border border-industrial-700 px-3 py-1.5">{badge}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FACTORY AT A GLANCE — stats band with count-up                 -->
    <!-- ============================================================ -->
    <section data-section-name="trust-proof-bar" class="bg-industrial-950 border-y border-industrial-800">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-14 md:py-16" data-reveal>
        <p class="text-industrial-500 text-xs font-mono uppercase tracking-[0.24em] mb-10">
          {h('homeStats.kicker', 'FACTORY AT A GLANCE')}
        </p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-10">
          {statsItems.map((item: any, i: number) => {
            const cfg = statCountConfigs[i];
            return (
              <div class="border-l border-industrial-800 pl-5">
                <div
                  class="font-mono text-2xl sm:text-3xl lg:text-4xl leading-none text-white tracking-tight"
                  data-countup
                  data-count-to={cfg?.to}
                  data-count-decimals={cfg?.decimals}
                  data-count-grouping={cfg?.grouping ? 'true' : 'false'}
                  data-count-token={cfg?.token}
                >{item.value}</div>
                <div class="mt-3 text-[11px] font-mono uppercase tracking-[0.18em] text-industrial-400">{item.label}</div>
              </div>
            );
          })}
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FEATURES — large proof scene + compact technical summary         -->
    <!-- ============================================================ -->
    <section data-section-name="capabilities-overview" class="bg-white">
      <div class="grid lg:grid-cols-12 min-h-[720px]">
        <div
          class="relative lg:col-span-7 min-h-[520px] bg-industrial-900 overflow-hidden rq-media"
          data-slot-id="home-proof-manufacturing-scene"
          data-purpose="真实制造能力大场景：密炼/成型/检验其中一个强场景，替代原来四张小图卡片"
          data-spec="1800x1400 竖横皆可，画面要有设备纵深和人员/工件尺度"
          data-priority="critical"
        >
          <img src={visualImages.manufacturing} alt={visualLabels.manufacturing} loading="lazy" />
          <div class="absolute inset-0 bg-industrial-900/30"></div>
          <div class="absolute left-6 bottom-6 right-6 border border-white/20 bg-industrial-900/70 p-5 text-white md:left-10 md:bottom-10 md:right-auto md:w-[360px]">
            <p class="text-sm leading-relaxed text-industrial-200">{visualLabels.manufacturing}</p>
          </div>
        </div>

        <div class="lg:col-span-5 px-4 sm:px-8 lg:px-12 py-16 lg:py-20 flex items-center">
          <div class="max-w-xl" data-reveal>
            <h2 class="text-4xl md:text-5xl font-bold tracking-tighter text-industrial-900 uppercase mb-10 leading-[0.98]">
              {h('features.title', 'WHY GLOBAL ENGINEERING TEAMS CHOOSE RUBBERQ')}
            </h2>

            <div class="grid sm:grid-cols-2 gap-x-8 gap-y-8">
              <div class="border-t border-industrial-200 pt-5">
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.16em] mb-3">01</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.jpRd.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.jpRd.desc')}</p>
              </div>
              <div class="border-t border-industrial-200 pt-5">
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.16em] mb-3">02</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.compounding.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.compounding.desc')}</p>
              </div>
              <div class="border-t border-industrial-200 pt-5">
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.16em] mb-3">03</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.lab.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.lab.desc')}</p>
              </div>
              <div class="border-t border-industrial-200 pt-5">
                <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.16em] mb-3">04</div>
                <h4 class="font-bold text-lg mb-2 tracking-tight text-industrial-900">{h('features.heritage.title')}</h4>
                <p class="text-sm text-industrial-600 leading-relaxed">{h('features.heritage.desc')}</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- PROCESS — FROM COMPOUND TO COMPONENT                          -->
    <!-- ============================================================ -->
    <section data-section-name="material-matrix-preview" class="py-24 bg-white border-t border-industrial-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mb-14" data-reveal>
          <p class="text-accent-orange text-xs font-mono uppercase tracking-[0.24em] mb-4">
            {h('homeProcess.kicker', 'PROCESS FLOW')}
          </p>
          <h2 class="text-3xl md:text-5xl font-bold tracking-tighter text-industrial-900 uppercase leading-tight mb-5">
            {h('homeProcess.title', 'FROM COMPOUND TO COMPONENT')}
          </h2>
          <div class="h-1 w-14 bg-accent-orange"></div>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-4 gap-x-8 gap-y-12" data-reveal>
          {processSteps.map((step: any, i: number) => (
            <div class="border-t border-industrial-200 pt-5">
              <div class="text-accent-orange text-xs font-bold font-mono uppercase tracking-[0.16em] mb-3">
                {String(i + 1).padStart(2, '0')}
              </div>
              <h3 class="font-bold text-lg mb-2 tracking-tight text-industrial-900 uppercase">{step.title}</h3>
              <p class="text-sm text-industrial-600 leading-relaxed mb-3">{step.desc}</p>
              <p class="text-xs text-industrial-500 leading-relaxed">{step.note}</p>
            </div>
          ))}
        </div>

        <div class="mt-12 flex flex-col sm:flex-row gap-x-10 gap-y-4" data-reveal>
          <a
            href={localizedPath(locale, `/compounding`)}
            class="group inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest"
          >
            {h('homeProcess.linkCompounding', 'Explore Compounding & R&D')}
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
          <a
            href={localizedPath(locale, `/testing`)}
            class="group inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest"
          >
            {h('homeProcess.linkTesting', 'See Testing & Validation')}
            <span class="transition-transform group-hover:translate-x-1">→</span>
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- IS MY PROJECT A GOOD FIT?                                     -->
    <!-- ============================================================ -->
    <section class="py-20 bg-white border-y border-industrial-200">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-12 items-start" data-reveal>
          <div class="lg:col-span-4 lg:sticky lg:top-28">
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 uppercase mb-5 leading-tight">
              {h('goodFit.title')}
            </h2>
            <p class="text-lg text-industrial-700 leading-relaxed">{h('goodFit.subtitle')}</p>
            <a
              href={localizedPath(locale, `/contact`)}
              class="rq-pressable inline-flex mt-8 bg-industrial-900 text-white px-7 py-4 font-bold text-sm tracking-[0.16em] uppercase hover:bg-accent-orange"
            >
              {h('goodFit.cta')} →
            </a>
          </div>

          <div class="lg:col-span-8 grid md:grid-cols-2 gap-10">
            <div class="border border-industrial-200 bg-white p-6 md:p-8">
              <div class="h-1 w-16 bg-accent-orange mb-6"></div>
              <h3 class="text-xl font-bold text-industrial-900 uppercase tracking-tight mb-6">{h('goodFit.fitTitle')}</h3>
              <ul class="space-y-5">
                {fitItems.map((item: string) => (
                  <li class="flex gap-4 text-industrial-700 leading-relaxed">
                    <span class="mt-2 h-px w-6 bg-accent-orange flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="border border-industrial-200 bg-industrial-50 p-6 md:p-8">
              <div class="h-1 w-16 bg-industrial-300 mb-6"></div>
              <h3 class="text-xl font-bold text-industrial-900 uppercase tracking-tight mb-6">{h('goodFit.notFitTitle')}</h3>
              <ul class="space-y-5">
                {notFitItems.map((item: string) => (
                  <li class="flex gap-4 text-industrial-700 leading-relaxed">
                    <span class="mt-2 h-px w-6 bg-industrial-400 flex-shrink-0"></span>
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CAPACITY RE-FRAMING                                            -->
    <!-- ============================================================ -->
    <section class="relative min-h-[540px] bg-industrial-900 text-white overflow-hidden flex items-center">
      <div
        class="absolute inset-0 opacity-55 rq-media"
        data-slot-id="home-capacity-line-bg"
        data-purpose="A 炼线 / 密炼 / 连续生产线宽幅场景，用来说明 RubberQ 产能结构和稳定供货"
        data-spec="2200x1200 横向宽幅，最好有设备纵深和批量生产语境"
        data-priority="critical"
      >
        <img src={visualImages.capacity} alt={visualLabels.manufacturing} loading="lazy" />
      </div>
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-950 via-industrial-900/85 to-industrial-900/25"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full py-20" data-reveal>
        <div class="max-w-2xl">
          <h2 class="text-3xl md:text-5xl font-bold tracking-tighter uppercase mb-6 leading-tight">
            {h('capacityReframing.title')}
          </h2>
          <p class="text-lg md:text-xl text-industrial-100 leading-relaxed mb-8">
            {h('capacityReframing.body')}
          </p>
          <a
            href={localizedPath(locale, `/compounding`)}
            class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest hover:underline"
          >
            {h('capacityReframing.learnMore')} →
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TRUST SIGNALS                                                  -->
    <!-- ============================================================ -->
    <TrustSignals locale={locale} />

    <!-- ============================================================ -->
    <!-- INDUSTRIES — v2: EV / Industrial / Semicon / Auto Tier 2       -->
    <!-- ============================================================ -->
    <section data-section-name="industry-solutions" class="py-24 bg-industrial-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-12 gap-8 items-end mb-12" data-reveal>
          <h2 class="lg:col-span-5 text-3xl md:text-5xl font-bold tracking-tighter text-industrial-900 uppercase leading-tight">
            {h('industries.title', 'Specialized Industries We Serve')}
          </h2>
          <p class="lg:col-span-7 text-lg text-industrial-700 leading-relaxed">
            {h('industries.subtitle')}
          </p>
        </div>

        <div class="grid lg:grid-cols-3 gap-5" data-reveal>
          <!-- Semiconductor -->
          <a href={localizedPath(locale, `/industries/semiconductor`)} class="group relative min-h-[540px] overflow-hidden border border-industrial-200 lg:col-span-2 bg-industrial-900 rq-media rq-lift rq-pressable">
            <div
              class="absolute inset-0 rq-media-soft"
              data-slot-id="home-industries-semiconductor"
              data-purpose="半导体设备低出气密封件主入口"
              data-spec="1600x1200"
              data-priority="critical"
            >
                <img src={visualImages.semicon} alt={visualLabels.semicon} loading="lazy" />
                <span class="absolute top-6 right-6 bg-white/90 px-3 py-1 text-[10px] uppercase tracking-widest text-industrial-500">Semiconductor Equipment</span>
            </div>
            <div class="absolute inset-0 bg-industrial-900/45 group-hover:bg-industrial-900/60 transition-colors"></div>
            <div class="absolute bottom-8 left-8 right-8 text-white md:bottom-10 md:left-10 md:right-10">
              <div class="text-accent-orange text-xs font-bold uppercase tracking-[0.24em] mb-4">01</div>
              <h3 class="text-3xl md:text-5xl font-bold uppercase tracking-tighter mb-4 max-w-xl">Semiconductor Equipment</h3>
              <p class="text-base md:text-lg text-industrial-100 leading-relaxed max-w-xl">High-vacuum ultra-low outgassing FFKM & FKM seals for CVD, ALD, and plasma etching chambers.</p>
              <div class="w-10 h-1 bg-accent-orange mt-4 transition-[width] duration-300 group-hover:w-full"></div>
            </div>
          </a>

          <div class="grid gap-5">
            <!-- Humanoid Robotics -->
            <a href={localizedPath(locale, `/industries/humanoid-robotics`)} class="group relative min-h-[166px] overflow-hidden border border-industrial-200 bg-industrial-900 rq-media rq-lift rq-pressable">
              <div
                class="absolute inset-0 rq-media-soft"
                data-slot-id="home-industries-robotics"
                data-purpose="人形机器人关节减震与高疲劳密封场景"
                data-spec="900x520"
                data-priority="important"
              >
                <img src={visualImages.industrial} alt="Humanoid Robotics" loading="lazy" />
                <span class="absolute top-4 right-4 bg-white/90 px-2 py-1 text-[10px] uppercase tracking-widest text-industrial-500">Robotics</span>
              </div>
              <div class="absolute inset-0 bg-industrial-900/55 group-hover:bg-industrial-900/72 transition-colors"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white">
                <div class="text-accent-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-1">02</div>
                <h3 class="text-xl font-bold uppercase tracking-tight mb-1">Humanoid Robotics & AI</h3>
                <p class="text-xs text-industrial-200 line-clamp-2">Rubber-to-metal vulcanized joint damping mounts & high-friction tactile pads.</p>
              </div>
            </a>

            <!-- AI Data Center Cooling -->
            <a href={localizedPath(locale, `/industries/ai-data-center-cooling`)} class="group relative min-h-[166px] overflow-hidden border border-industrial-200 bg-industrial-900 rq-media rq-lift rq-pressable">
              <div
                class="absolute inset-0 rq-media-soft"
                data-slot-id="home-industries-cooling"
                data-purpose="AI 数据中心液冷与储能阻燃密封场景"
                data-spec="900x520"
                data-priority="important"
              >
                <img src={visualImages.ev} alt="AI Cooling" loading="lazy" />
                <span class="absolute top-4 right-4 bg-white/90 px-2 py-1 text-[10px] uppercase tracking-widest text-industrial-500">AI Cooling</span>
              </div>
              <div class="absolute inset-0 bg-industrial-900/55 group-hover:bg-industrial-900/72 transition-colors"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white">
                <div class="text-accent-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-1">03</div>
                <h3 class="text-xl font-bold uppercase tracking-tight mb-1">AI Liquid Cooling & ESS</h3>
                <p class="text-xs text-industrial-200 line-clamp-2">Quick disconnect O-rings & UL94 V-0 flame retardant EPDM gaskets.</p>
              </div>
            </a>

            <!-- EV High-Voltage -->
            <a href={localizedPath(locale, `/industries/ev-high-voltage`)} class="group relative min-h-[166px] overflow-hidden border border-industrial-200 bg-industrial-900 rq-media rq-lift rq-pressable">
              <div
                class="absolute inset-0 rq-media-soft"
                data-slot-id="home-industries-ev-hv"
                data-purpose="EV 高压线束护套与 IP68 防水密封场景"
                data-spec="900x520"
                data-priority="important"
              >
                <img src={visualImages.automotive} alt="EV High Voltage" loading="lazy" />
                <span class="absolute top-4 right-4 bg-white/90 px-2 py-1 text-[10px] uppercase tracking-widest text-industrial-500">EV High-Voltage</span>
              </div>
              <div class="absolute inset-0 bg-industrial-900/55 group-hover:bg-industrial-900/72 transition-colors"></div>
              <div class="absolute bottom-5 left-5 right-5 text-white">
                <div class="text-accent-orange text-[10px] font-bold uppercase tracking-[0.2em] mb-1">04</div>
                <h3 class="text-xl font-bold uppercase tracking-tight mb-1">EV High-Voltage Seals</h3>
                <p class="text-xs text-industrial-200 line-clamp-2">High-voltage cable grommets & IP68/IP69K connector seals.</p>
              </div>
            </a>
          </div>
        </div>

        <p class="text-center text-industrial-600 mt-10 text-sm">
          {h('industries.notSeeing')}
          <a href={`${localizedPath(locale, '/contact')}?source_path=${encodeURIComponent(localizedPath(locale, '/'))}&cta_id=home-industries-footer-action&cta_label=${encodeURIComponent('Talk to Our Engineers')}`} class="text-accent-orange font-bold hover:underline ml-2">
