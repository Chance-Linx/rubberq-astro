---
import LocaleLayout from '@/layouts/LocaleLayout.astro';
import JsonLd from '@/components/JsonLd';
import TrustSignals from '@/components/TrustSignals.astro';
import { getTranslations, t, tRaw } from '@/lib/i18n';
import { createOrganizationSchema } from '@/lib/structuredData';

export function getStaticPaths() {
  return ['en', 'de', 'ja', 'es', 'zh'].map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params;
const messages = await getTranslations(locale);
const meta = messages?.metadata || {};
const homeMeta = meta?.home || {};
const h = (key: string, fallback = '') => t(messages, key, fallback);

const summaryItems = tRaw(messages, 'features.summaryItems', []);
const fitItems = tRaw(messages, 'goodFit.fitItems', []);
const notFitItems = tRaw(messages, 'goodFit.notFitItems', []);
const trustBadges = tRaw(messages, 'hero.trustBadges', ['IATF 16949', 'ISO 9001', 'ISO 14001']);

const orgSchema = createOrganizationSchema(locale!);
---

<LocaleLayout locale={locale}>
  <Fragment slot="head">
    <title>{homeMeta.title || 'RubberQ | Japanese Formulation. Chinese Precision. Trusted Since 1995.'}</title>
    <meta name="description" content={homeMeta.description || meta.description || ''} />
    <JsonLd data={orgSchema} />
  </Fragment>

  <div class="flex flex-col">
    <!-- ============================================================ -->
    <!-- HERO                                                          -->
    <!-- ============================================================ -->
    <section class="relative h-[90vh] flex items-center bg-industrial-900 overflow-hidden">
      <!-- Hero background placeholder -->
      <div
        class="absolute inset-0 opacity-30"
        data-slot-id="home-hero-bg"
        data-purpose="工厂车间 / A 炼车间环境图，营造工业感"
        data-spec="1920x1080 横向，可带 industrial-900 蒙版"
        data-priority="critical"
      >
        <div class="w-full h-full bg-gradient-to-br from-industrial-800 to-industrial-900"></div>
      </div>
      <div class="absolute inset-0 bg-grid-pattern bg-grid-size opacity-10"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-industrial-900 via-industrial-900/80 to-transparent z-10"></div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-20 w-full">
        <div class="max-w-3xl">
          <div class="inline-block bg-accent-orange/10 border border-accent-orange/30 text-accent-orange px-3 py-1 text-xs font-bold tracking-widest uppercase mb-6">
            {h('hero.badge', 'JAPANESE FORMULATION × CHINESE PRECISION × SINCE 1995')}
          </div>
          <h1 class="text-5xl md:text-7xl font-bold tracking-tighter text-white mb-6 leading-[0.95]">
            {h('hero.titleLine1', 'PRECISION')}<br />
            <span class="text-industrial-500">{h('hero.titleLine2', 'IN EVERY')}</span><br />
            {h('hero.titleLine3', 'MOLECULE.')}
          </h1>
          <p class="text-xl md:text-2xl text-accent-orange font-bold tracking-tight mb-4 italic">
            "{h('hero.tagline', 'Japanese Formulation. Chinese Precision. Trusted Since 1995.')}"
          </p>
          <p class="text-lg text-industrial-100 mb-8 max-w-2xl leading-relaxed">
            {h('hero.subtitle')}
          </p>
          <div class="flex flex-col sm:flex-row gap-4 mb-10">
            <a
              href={`/${locale}/contact`}
              class="bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-widest hover:bg-white hover:text-industrial-900 transition-all duration-300 text-center uppercase"
            >
              {h('hero.ctaPrimary', 'REQUEST QUOTE')}
            </a>
            <a
              href={`/${locale}/compounding`}
              class="border border-industrial-500 text-white px-8 py-4 font-bold text-sm tracking-widest hover:border-white transition-all duration-300 text-center uppercase"
            >
              {h('hero.ctaSecondary', 'EXPLORE OUR R&D')}
            </a>
          </div>
          <div class="flex flex-wrap gap-3 items-center">
            {trustBadges.map((badge: string) => (
              <span class="text-industrial-400 text-xs font-mono tracking-widest border border-industrial-700 px-3 py-1.5">{badge}</span>
            ))}
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- FEATURES — 4 v2 cards                                          -->
    <!-- ============================================================ -->
    <section class="py-24 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 items-start">
          <div>
            <h2 class="text-4xl font-bold tracking-tighter text-industrial-900 uppercase mb-8">
              {h('features.title', 'WHY GLOBAL ENGINEERING TEAMS CHOOSE RUBBERQ')}
            </h2>
            <div class="bg-industrial-100 border-l-4 border-accent-orange p-6 my-4">
              <h3 class="text-xl font-bold text-industrial-900 mb-4 uppercase tracking-tight">
                {h('features.summaryTitle', 'QUICK TECHNICAL SUMMARY')}
              </h3>
              <ul class="space-y-4">
                {summaryItems.map((item: any) => (
                  <li class="text-industrial-700 leading-relaxed">
                    <strong class="text-industrial-900 block mb-1">{item.term}</strong>
                    <span class="text-sm">{item.description}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>

          <div class="grid grid-cols-2 gap-6">
            <!-- JP R&D -->
            <div class="p-6 border border-industrial-100 hover:border-accent-orange transition-colors group">
              <div
                class="aspect-square bg-industrial-100 mb-4 flex items-center justify-center text-xs text-industrial-500"
                data-slot-id="home-features-rd"
                data-purpose="配方实验室设备特写 / 配方研发场景"
                data-spec="800x600"
                data-priority="important"
              >[home-features-rd]</div>
              <h4 class="font-bold text-base mb-2 uppercase tracking-tight">{h('features.jpRd.title')}</h4>
              <p class="text-sm text-industrial-600 leading-relaxed">{h('features.jpRd.desc')}</p>
            </div>
            <!-- In-House Compounding -->
            <div class="p-6 border border-industrial-100 hover:border-accent-orange transition-colors group">
              <div
                class="aspect-square bg-industrial-100 mb-4 flex items-center justify-center text-xs text-industrial-500"
                data-slot-id="home-features-compounding"
                data-purpose="A 炼车间设备特写（密炼机）"
                data-spec="800x600"
                data-priority="important"
              >[home-features-compounding]</div>
              <h4 class="font-bold text-base mb-2 uppercase tracking-tight">{h('features.compounding.title')}</h4>
              <p class="text-sm text-industrial-600 leading-relaxed">{h('features.compounding.desc')}</p>
            </div>
            <!-- Own Lab -->
            <div class="p-6 border border-industrial-100 hover:border-accent-orange transition-colors group">
              <div
                class="aspect-square bg-industrial-100 mb-4 flex items-center justify-center text-xs text-industrial-500"
                data-slot-id="home-features-lab"
                data-purpose="试验设备特写（拉力机或老化箱）"
                data-spec="800x600"
                data-priority="important"
              >[home-features-lab]</div>
              <h4 class="font-bold text-base mb-2 uppercase tracking-tight">{h('features.lab.title')}</h4>
              <p class="text-sm text-industrial-600 leading-relaxed">{h('features.lab.desc')}</p>
            </div>
            <!-- Heritage -->
            <div class="p-6 border border-industrial-100 hover:border-accent-orange transition-colors group">
              <div
                class="aspect-square bg-industrial-100 mb-4 flex items-center justify-center text-xs text-industrial-500"
                data-slot-id="home-features-heritage"
                data-purpose="工厂建筑外观 / 厂区航拍"
                data-spec="800x600"
                data-priority="important"
              >[home-features-heritage]</div>
              <h4 class="font-bold text-base mb-2 uppercase tracking-tight">{h('features.heritage.title')}</h4>
              <p class="text-sm text-industrial-600 leading-relaxed">{h('features.heritage.desc')}</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- IS MY PROJECT A GOOD FIT?                                     -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-50">
      <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 uppercase mb-4">
            {h('goodFit.title')}
          </h2>
          <p class="text-lg text-industrial-700 max-w-3xl mx-auto">{h('goodFit.subtitle')}</p>
        </div>

        <div class="grid md:grid-cols-2 gap-6">
          <!-- Great fit -->
          <div class="bg-white border-2 border-accent-orange p-8">
            <div class="flex items-baseline gap-2 mb-6">
              <span class="text-accent-orange text-2xl">✅</span>
              <h3 class="text-xl font-bold text-industrial-900 uppercase tracking-tight">{h('goodFit.fitTitle')}</h3>
            </div>
            <ul class="space-y-3">
              {fitItems.map((item: string) => (
                <li class="flex gap-3 text-industrial-700 leading-relaxed">
                  <span class="text-accent-orange font-bold flex-shrink-0">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>

          <!-- Not fit -->
          <div class="bg-white border-2 border-accent-orange p-8">
            <div class="flex items-baseline gap-2 mb-6">
              <span class="text-accent-orange text-2xl">⚠</span>
              <h3 class="text-xl font-bold text-industrial-900 uppercase tracking-tight">{h('goodFit.notFitTitle')}</h3>
            </div>
            <ul class="space-y-3">
              {notFitItems.map((item: string) => (
                <li class="flex gap-3 text-industrial-700 leading-relaxed">
                  <span class="text-accent-orange font-bold flex-shrink-0">▸</span>
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <div class="text-center mt-10">
          <a
            href={`/${locale}/contact`}
            class="inline-block bg-industrial-900 text-white px-8 py-4 font-bold text-sm tracking-widest uppercase hover:bg-accent-orange transition-colors"
          >
            {h('goodFit.cta')} →
          </a>
        </div>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- CAPACITY RE-FRAMING                                            -->
    <!-- ============================================================ -->
    <section class="py-20 bg-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-2xl md:text-3xl font-bold tracking-tighter text-industrial-900 uppercase mb-6">
          {h('capacityReframing.title')}
        </h2>
        <p class="text-lg text-industrial-700 leading-relaxed mb-6 max-w-4xl">
          {h('capacityReframing.body')}
        </p>
        <a
          href={`/${locale}/compounding`}
          class="inline-flex items-center gap-2 text-accent-orange font-bold uppercase text-sm tracking-widest hover:underline"
        >
          {h('capacityReframing.learnMore')} →
        </a>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- TRUST SIGNALS                                                  -->
    <!-- ============================================================ -->
    <TrustSignals locale={locale} />

    <!-- ============================================================ -->
    <!-- INDUSTRIES — v2: EV / Industrial / Semicon / Auto Tier 2       -->
    <!-- ============================================================ -->
    <section class="py-24 bg-industrial-100">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl md:text-4xl font-bold tracking-tighter text-industrial-900 uppercase text-center mb-4">
          {h('industries.title', 'Specialized Industries We Serve')}
        </h2>
        <p class="text-lg text-industrial-700 text-center max-w-3xl mx-auto mb-12">
          {h('industries.subtitle')}
        </p>

        <div class="grid grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- EV -->
          <a href={`/${locale}/industries/ev-energy-storage`} class="group relative h-80 overflow-hidden border border-industrial-200">
            <div
              class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
              data-slot-id="home-industries-ev"
              data-purpose="EV/储能相关密封件成品图 或 工艺中场景"
              data-spec="800x800 方形"
              data-priority="critical"
            >
              <span class="text-xs text-industrial-500">[home-industries-ev]</span>
            </div>
            <div class="absolute inset-0 bg-industrial-900/50 group-hover:bg-industrial-900/70 transition-colors"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <div class="text-3xl mb-2">{h('industries.ev.icon')}</div>
              <h3 class="text-lg font-bold uppercase tracking-tight mb-2">{h('industries.ev.title')}</h3>
              <p class="text-sm text-industrial-200 leading-snug">{h('industries.ev.shortDesc')}</p>
              <div class="w-10 h-1 bg-accent-orange mt-4 transition-all duration-300 group-hover:w-full"></div>
            </div>
          </a>

          <!-- Industrial -->
          <a href={`/${locale}/industries/industrial-equipment`} class="group relative h-80 overflow-hidden border border-industrial-200">
            <div
              class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
              data-slot-id="home-industries-industrial"
              data-purpose="液压/泵阀密封件成品图"
              data-spec="800x800"
              data-priority="important"
            >
              <span class="text-xs text-industrial-500">[home-industries-industrial]</span>
            </div>
            <div class="absolute inset-0 bg-industrial-900/50 group-hover:bg-industrial-900/70 transition-colors"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <div class="text-3xl mb-2">{h('industries.industrial.icon')}</div>
              <h3 class="text-lg font-bold uppercase tracking-tight mb-2">{h('industries.industrial.title')}</h3>
              <p class="text-sm text-industrial-200 leading-snug">{h('industries.industrial.shortDesc')}</p>
              <div class="w-10 h-1 bg-accent-orange mt-4 transition-all duration-300 group-hover:w-full"></div>
            </div>
          </a>

          <!-- Semicon -->
          <a href={`/${locale}/industries/semiconductor`} class="group relative h-80 overflow-hidden border border-industrial-200">
            <div
              class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
              data-slot-id="home-industries-semicon"
              data-purpose="FFKM 制品特写 或 洁净环境工艺图"
              data-spec="800x800"
              data-priority="important"
            >
              <span class="text-xs text-industrial-500">[home-industries-semicon]</span>
            </div>
            <div class="absolute inset-0 bg-industrial-900/50 group-hover:bg-industrial-900/70 transition-colors"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <div class="text-3xl mb-2">{h('industries.semiconductor.icon')}</div>
              <h3 class="text-lg font-bold uppercase tracking-tight mb-2">{h('industries.semiconductor.title')}</h3>
              <p class="text-sm text-industrial-200 leading-snug">{h('industries.semiconductor.shortDesc')}</p>
              <div class="w-10 h-1 bg-accent-orange mt-4 transition-all duration-300 group-hover:w-full"></div>
            </div>
          </a>

          <!-- Auto Tier 2 -->
          <a href={`/${locale}/industries/automotive-tier2`} class="group relative h-80 overflow-hidden border border-industrial-200">
            <div
              class="absolute inset-0 bg-industrial-200 flex items-center justify-center"
              data-slot-id="home-industries-auto"
              data-purpose="汽车密封件成品图"
              data-spec="800x800"
              data-priority="important"
            >
              <span class="text-xs text-industrial-500">[home-industries-auto]</span>
            </div>
            <div class="absolute inset-0 bg-industrial-900/50 group-hover:bg-industrial-900/70 transition-colors"></div>
            <div class="absolute bottom-6 left-6 right-6 text-white">
              <div class="text-3xl mb-2">{h('industries.automotive.icon')}</div>
              <h3 class="text-lg font-bold uppercase tracking-tight mb-2">{h('industries.automotive.title')}</h3>
              <p class="text-sm text-industrial-200 leading-snug">{h('industries.automotive.shortDesc')}</p>
              <div class="w-10 h-1 bg-accent-orange mt-4 transition-all duration-300 group-hover:w-full"></div>
            </div>
          </a>
        </div>

        <p class="text-center text-industrial-600 mt-10 text-sm">
          {h('industries.notSeeing')}
          <a href={`/${locale}/contact`} class="text-accent-orange font-bold hover:underline ml-2">
            {h('industries.talkCta')} →
          </a>
        </p>
      </div>
    </section>

    <!-- ============================================================ -->
    <!-- COMPOUNDING & R&D ENTRY                                       -->
    <!-- ============================================================ -->
    <section class="py-20 bg-industrial-900 text-white">
      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid lg:grid-cols-2 gap-12 items-center">
          <div>
            <h2 class="text-3xl md:text-4xl font-bold tracking-tighter mb-6 uppercase">
              {h('compoundingRDEntry.title')}
            </h2>
            <p class="text-lg text-industrial-300 leading-relaxed mb-8">
              {h('compoundingRDEntry.subtext')}
            </p>
            <a
              href={`/${locale}/compounding`}
              class="inline-block bg-accent-orange text-white px-8 py-4 font-bold text-sm tracking-widest uppercase hover:bg-white hover:text-industrial-900 transition-all duration-300"
            >
              {h('compoundingRDEntry.cta')} →
            </a>
          </div>
          <div
            class="aspect-video bg-industrial-800 border-2 border-dashed border-industrial-700 flex items-center justify-center"
            data-slot-id="home-compounding-entry"
            data-purpose="A 炼车间或配方实验室一张代表性图"
            data-spec="1600x900"
            data-priority="important"
          >
            <span class="text-xs text-industrial-500">[home-compounding-entry]</span>
          </div>
        </div>
      </div>
    </section>
  </div>
</LocaleLayout>
