---
import BlogLayout from '@/layouts/BlogLayout.astro';
import { getAllBlogPosts, getFeaturedImageUrl, getBlogUrl, getCategories } from '@/lib/sanity';
import type { BlogPost } from '@/lib/sanity';

const posts = await getAllBlogPosts();
const categories = await getCategories();
---

<BlogLayout locale="en">
  <Fragment slot="head">
    <title>Technical Knowledge Hub | RubberQ</title>
    <meta name="description" content="Expert analysis on rubber engineering, quality standards, and application-specific solutions." />
    <meta property="og:title" content="Technical Knowledge Hub | RubberQ" />
    <meta property="og:description" content="Expert analysis on rubber engineering, quality standards, and application-specific solutions." />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="Technical Knowledge Hub | RubberQ" />
    <meta name="twitter:description" content="Expert analysis on rubber engineering, quality standards, and application-specific solutions." />
  </Fragment>

  <section class="py-16 border-b border-border">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <h1 class="text-4xl sm:text-5xl font-bold tracking-tight mb-4">Technical Knowledge Hub</h1>
      <p class="text-lg text-muted max-w-2xl">Expert analysis on rubber engineering, material science, and precision manufacturing. {posts.length} articles published.</p>
    </div>
  </section>

  <section class="py-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Category Filter -->
      {
        categories.length > 0 && (
          <div class="flex flex-wrap gap-2 mb-12">
            <a href="/blog" class="px-4 py-2 text-xs font-bold uppercase tracking-wider bg-primary text-primary-foreground">All</a>
            {categories.map(cat => (
              <a href={`/blog?category=${encodeURIComponent(cat.name)}`}
                 class="px-4 py-2 text-xs font-bold uppercase tracking-wider border border-border hover:border-primary hover:text-primary transition-colors">
                {cat.name} ({cat.count})
              </a>
            ))}
          </div>
        )
      }

      <!-- Blog Grid -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
        {posts.map((post: BlogPost) => {
          const imageUrl = getFeaturedImageUrl(post);
          const date = post.publishedAt ? new Date(post.publishedAt).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' }) : '';
          return (
            <article class="group border border-border hover:border-primary transition-colors">
              <a href={getBlogUrl(post.slug)}>
                {imageUrl ? (
                  <img src={imageUrl} alt={post.title} class="w-full h-48 object-cover" loading="lazy" />
                ) : (
                  <div class="w-full h-48 bg-secondary flex items-center justify-center text-muted text-sm">RubberQ</div>
                )}
                <div class="p-6">
                  {post.category && (
                    <span class="text-xs font-bold uppercase tracking-wider text-primary mb-2 block">{post.category}</span>
                  )}
                  <h2 class="text-lg font-bold mb-2 group-hover:text-primary transition-colors line-clamp-2">
                    {post.title}
                  </h2>
                  {post.excerpt && (
                    <p class="text-sm text-muted line-clamp-3 mb-4">{post.excerpt}</p>
                  )}
                  <div class="flex items-center justify-between text-xs text-muted">
                    <time datetime={post.publishedAt}>{date}</time>
                    {post.tags && post.tags.length > 0 && (
                      <span class="text-primary">{post.tags[0]}</span>
                    )}
                  </div>
                </div>
              </a>
            </article>
          );
        })}
      </div>

      {posts.length === 0 && (
        <div class="text-center py-20">
          <p class="text-muted text-lg">No articles published yet. Check back soon.</p>
        </div>
      )}
    </div>
  </section>
</BlogLayout>
