---
import ArticlePage from '@/components/blog/ArticlePage.astro';
import { findCanonicalBlogSlug, getBlogPostBySlug, getBlogUrl, getRelatedPosts, getAllBlogPosts, getUnavailableBlogPostStatus } from '@/lib/sanity';
import type { BlogPost } from '@/lib/sanity';

// Generate static paths from all published posts
export async function getStaticPaths() {
  const posts = await getAllBlogPosts();
  return posts.map((post: BlogPost) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await getBlogPostBySlug(slug!);

if (!post) {
  const canonicalSlug = await findCanonicalBlogSlug(slug!);

  if (canonicalSlug) {
    return Astro.redirect(getBlogUrl(canonicalSlug), 301);
  }

  const unavailableStatus = await getUnavailableBlogPostStatus(slug!);

  if (unavailableStatus === 'scheduled') {
    return new Response(null, { status: 404 });
  }

  return new Response(null, {
    status: 410,
    headers: {
      'Cache-Control': 'public, max-age=3600, s-maxage=86400',
    },
  });
}

const relatedPosts = await getRelatedPosts(post);
---

<ArticlePage post={post} relatedPosts={relatedPosts} />
