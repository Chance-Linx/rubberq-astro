---
Astro.response.headers.set('X-Robots-Tag', 'noindex, nofollow, noarchive');
Astro.response.headers.set('Cache-Control', 'no-store');
Astro.response.headers.set('X-RubberQ-Local-Review', '1');
import { records } from './records';
const withCover = records.filter(record => record.source.coverAsset?.url).length;
const coverPage = Number(Astro.url.searchParams.get('covers'));
const shown = Number.isInteger(coverPage) && coverPage > 0 ? records.filter(record => record.source.coverAsset?.url).slice((coverPage - 1) * 4, coverPage * 4) : records;
---
<!doctype html><html lang="zh-CN"><head><meta charset="utf-8" /><link rel="icon" type="image/svg+xml" href="/favicon.svg" /><meta name="viewport" content="width=device-width, initial-scale=1" /><meta name="robots" content="noindex,nofollow,noarchive" /><title>RubberQ · 实际文章版式预览</title></head><body>
<header><p>RUBBERQ / LOCAL ARTICLE REVIEW</p><h1>27篇正文稿 · 实际网站布局</h1><p>原URL、日期、状态与封面引用来自本轮只读元数据；修订正文使用本地稿。此入口只在本地专用配置中存在，尚未写CMS或上线。文章和页面内链在本端口可继续预览。</p><p>{withCover}篇有现存封面引用，{records.length - withCover}篇无引用；19张已逐图检查，均从候选版隐藏；8篇维持无封面。下方原图仅供历史对照。</p><a href="http://127.0.0.1:8797/map">返回获客看板</a></header>
<main>{shown.map((record,index)=><article data-article-id={record.post._id}><div class="number">{String(records.indexOf(record)+1).padStart(2,'0')}</div><h2><a href={record.url}>{record.post.title}</a></h2><p class="meta">{record.source.publishedAt} / {record.source.status}</p>{record.source.coverAsset?.url ? <figure><img src={record.source.coverAsset.url} alt="" loading="eager" width={record.source.coverAsset.metadata?.dimensions?.width} height={record.source.coverAsset.metadata?.dimensions?.height} /><figcaption>现存封面原图，未由本轮元数据读取改写。</figcaption></figure> : <p class="empty">现存记录没有封面引用。</p>}<a href={record.url}>打开实际文章版式 →</a></article>)}</main>
</body></html>
<style>
*{box-sizing:border-box}body{margin:0;background:#fff;color:#0a0a0a;font-family:Inter,system-ui,sans-serif;line-height:1.6}header{max-width:1200px;margin:auto;padding:36px 28px;border-bottom:1px solid #e5e5e5}h1{font-size:38px;line-height:1.15;letter-spacing:-.03em}header p{max-width:900px}main{max-width:1200px;margin:auto;padding:28px;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:36px}article{min-width:0;border-bottom:1px solid #e5e5e5;padding-bottom:28px}h2{font-size:20px;line-height:1.3;min-height:78px}a{color:inherit;text-underline-offset:4px;text-decoration-color:#ea580c}a:focus-visible{outline:2px solid #ea580c;outline-offset:4px}.number,.meta,figcaption{font-size:12px;color:#525252}.number{font-family:monospace}figure{margin:18px 0}img{display:block;max-width:100%;width:100%;height:auto}figcaption{margin-top:8px}.empty{min-height:120px;background:#fafafa;padding:24px}@media(max-width:700px){main{grid-template-columns:1fr}h1{font-size:30px}h2{min-height:0}}
</style>
